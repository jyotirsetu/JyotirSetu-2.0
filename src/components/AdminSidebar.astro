---
export interface Props {
  activePage?: string;
}

const { activePage } = Astro.props;
const menuGroups = [
  { label: 'Overview', items: [
    { href: '/admin/dashboard', icon: 'fas fa-gauge', label: 'Dashboard' },
    { href: '/admin/client360', icon: 'fas fa-user-circle', label: 'Client 360°' },
  ]},
  { label: 'CRM & Sales', items: [
    { href: '/admin/leads', icon: 'fas fa-route', label: 'Leads' },
    { href: '/admin/appointments', icon: 'fas fa-calendar-check', label: 'Appointments' },
    { href: '/admin/contacts', icon: 'fas fa-comments', label: 'Contacts' },
    { href: '/admin/quotes', icon: 'fas fa-file-invoice', label: 'Quotations' },
  ]},
  { label: 'Operations', items: [
    { href: '/admin/calendar', icon: 'fas fa-calendar', label: 'Calendar' },
    { href: '/admin/after-service', icon: 'fas fa-handshake', label: 'After Service' },
    { href: '/admin/remedies', icon: 'fas fa-prescription-bottle-alt', label: 'Remedies' },
  ]},
  { label: 'Marketing', items: [
    { href: '/admin/newsletter', icon: 'fas fa-envelope-open-text', label: 'Newsletter' },
    { href: '/admin/tools/follow-hub/insights', icon: 'fas fa-toolbox', label: 'Follow Hub' },
  ]},
  { label: 'Templates', items: [
    { href: '/admin/templates/email', icon: 'fas fa-envelope', label: 'Email Templates' },
    { href: '/admin/templates/payment', icon: 'fas fa-file-invoice-dollar', label: 'Payment Templates' },
    { href: '/admin/templates/whatsapp', icon: 'fab fa-whatsapp', label: 'WhatsApp Templates' },
  ]},
  { label: 'System', items: [
    { href: '/admin/settings', icon: 'fas fa-gear', label: 'Settings' },
    { href: '/api/admin/logout', icon: 'fas fa-sign-out-alt', label: 'Logout', style: 'color:#ef4444' },
  ]},
];
---

<aside class="sidebar" id="adminSidebar">
  <a href="/admin/dashboard" class="brand">
    <img src="https://images.unsplash.com/vector-1763306579596-25a002c977df?w=260&fit=max&auto=format" alt="Logo" />
  </a>
  <nav style="flex:1;overflow-y:auto">
    {menuGroups.map((group) => (
      <div class="nav-group">
        <div class="nav-label">{group.label}</div>
        {group.items.map((item) => (
          <a href={item.href} class={`nav-item ${activePage === item.href ? 'active' : ''}`} style={item.style}>
            <i class={item.icon}></i> {item.label}
          </a>
        ))}
      </div>
    ))}
  </nav>
</aside>

<div class="sidebar-backdrop" id="sidebarBackdrop"></div>

<script is:inline>
  (function() {
    // Restore state
    try {
      const saved = localStorage.getItem('sidebarState');
      if (saved === 'collapsed') {
        document.body.classList.add('sidebar-collapse');
      }
    } catch (e) { console.warn('LocalStorage access failed', e); }

    function toggleDesktop(e) {
      if (e) e.preventDefault();
      document.body.classList.toggle('sidebar-collapse');
      const isCollapsed = document.body.classList.contains('sidebar-collapse');
      localStorage.setItem('sidebarState', isCollapsed ? 'collapsed' : 'expanded');
    }

    function toggleMobile(e) {
      if (e) e.preventDefault();
      const sidebar = document.getElementById('adminSidebar');
      const backdrop = document.getElementById('sidebarBackdrop');
      if (sidebar) sidebar.classList.toggle('active');
      if (backdrop) backdrop.classList.toggle('active');
    }

    document.addEventListener('click', (e) => {
      const toggleBtn = e.target.closest('[data-widget="pushmenu"], #toggleSidebarDesktop, #sidebarToggle');
      if (toggleBtn) {
        if (window.innerWidth <= 768) {
          toggleMobile(e);
        } else {
          toggleDesktop(e);
        }
        return;
      }
      
      if (e.target.id === 'sidebarBackdrop') {
        toggleMobile(e);
      }
    });
  })();
</script>
