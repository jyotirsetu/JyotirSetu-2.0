---
export interface Props {
  activePage?: string;
}

const { activePage } = Astro.props;

  const menuItems = [
  { href: '/admin/dashboard', icon: 'fas fa-gauge', label: 'Dashboard' },
  { href: '/admin/leads', icon: 'fas fa-route', label: 'Leads' },
  { href: '/admin/appointments', icon: 'fas fa-calendar-check', label: 'Appointments' },
  { href: '/admin/contacts', icon: 'fas fa-comments', label: 'Contacts' },
  { href: '/admin/newsletter', icon: 'fas fa-envelope-open-text', label: 'Newsletter' },
  { href: '/admin/calendar', icon: 'fas fa-calendar', label: 'Calendar' },
  { href: '/admin/quotes', icon: 'fas fa-file-invoice', label: 'Quotations' },
  { href: '/admin/after-service', icon: 'fas fa-heart', label: 'After Service' },
  { href: '/admin/activity-log', icon: 'fas fa-list', label: 'Activity Log' },
  { href: '/admin/templates/email', icon: 'fas fa-file-alt', label: 'Email Templates' },
  { href: '/admin/templates/payment', icon: 'fas fa-file-invoice-dollar', label: 'Payment Templates' },
  { href: '/admin/templates/whatsapp', icon: 'fas fa-file-alt', label: 'WhatsApp Templates' },
  { href: '/admin/client360', icon: 'fas fa-user-circle', label: 'Client 360°' },
  { href: '/admin/users', icon: 'fas fa-users-cog', label: 'Users' },
  { href: '/admin/tools/follow-hub/insights', icon: 'fas fa-toolbox', label: 'Follow Hub – Insights' },
  { href: '/admin/settings', icon: 'fas fa-gear', label: 'Settings' },
];
---

<aside class="main-sidebar sidebar-dark-primary elevation-4" id="adminSidebar">
  <a href="/admin/dashboard" class="brand-link" style="display:flex;align-items:center;gap:8px">
    <img
      src="https://images.unsplash.com/vector-1763306579596-25a002c977df?q=80&w=1979&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
      alt="Brand"
      style="height:40px;width:auto;border-radius:0;box-shadow:0 2px 6px rgba(0,0,0,0.25)"
    />
  </a>
  <div class="sidebar">
    <nav class="mt-2">
      <ul class="nav nav-pills nav-sidebar flex-column" role="menu" data-accordion="false" data-widget="treeview">
        {
          menuItems.map((item) => (
            <li class="nav-item">
              <a href={item.href} class={`nav-link ${activePage === item.href ? 'active' : ''}`}>
                <i class={`nav-icon ${item.icon}`} />
                <p>{item.label}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</aside>
