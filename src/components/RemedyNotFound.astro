<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Remedy Not Found - JyotirSetu</title>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Lato:wght@300;400&display=swap" rel="stylesheet">
    <style>
      :root {
        --bg-deep: #0f0c29;
        --bg-mid: #302b63;
        --bg-light: #24243e;
        --accent-gold: #ffd700;
        --text-light: #e0e0e0;
      }

      body {
        margin: 0;
        padding: 0;
        background: linear-gradient(to bottom, var(--bg-deep), var(--bg-mid));
        color: var(--text-light);
        font-family: 'Lato', sans-serif;
        min-height: 100vh;
        overflow-x: hidden;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
      }

      .cosmos-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
        overflow: hidden;
      }

      .stars {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: transparent;
        box-shadow: 
          10vw 10vh 1px 0px white,
          20vw 20vh 1px 0px white,
          30vw 5vh 1px 0px white,
          40vw 30vh 1px 0px white,
          50vw 80vh 1px 0px white,
          60vw 10vh 1px 0px white,
          70vw 50vh 1px 0px white,
          80vw 20vh 1px 0px white,
          90vw 90vh 1px 0px white;
        animation: twinkle 5s infinite linear;
        opacity: 0.6;
      }
      
      .stars::after {
        content: " ";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: transparent;
        box-shadow: 
          15vw 15vh 1px 0px white,
          25vw 25vh 1px 0px white,
          35vw 15vh 1px 0px white,
          45vw 35vh 1px 0px white,
          55vw 85vh 1px 0px white,
          65vw 15vh 1px 0px white,
          75vw 55vh 1px 0px white,
          85vw 25vh 1px 0px white,
          95vw 95vh 1px 0px white;
        opacity: 0.4;
      }

      @keyframes twinkle {
        0% { opacity: 0.5; transform: translateY(0); }
        50% { opacity: 1; }
        100% { opacity: 0.5; transform: translateY(-10px); }
      }

      .main-container {
        text-align: center;
        position: relative;
        z-index: 1;
        padding: 20px;
        max-width: 800px;
      }

      .zodiac-wheel-container {
        position: relative;
        width: 300px;
        height: 300px;
        margin: 0 auto 40px;
      }

      .zodiac-wheel {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        border: 2px dashed rgba(255, 215, 0, 0.3);
        position: absolute;
        top: 0;
        left: 0;
        animation: rotate 60s linear infinite;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      
      .zodiac-symbol {
        position: absolute;
        font-size: 24px;
        color: rgba(255, 215, 0, 0.6);
        text-shadow: 0 0 5px rgba(255, 215, 0, 0.4);
      }

      /* Positioning zodiac signs in a circle */
      .zodiac-symbol:nth-child(1) { transform: rotate(0deg) translate(140px) rotate(0deg); }
      .zodiac-symbol:nth-child(2) { transform: rotate(30deg) translate(140px) rotate(-30deg); }
      .zodiac-symbol:nth-child(3) { transform: rotate(60deg) translate(140px) rotate(-60deg); }
      .zodiac-symbol:nth-child(4) { transform: rotate(90deg) translate(140px) rotate(-90deg); }
      .zodiac-symbol:nth-child(5) { transform: rotate(120deg) translate(140px) rotate(-120deg); }
      .zodiac-symbol:nth-child(6) { transform: rotate(150deg) translate(140px) rotate(-150deg); }
      .zodiac-symbol:nth-child(7) { transform: rotate(180deg) translate(140px) rotate(-180deg); }
      .zodiac-symbol:nth-child(8) { transform: rotate(210deg) translate(140px) rotate(-210deg); }
      .zodiac-symbol:nth-child(9) { transform: rotate(240deg) translate(140px) rotate(-240deg); }
      .zodiac-symbol:nth-child(10) { transform: rotate(270deg) translate(140px) rotate(-270deg); }
      .zodiac-symbol:nth-child(11) { transform: rotate(300deg) translate(140px) rotate(-300deg); }
      .zodiac-symbol:nth-child(12) { transform: rotate(330deg) translate(140px) rotate(-330deg); }

      @keyframes rotate {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }

      .center-icon {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 180px;
        height: 180px;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10;
      }
      
      .center-icon img {
        width: 100%;
        height: auto;
        object-fit: contain;
        filter: drop-shadow(0 0 15px rgba(255, 215, 0, 0.3));
      }

      h1 {
        font-family: 'Cinzel', serif;
        font-size: 3rem;
        margin: 0 0 10px;
        background: linear-gradient(to right, #ffd700, #ffec8b, #ffd700);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: 2px;
      }

      p.subtitle {
        font-size: 1.2rem;
        color: rgba(255, 255, 255, 0.7);
        margin-bottom: 40px;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
      }

      .info-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-top: 40px;
        text-align: left;
      }

      .card {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 20px;
        border-radius: 10px;
        transition: transform 0.3s, background 0.3s;
        backdrop-filter: blur(5px);
      }

      .card:hover {
        transform: translateY(-5px);
        background: rgba(255, 255, 255, 0.1);
        border-color: var(--accent-gold);
      }

      .card h3 {
        font-family: 'Cinzel', serif;
        color: var(--accent-gold);
        margin-top: 0;
        font-size: 1.2rem;
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .card p {
        font-size: 0.95rem;
        line-height: 1.5;
        color: #ccc;
      }

      .btn-glow {
        display: inline-block;
        margin-top: 15px;
        padding: 8px 20px;
        background: transparent;
        border: 1px solid var(--accent-gold);
        color: var(--accent-gold);
        text-decoration: none;
        font-size: 0.9rem;
        border-radius: 20px;
        transition: all 0.3s;
      }

      .btn-glow:hover {
        background: var(--accent-gold);
        color: #000;
        box-shadow: 0 0 15px rgba(255, 215, 0, 0.5);
      }
      
      /* Palmistry lines decoration */
      .palm-lines {
        position: absolute;
        bottom: -50px;
        right: -50px;
        width: 300px;
        height: 300px;
        opacity: 0.05;
        background-image: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M10 10 Q 50 50 90 10' stroke='white' fill='none'/%3E%3Cpath d='M10 50 Q 50 90 90 50' stroke='white' fill='none'/%3E%3C/svg%3E");
        transform: rotate(-20deg);
        pointer-events: none;
      }

      @media (max-width: 600px) {
        h1 { font-size: 2rem; }
        .zodiac-wheel-container { width: 250px; height: 250px; }
      }
    </style>
  </head>
  <body>
    <div class="cosmos-bg">
      <div class="stars"></div>
    </div>

    <div class="palm-lines"></div>

    <div class="main-container">
      <div class="zodiac-wheel-container">
        <div class="zodiac-wheel">
          <div class="zodiac-symbol">♈</div>
          <div class="zodiac-symbol">♉</div>
          <div class="zodiac-symbol">♊</div>
          <div class="zodiac-symbol">♋</div>
          <div class="zodiac-symbol">♌</div>
          <div class="zodiac-symbol">♍</div>
          <div class="zodiac-symbol">♎</div>
          <div class="zodiac-symbol">♏</div>
          <div class="zodiac-symbol">♐</div>
          <div class="zodiac-symbol">♑</div>
          <div class="zodiac-symbol">♒</div>
          <div class="zodiac-symbol">♓</div>
        </div>
        <div class="center-icon">
          <!-- Logo -->
          <img src="/logo.png" alt="JyotirSetu" />
        </div>
      </div>

      <h1>Remedy Not Found</h1>
      <p class="subtitle">The stars are silent. The remedy link you are trying to access may have expired or does not exist in this timeline.</p>

      <div class="info-cards">
        <div class="card">
          <h3><span>✉</span> Contact Us</h3>
          <p>Need assistance or a personal consultation? Reach out to our expert astrologers.</p>
          <a href="/contact" class="btn-glow">Get Support</a>
        </div>
        
        <div class="card">
          <h3><span>💬</span> WhatsApp</h3>
          <p>Chat directly with us for quick queries and support.</p>
          <a href="https://wa.me/919266991298" target="_blank" class="btn-glow">Chat Now</a>
        </div>
      </div>
    </div>
  </body>
</html>
