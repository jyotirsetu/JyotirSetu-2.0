---
const channelId = import.meta.env.PUBLIC_YOUTUBE_CHANNEL_ID || 'UChQeWv_q0GscYKZR3RgzatQ';
const youtubeChannelUrl = `https://www.youtube.com/channel/${channelId}`;
const youtubeSubscribeUrl = `${youtubeChannelUrl}?sub_confirmation=1`;
---
<div id="youtube-subscribe-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/80 p-4 backdrop-blur-sm" role="dialog" aria-modal="true">
  <div class="relative w-full max-w-3xl overflow-hidden rounded-[2rem] border border-slate-800 bg-slate-950 text-slate-100 shadow-2xl ring-1 ring-white/10">
    <button
      id="youtube-subscribe-close"
      class="absolute right-4 top-4 inline-flex h-11 w-11 items-center justify-center rounded-full bg-slate-800 text-slate-300 transition hover:bg-slate-700 hover:text-white"
      aria-label="Close subscribe modal"
    >
      ×
    </button>

    <div class="grid gap-8 p-6 sm:grid-cols-[1.2fr_0.8fr] sm:p-8">
      <div class="space-y-6">
        <div class="space-y-3">
          <p class="text-sm font-semibold uppercase tracking-[0.28em] text-indigo-400">YouTube Spotlight</p>
          <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Get notified when a new JyotirSetu video drops</h2>
          <p class="max-w-xl text-base leading-7 text-slate-400">
            Subscribe to our channel for practical astrology tips, real client stories, and live updates from JyotirSetu.
          </p>
        </div>

        <div class="space-y-4 rounded-[1.75rem] border border-slate-800 bg-slate-900 p-6 shadow-lg shadow-slate-950/40">
          <div class="flex items-center gap-4 rounded-3xl bg-slate-800 p-4">
            <div class="flex h-14 w-14 items-center justify-center rounded-3xl bg-red-600 text-xl font-bold text-white">YT</div>
            <div>
              <p class="text-sm uppercase tracking-[0.24em] text-slate-400">JyotirSetu</p>
              <p class="text-base font-semibold text-white">Your source for astrology guidance</p>
            </div>
          </div>

          <div class="space-y-2 rounded-3xl border border-slate-800 bg-slate-950 p-4">
            <p class="text-sm text-slate-400">Channel ID</p>
            <p class="text-sm font-medium text-slate-100 break-all">{channelId}</p>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row">
            <a
              href={youtubeSubscribeUrl}
              target="_blank"
              rel="noreferrer noopener"
              class="inline-flex w-full items-center justify-center rounded-full bg-red-600 px-6 py-3 text-sm font-semibold text-white transition hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500"
            >
              Subscribe Now
            </a>
            <a
              href={youtubeChannelUrl}
              target="_blank"
              rel="noreferrer noopener"
              class="inline-flex w-full items-center justify-center rounded-full border border-slate-700 bg-slate-900 px-6 py-3 text-sm font-semibold text-slate-100 transition hover:border-indigo-500 hover:bg-slate-800"
            >
              Visit Channel
            </a>
          </div>
        </div>

        <p class="text-sm leading-6 text-slate-400">
          This modal is designed to keep the experience polished and professional, while driving visitors directly to your channel to subscribe and view new videos.
        </p>
      </div>

      <div class="rounded-[1.75rem] border border-slate-800 bg-gradient-to-br from-slate-900 via-slate-950 to-indigo-950 p-6 shadow-xl shadow-indigo-950/20">
        <div class="space-y-4">
          <div class="flex items-center justify-between gap-4 rounded-3xl bg-slate-900/80 p-4">
            <div>
              <p class="text-xs uppercase tracking-[0.28em] text-indigo-300">Stay connected</p>
              <p class="mt-2 text-lg font-semibold text-white">New videos first in your feed</p>
            </div>
            <div class="inline-flex h-11 w-11 items-center justify-center rounded-3xl bg-indigo-600 text-white">▶</div>
          </div>

          <div class="rounded-3xl bg-slate-950/90 p-4 text-sm leading-6 text-slate-300">
            <p class="font-semibold text-white">Why subscribe?</p>
            <ul class="mt-3 space-y-2 text-slate-400">
              <li>• Receive alerts for every new JyotirSetu upload</li>
              <li>• Watch astrology guidance, rituals, and mindset content</li>
              <li>• Stay connected with practical spiritual tips and updates</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script type="module">
    const modal = document.getElementById('youtube-subscribe-modal');
    const closeButton = document.getElementById('youtube-subscribe-close');
    closeButton?.addEventListener('click', () => modal?.classList.add('hidden'));
    window.addEventListener('open-youtube-subscribe-modal', () => modal?.classList.remove('hidden'));
    modal?.addEventListener('click', (event) => {
      if (event.target === modal) modal.classList.add('hidden');
    });
  </script>
</div>
