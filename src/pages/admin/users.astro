---
import Favicons from '~/components/Favicons.astro';
import MobilePageSelect from '~/components/MobilePageSelect.astro';

export const prerender = false;

let allowed = true;
let users: Array<Record<string, unknown>> = [];
let error: string | null = null;
if (allowed) {
  try {
    const res = await fetch(new URL('/api/admin/users', Astro.url.origin).toString(), { headers: { Cookie: Astro.request.headers.get('Cookie') || '' } });
    const j = await res.json();
    users = Array.isArray(j.data) ? j.data : [];
  } catch { error = 'Failed to load users'; }
}
---


<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Users – Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@latest/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="/admin.css?v=20251129" />
    <Favicons />
  </head>
  <body class="hold-transition sidebar-mini">
    <script is:inline>
      /* @ts-nocheck */
      (function () {
        function applyTheme(theme) {
          let t = theme;
          if (t === 'auto') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.body.classList.toggle('dark-mode', t === 'dark');
        }
        let theme = 'dark';
        let collapsed = false;
        try {
          const stored = localStorage.getItem('adminSettings');
          if (stored) {
            const s = JSON.parse(stored);
            if (s && typeof s === 'object') {
              if (s.theme) theme = s.theme;
              if (s.sidebarCollapsed != null) collapsed = !!s.sidebarCollapsed;
            }
          }
        } catch (e) {
          console.error('Error loading admin settings:', e);
        }
        applyTheme(theme);
        document.body.classList.toggle('sidebar-collapse', collapsed);
        try {
          Promise.all([
            fetch('/api/admin/preferences?key=theme').then(function (r) {
              return r.json();
            }),
            fetch('/api/admin/preferences?key=sidebarCollapsed').then(function (r) {
              return r.json();
            }),
          ])
            .then(function (rs) {
              const tr = rs[0],
                sr = rs[1];
              if (tr && tr.ok && typeof tr.value === 'string') applyTheme(tr.value);
              if (sr && sr.ok && sr.value != null) document.body.classList.toggle('sidebar-collapse', sr.value === '1');
            })
            .catch(function (err) {
              console.error('Error syncing preferences:', err);
            });
        } catch (e) {
          console.error('Error syncing preferences:', e);
        }
      })();
    </script>
    <div class="wrapper">
      <nav class="main-header navbar navbar-expand navbar-dark">
        <ul class="navbar-nav">
          <li class="nav-item">
            <MobilePageSelect />
          </li>
          <li class="nav-item"><a href="/admin/dashboard" class="nav-link">Dashboard</a></li>
        </ul>
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a href="/api/admin/logout" class="nav-link">Logout</a></li>
        </ul>
      </nav>
      <aside class="main-sidebar sidebar-dark-primary elevation-4" id="adminSidebar">
        <a href="/admin/dashboard" class="brand-link" style="display:flex;align-items:center;gap:8px">
          <img
            src="https://images.unsplash.com/vector-1763306579596-25a002c977df?q=80&w=1979&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
            alt="Brand"
            style="height:40px;width:auto;border-radius:0;box-shadow:0 2px 6px rgba(0,0,0,0.25)"
          />
        </a>
        <div class="sidebar">
          <nav class="mt-2">
            <ul class="nav nav-pills nav-sidebar flex-column" role="menu" data-accordion="false" data-widget="treeview">
              <li class="nav-item">
                <a href="/admin/dashboard" class="nav-link"><i class="nav-icon fas fa-gauge"></i><p>Dashboard</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/leads" class="nav-link"><i class="nav-icon fas fa-route"></i><p>Leads</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/appointments" class="nav-link"><i class="nav-icon fas fa-calendar-check"></i><p>Appointments</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/contacts" class="nav-link"><i class="nav-icon fas fa-comments"></i><p>Contacts</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/newsletter" class="nav-link"><i class="nav-icon fas fa-envelope-open-text"></i><p>Newsletter</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/calendar" class="nav-link"><i class="nav-icon fas fa-calendar"></i><p>Calendar</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/quotes" class="nav-link"><i class="nav-icon fas fa-file-invoice"></i><p>Quotations</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/after-service" class="nav-link"><i class="nav-icon fas fa-handshake"></i><p>After Service</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/remedies" class="nav-link"><i class="nav-icon fas fa-prescription-bottle-alt"></i><p>Remedies</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/activity-log" class="nav-link"><i class="nav-icon fas fa-list"></i><p>Activity Log</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/templates/email" class="nav-link"><i class="nav-icon fas fa-file-alt"></i><p>Email Templates</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/templates/payment" class="nav-link"><i class="nav-icon fas fa-file-invoice-dollar"></i><p>Payment Templates</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/client360" class="nav-link"><i class="nav-icon fas fa-user-circle"></i><p>Client 360°</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/users" class="nav-link active"><i class="nav-icon fas fa-users-cog"></i><p>Users</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/tools/follow-hub/insights" class="nav-link"><i class="nav-icon fas fa-toolbox"></i><p>Follow Hub – Insights</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/settings" class="nav-link"><i class="nav-icon fas fa-gear"></i><p>Settings</p></a>
              </li>
            </ul>
          </nav>
        </div>
      </aside>
    <div class="content-wrapper">
      <div class="content-header">
        <div class="container-fluid">
          <div class="row mb-2">
            <div class="col-sm-6">
              <h1 class="m-0">User Management</h1>
            </div>
          </div>
        </div>
      </div>
      <div class="content">
        <div class="container-fluid">
          { !allowed ? (
            <div class="alert alert-danger">Access denied.</div>
          ) : (
            <div class="row">
              <div class="col-md-4">
                <div class="card">
                  <div class="card-header"><strong>Add User</strong></div>
                  <div class="card-body">
                    <div class="mb-2"><input id="username" class="form-control" placeholder="Username" /></div>
                    <div class="mb-2"><input id="password" type="password" class="form-control" placeholder="Password" /></div>
                    <div class="mb-2">
                      <select id="role" class="form-select">
                        <option value="support">Support</option>
                        <option value="consultant">Consultant</option>
                        <option value="manager">Manager</option>
                        <option value="admin">Admin</option>
                        <option value="super_admin">Super Admin</option>
                      </select>
                    </div>
                    <button type="button" class="btn btn-primary" id="createUserBtn">Create</button>
                  </div>
                </div>
              </div>
              <div class="col-md-8">
                <div class="card">
                  <div class="card-header"><strong>Users</strong></div>
                  <div class="card-body">
                    { error && (<div class="alert alert-danger">{error}</div>) }
                    <div class="table-responsive">
                      <table class="table table-bordered">
                        <thead>
                          <tr><th>Username</th><th>Role</th><th>Actions</th></tr>
                        </thead>
                        <tbody>
                          { users.map((u) => (
                            <tr>
                              <td>{String(u.username||'')}</td>
                              <td>{String(u.role||'')}</td>
                              <td>
                                <button class="btn btn-sm btn-outline-secondary editUser" data-id={String(u.id||'')}>Edit</button>
                              </td>
                            </tr>
                          )) }
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ) }
        </div>
      </div>
    </div>
  </div>

  <div id="usersMsg" style="display:none;position:fixed;inset:0;z-index:2000;background:rgba(0,0,0,0.5)">
    <div style="max-width:480px;margin:10% auto;background:var(--panel);border:1px solid var(--border);border-radius:10px;overflow:hidden">
      <div id="usersMsgTitle" style="padding:12px 16px;border-bottom:1px solid var(--border);font-weight:600">Message</div>
      <div id="usersMsgBody" style="padding:16px"></div>
      <div style="padding:12px 16px;border-top:1px solid var(--border);text-align:right"><button id="usersMsgClose" class="btn btn-secondary btn-sm">Close</button></div>
    </div>
  </div>

  <script is:inline>
    (function(){
      const msg = document.getElementById('usersMsg');
      const msgTitle = document.getElementById('usersMsgTitle');
      const msgBody = document.getElementById('usersMsgBody');
      const msgClose = document.getElementById('usersMsgClose');
      function showMessage(title, body){
        const t = String(title||'Message'); const b = String(body||'');
        try {
          const wn = typeof window !== 'undefined' ? window : null;
          const notify = wn && wn['AdminNotify'];
          const infoFn = notify && notify['info'];
          if (typeof infoFn === 'function') { infoFn(t, b); return; }
        } catch { void 0; }
        if (msgTitle) msgTitle.textContent = t; if (msgBody) msgBody.textContent = b; if (msg) msg.style.display='block';
      }
      function hideMessage(){ if (msg) msg.style.display='none'; }
      msgClose?.addEventListener('click', hideMessage);
      function getCsrf(){ try { const m=document.cookie.match(/csrf_token=([^;]+)/); return m? m[1] : ''; } catch { return ''; } }
      document.getElementById('createUserBtn')?.addEventListener('click', async function(){
        const uEl = document.getElementById('username');
        const pEl = document.getElementById('password');
        const rEl = document.getElementById('role');
        const username = (uEl instanceof HTMLInputElement) ? String(uEl.value||'').trim() : '';
        const password = (pEl instanceof HTMLInputElement) ? String(pEl.value||'') : '';
        const role = (rEl instanceof HTMLSelectElement) ? String(rEl.value||'support') : 'support';
        if (!username || !password) { 
        showMessage('Validation', 'Please enter username and password'); return; 
        }
        try {
          const res = await fetch('/api/admin/users', { method:'POST', credentials:'include', headers:{ 'Content-Type':'application/json','x-csrf-token': getCsrf() }, body: JSON.stringify({ username, password, role }) });
          const j = await res.json();
          if (res.ok && j && j.ok) { location.reload(); } else { showMessage('Create failed', String((j && j.error) || 'Failed to create user')); }
        } catch { showMessage('Create failed', 'Failed to create user'); }
      });
      document.addEventListener('click', function(e){
        const target = e && e.target ? e.target : null;
        if (!(target instanceof Element)) return;
        const btn = target.closest('.editUser');
        if (!btn) return;
        const id = btn && btn['dataset'] ? String((btn['dataset']['id']||'')) : '';
        const role = prompt('New role (support/consultant/manager/admin/super_admin)')||'';
        if (!id || !role) return;
        const perms = prompt('Comma separated extra permissions (optional)')||'';
        const permissions = perms ? perms.split(',').map(function(p){ return p.trim(); }).filter(Boolean) : [];
        fetch('/api/admin/users', { method:'PUT', credentials:'include', headers:{ 'Content-Type':'application/json','x-csrf-token': getCsrf() }, body: JSON.stringify({ id, role, permissions }) })
          .then(function(res){ return res.json().then(function(j){ if (res.ok && j && j.ok) location.reload(); else showMessage('Update failed', String((j && j.error) || 'Failed to update user')); }); })
          .catch(function(){ showMessage('Update failed', 'Failed to update user'); });
      });
    })();
  </script>
  <style>
    .card { background: var(--panel); color: var(--text); border-color: var(--border); }
  </style>

  </body>
</html>
