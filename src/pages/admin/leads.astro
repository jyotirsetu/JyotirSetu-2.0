---
import Layout from '../../layouts/Layout.astro';
import AdminNavbar from '~/components/AdminNavbar.astro';
import AdminSidebar from '~/components/AdminSidebar.astro';
---

<Layout>
  <AdminNavbar />
  <div class="wrapper">
    <AdminSidebar activePage="/admin/leads" />
    <div class="content-wrapper">
      <div class="content-header">
        <div class="container-fluid">
          <div class="row mb-2">
            <div class="col-sm-6">
              <h1 class="m-0">Leads Pipeline</h1>
            </div>
          </div>
        </div>
      </div>
      <div class="content">
        <div class="container-fluid">
          <div class="row" id="leadMetrics" style="margin-bottom:12px">
            <div class="col-md-3 col-6"><div class="info-box"><span class="info-box-icon bg-info"><i class="fas fa-plus"></i></span><div class="info-box-content"><span class="info-box-text">New</span><span class="info-box-number" id="metricNew">0</span></div></div></div>
            <div class="col-md-3 col-6"><div class="info-box"><span class="info-box-icon bg-warning"><i class="fas fa-spinner"></i></span><div class="info-box-content"><span class="info-box-text">In Progress</span><span class="info-box-number" id="metricProgress">0</span></div></div></div>
            <div class="col-md-3 col-6"><div class="info-box"><span class="info-box-icon bg-success"><i class="fas fa-check"></i></span><div class="info-box-content"><span class="info-box-text">Converted</span><span class="info-box-number" id="metricConverted">0</span></div></div></div>
            <div class="col-md-3 col-6"><div class="info-box"><span class="info-box-icon bg-danger"><i class="fas fa-times"></i></span><div class="info-box-content"><span class="info-box-text">Lost</span><span class="info-box-number" id="metricLost">0</span></div></div></div>
          </div>
          <div class="row" id="leadActions" style="margin-bottom:12px">
            <div class="col-12">
              <div class="input-group">
                <input id="newLeadName" class="form-control" placeholder="Lead name" />
                <input id="newLeadPhone" class="form-control" placeholder="Mobile" />
                <input id="newLeadEmail" class="form-control" placeholder="Email (optional)" />
                <button class="btn btn-primary" id="createLead"><span class="btnLabel">Create Lead</span><span class="btnSpinner" style="display:none;margin-left:6px"><i class="fas fa-spinner fa-spin"></i></span></button>
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-12">
              <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                  <strong>Leads</strong>
                  <div class="d-flex" style="gap:8px">
                    <input id="filterText" class="form-control form-control-sm" placeholder="Filter by name/email/phone" style="max-width:320px" />
                    <select id="filterStage" class="form-select form-select-sm" style="max-width:180px">
                      <option value="">All Stages</option>
                      <option value="prospect">Prospect</option>
                      <option value="contacted">Contacted</option>
                      <option value="consultation">Consultation</option>
                      <option value="converted">Converted</option>
                      <option value="lost">Lost</option>
                    </select>
                  </div>
                </div>
                <div class="card-body table-responsive">
                  <table class="table table-striped" id="leadsTable">
                    <thead>
                      <tr>
                        <th data-sort="name">Name</th>
                        <th data-sort="email">Email</th>
                        <th data-sort="phone">Phone</th>
                        <th data-sort="stage">Stage</th>
                        <th data-sort="created_at">Created</th>
                        <th>Actions</th>
                      </tr>
                    </thead>
                    <tbody></tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@latest/dist/css/adminlte.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6/css/all.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/admin-lte@latest/dist/js/adminlte.min.js" defer></script>
  <script is:inline>
    (function(){
      function getCookie(name){ const m=document.cookie.match(new RegExp(name+'=([^;]+)')); return m? m[1]:''; }
      function showToast(msg, type){
        let box = document.getElementById('toastBox');
        if (!box) { box = document.createElement('div'); box.id='toastBox'; box.style.position='fixed'; box.style.top='16px'; box.style.right='16px'; box.style.zIndex='2000'; box.style.display='flex'; box.style.flexDirection='column'; box.style.gap='8px'; document.body.appendChild(box); }
        const el = document.createElement('div'); el.className='toast'; el.textContent=String(msg||''); el.style.padding='8px 12px'; el.style.borderRadius='8px'; el.style.color='#fff'; el.style.boxShadow='0 6px 18px rgba(0,0,0,0.25)'; el.style.background = type==='error' ? '#ef4444' : '#10b981'; box.appendChild(el); setTimeout(function(){ try { el.remove(); } catch { void 0; } }, 2500);
      }
      let leadsCache = [];
      let sortKey = 'created_at'; let sortAsc = false;
      function updateMetrics(rows){
        const newC = rows.filter(function(l){ return String(l.stage||'prospect')==='prospect'; }).length;
        const progC = rows.filter(function(l){ return ['contacted','consultation'].includes(String(l.stage||'')); }).length;
        const convC = rows.filter(function(l){ return String(l.stage||'')==='converted'; }).length;
        const lostC = rows.filter(function(l){ return String(l.stage||'')==='lost'; }).length;
        const set = function(id, v){ const el=document.getElementById(id); if(el) el.textContent = String(v); };
        set('metricNew', newC); set('metricProgress', progC); set('metricConverted', convC); set('metricLost', lostC);
      }
      function renderTable(rows){
        const tb = document.querySelector('#leadsTable tbody'); if (!tb) return;
        const fEl = document.getElementById('filterText');
        const sEl = document.getElementById('filterStage');
        const q = String((fEl instanceof HTMLInputElement ? fEl.value : '')).toLowerCase().trim();
        const fs = String((sEl instanceof HTMLSelectElement ? sEl.value : ''));
        const filtered = rows.filter(function(l){
          const matchText = !q || String(l.name||'').toLowerCase().includes(q) || String(l.email||'').toLowerCase().includes(q) || String(l.phone||'').toLowerCase().includes(q);
          const matchStage = !fs || String(l.stage||'')===fs;
          return matchText && matchStage;
        });
        filtered.sort(function(a,b){ const va=String(a[sortKey]||''); const vb=String(b[sortKey]||''); const cmp = va.localeCompare(vb); return sortAsc? cmp : -cmp; });
        tb.innerHTML = filtered.map(function(l){
          return `<tr>
            <td>${l.name||''}</td>
            <td>${l.email||''}</td>
            <td>${l.phone||''}</td>
            <td>
              <select class="form-select form-select-sm leadStage" data-id="${l.id}">
                <option value="prospect" ${l.stage==='prospect'?'selected':''}>Prospect</option>
                <option value="contacted" ${l.stage==='contacted'?'selected':''}>Contacted</option>
                <option value="consultation" ${l.stage==='consultation'?'selected':''}>Consultation</option>
                <option value="converted" ${l.stage==='converted'?'selected':''}>Converted</option>
                <option value="lost" ${l.stage==='lost'?'selected':''}>Lost</option>
              </select>
            </td>
            <td>${new Date(l.created_at||Date.now()).toLocaleString()}</td>
            <td>
              <a class="btn btn-sm btn-outline-primary" href="/admin/client360?phone=${encodeURIComponent(String(l.phone||''))}">View</a>
            </td>
          </tr>`;
        }).join('');
        updateMetrics(rows);
      }
      async function loadLeads(){
        try {
          const res = await fetch('/api/admin/leads', { credentials: 'include' });
          const j = await res.json();
          if (!res.ok || !j || j.ok === false) { throw new Error(String(j && j.error || 'Failed to load leads')); }
          const rows = Array.isArray(j.data) ? j.data : [];
          leadsCache = rows;
          renderTable(rows);
        } catch {
          showToast('Failed to load leads','error');
        }
      }
      document.getElementById('filterText')?.addEventListener('input', function(){ renderTable(leadsCache); });
      document.getElementById('filterStage')?.addEventListener('change', function(){ renderTable(leadsCache); });
      document.querySelectorAll('#leadsTable thead th[data-sort]')?.forEach(function(th){ th.addEventListener('click', function(){ const k=(th && (th as HTMLElement).dataset ? (th as HTMLElement).dataset.sort : 'created_at'); if (sortKey===k) sortAsc=!sortAsc; else { sortKey=String(k||'created_at'); sortAsc=true; } renderTable(leadsCache); }); });
      document.addEventListener('change', async function(e){
        const sel = e.target && e.target.closest('.leadStage');
        if (!sel) return;
        const id = sel.getAttribute('data-id');
        const to_stage = String(sel.value||'prospect');
        const csrf = getCookie('csrf_token');
        try {
          await fetch('/api/admin/leads', { method:'POST', credentials: 'include', headers:{ 'Content-Type':'application/json','x-csrf-token': csrf||'' }, body: JSON.stringify({ action:'advance_stage', id, to_stage }) });
          showToast('Stage updated');
        } catch { showToast('Failed to update stage','error'); }
        loadLeads();
      });
      document.addEventListener('click', async function(e){
        const btn = e.target && e.target.closest('.saveSla');
        if (!btn) return;
        const id = btn.getAttribute('data-id');
        const inp = document.querySelector('.leadSla[data-id="'+id+'"]');
        const sla = (inp instanceof HTMLInputElement) ? String(inp.value||'') : '';
        const csrf = getCookie('csrf_token');
        try {
          await fetch('/api/admin/leads', { method:'POST', credentials: 'include', headers:{ 'Content-Type':'application/json','x-csrf-token': csrf||'' }, body: JSON.stringify({ action:'update_sla', id, sla_due_at: sla }) });
          showToast('SLA updated');
        } catch { showToast('Failed to update SLA','error'); }
        loadLeads();
      });
      document.addEventListener('click', async function(e){
        const t = e && e.target ? e.target : null;
        const b = (t instanceof Element) && t.closest ? t.closest('.viewHistory') : null;
        if (!b) return;
        const id = b && b['getAttribute'] ? String(b['getAttribute']('data-id')||'') : '';
        try {
          const res = await fetch('/api/admin/lead-history?lead_id='+encodeURIComponent(id), { credentials:'include' });
          const j = await res.json();
          const rows = Array.isArray(j.data)? j.data: [];
          const body = document.getElementById('historyBody');
          if (!body) return;
          body.innerHTML = '<table class="table"><thead><tr><th>When</th><th>From</th><th>To</th><th>By</th><th>Note</th></tr></thead><tbody>'+rows.map(function(r){ return '<tr><td>'+String(r.changed_at||'')+'</td><td>'+String(r.from_stage||'')+'</td><td>'+String(r.to_stage||'')+'</td><td>'+String(r.changed_by||'')+'</td><td>'+String(r.note||'')+'</td></tr>'; }).join('')+'</tbody></table>';
          document.getElementById('historyModal').classList.add('active');
        } catch {
          showToast('Failed to load history','error');
        }
      });
      document.getElementById('createLead')?.addEventListener('click', async function(){
        const btn = document.getElementById('createLead');
        const nameEl = document.getElementById('newLeadName');
        const phoneEl = document.getElementById('newLeadPhone');
        const emailEl = document.getElementById('newLeadEmail');
        const name = (nameEl?.value||'').trim();
        const phone = (phoneEl?.value||'').trim();
        const email = (emailEl?.value||'').trim();
        if (!name) { alert('Enter name'); return; }
        const csrf = getCookie('csrf_token');
        try {
          btn.disabled = true;
          const sp = btn && btn.querySelector ? btn.querySelector('.btnSpinner') : null; if (sp && sp instanceof HTMLElement) { sp.style.display = 'inline-block'; }
          const res = await fetch('/api/admin/leads', { method:'POST', credentials: 'include', headers:{ 'Content-Type':'application/json','x-csrf-token': csrf||'' }, body: JSON.stringify({ action:'create', name, phone, email }) });
          let j = null; try { j = await res.json(); } catch { j = null; }
          if (!res.ok || !j || j.ok===false) { showToast('Failed to create lead','error'); return; }
          nameEl.value=''; phoneEl.value=''; emailEl.value='';
          await loadLeads();
          showToast('Lead created');
        } catch {
          showToast('Network error while creating lead','error');
        } finally {
          if (btn) btn.disabled = false;
          const sp2 = btn && btn.querySelector ? btn.querySelector('.btnSpinner') : null; if (sp2 && sp2 instanceof HTMLElement) { sp2.style.display = 'none'; }
        }
      });
      document.getElementById('historyClose')?.addEventListener('click', function(){ const m=document.getElementById('historyModal'); if(m) m.classList.remove('active'); });
      loadLeads();
    })();
  </script>
  <style>
    .list-group-item { background: var(--panel); color: var(--text); border-color: var(--border); }
    .card { background: var(--panel); color: var(--text); border-color: var(--border); }
    .card-header { font-weight: 600; }
    
    .sla-overdue { border-color: #ef4444; }
    .modal { position: fixed; inset:0; display:none; align-items:center; justify-content:center; background: rgba(2,6,23,0.6); z-index: 2000; }
    .modal.active { display:flex; }
    .modal .modal-content { background: var(--panel); border:1px solid var(--border); border-radius:12px; padding:16px; width:90%; max-width:720px; max-height:80vh; overflow:auto; }
  </style>
  <div id="historyModal" class="modal"><div class="modal-content"><div class="modal-header"><h3>Stage History</h3><button class="close-btn" id="historyClose">×</button></div><div id="historyBody"></div></div></div>
</Layout>
