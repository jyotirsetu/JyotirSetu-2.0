---
export const prerender = false;
import Favicons from '~/components/Favicons.astro';
import MobilePageSelect from '~/components/MobilePageSelect.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payment Email Templates – Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@latest/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="/admin.css?v=20251116" />
    <Favicons />
    <script src="https://cdn.jsdelivr.net/npm/tinymce@6/tinymce.min.js"></script>
    <script src="/js/admin-notify.js" defer></script>
    <script>
      (function () {
        function defineFallback() {
          try {
            if (window.AdminNotify) return;
            window.AdminNotify = {
              success: function (msg, detail) {
                console.log('SUCCESS:', detail ? msg + ': ' + detail : msg);
              },
              error: function (msg, detail) {
                console.error('ERROR:', detail ? msg + ': ' + detail : msg);
              },
              info: function (msg, detail) {
                console.log('INFO:', detail ? msg + ': ' + detail : msg);
              },
            };
          } catch (e) {
            console.error('AdminNotify fallback error:', e);
          }
        }
        function reinject() {
          try {
            const s = document.createElement('script');
            s.src = '/js/admin-notify.js';
            s.defer = true;
            document.body.appendChild(s);
          } catch (e) {
            console.error('AdminNotify reinject error:', e);
          }
        }
        defineFallback();
        setTimeout(reinject, 100);
      })();
    </script>
  </head>
  <body class="hold-transition sidebar-mini">
    <script is:inline>
      (function () {
        function applyTheme(theme) {
          let t = theme;
          if (t === 'auto') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.body.classList.toggle('dark-mode', t === 'dark');
        }
        let theme = 'dark';
        let collapsed = false;
        try {
          const stored = localStorage.getItem('adminSettings');
          if (stored) {
            const s = JSON.parse(stored);
            if (s && typeof s === 'object') {
              if (s.theme) theme = s.theme;
              if (s.sidebarCollapsed != null) collapsed = !!s.sidebarCollapsed;
            }
          }
        } catch (e) {
          console.error('Error loading admin settings:', e);
        }
        applyTheme(theme);
        document.body.classList.toggle('sidebar-collapse', collapsed);
        try {
          Promise.all([
            fetch('/api/admin/preferences?key=theme').then(function (r) {
              return r.json();
            }),
            fetch('/api/admin/preferences?key=sidebarCollapsed').then(function (r) {
              return r.json();
            }),
          ])
            .then(function (rs) {
              const tr = rs[0],
                sr = rs[1];
              if (tr && tr.ok && typeof tr.value === 'string') applyTheme(tr.value);
              if (sr && sr.ok && sr.value != null) document.body.classList.toggle('sidebar-collapse', sr.value === '1');
            })
            .catch(function (err) {
              console.error('Error syncing preferences:', err);
            });
        } catch (e) {
          console.error('Error syncing preferences:', e);
        }
      })();
    </script>
    <div class="wrapper">
      <nav class="main-header navbar navbar-expand navbar-dark">
        <ul class="navbar-nav">
          <li class="nav-item">
            <MobilePageSelect />
          </li>
          <li class="nav-item"><a href="/admin/dashboard" class="nav-link">Dashboard</a></li>
        </ul>
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a href="/api/admin/logout" class="nav-link">Logout</a></li>
        </ul>
      </nav>
      <aside class="main-sidebar sidebar-dark-primary elevation-4" id="adminSidebar">
        <a href="/admin/dashboard" class="brand-link" style="display:flex;align-items:center;gap:8px">
          <img
            src="https://images.unsplash.com/vector-1763306579596-25a002c977df?q=80&w=1979&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
            alt="Brand"
            style="height:40px;width:auto;border-radius:0;box-shadow:0 2px 6px rgba(0,0,0,0.25)"
          />
        </a>
        <div class="sidebar">
          <nav class="mt-2">
            <ul class="nav nav-pills nav-sidebar flex-column" role="menu" data-accordion="false" data-widget="treeview">
              <li class="nav-item">
                <a href="/admin/dashboard" class="nav-link"><i class="nav-icon fas fa-gauge"></i><p>Dashboard</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/appointments" class="nav-link"
                  ><i class="nav-icon fas fa-calendar-check"></i><p>Appointments</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/contacts" class="nav-link"><i class="nav-icon fas fa-comments"></i><p>Contacts</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/newsletter" class="nav-link"
                  ><i class="nav-icon fas fa-envelope-open-text"></i><p>Newsletter</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/calendar" class="nav-link"><i class="nav-icon fas fa-calendar"></i><p>Calendar</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/quotes" class="nav-link"
                  ><i class="nav-icon fas fa-file-invoice"></i><p>Quotations</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/after-service" class="nav-link"
                  ><i class="nav-icon fas fa-handshake"></i><p>After Service</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/remedies" class="nav-link"
                  ><i class="nav-icon fas fa-prescription-bottle-alt"></i><p>Remedies</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/activity-log" class="nav-link"
                  ><i class="nav-icon fas fa-list"></i><p>Activity Log</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/templates/email" class="nav-link"
                  ><i class="nav-icon fas fa-file-alt"></i><p>Email Templates</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/templates/payment" class="nav-link active"
                  ><i class="nav-icon fas fa-file-invoice-dollar"></i><p>Payment Templates</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/templates/whatsapp" class="nav-link"
                  ><i class="nav-icon fas fa-file-alt"></i><p>WhatsApp Templates</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/client360" class="nav-link"
                  ><i class="nav-icon fas fa-user-circle"></i><p>Client 360°</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/users" class="nav-link"><i class="nav-icon fas fa-users-cog"></i><p>Users</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/tools/follow-hub/insights" class="nav-link"
                  ><i class="nav-icon fas fa-toolbox"></i><p>Follow Hub – Insights</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/settings" class="nav-link"><i class="nav-icon fas fa-gear"></i><p>Settings</p></a>
              </li>
            </ul>
          </nav>
        </div>
      </aside>
      <div class="content-wrapper">
        <section class="content-header">
          <div class="container-fluid">
            <div class="row mb-2">
              <div class="col-sm-6"><h1>Payment Email Templates</h1></div>
              <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                  <li class="breadcrumb-item"><a href="/admin/dashboard">Home</a></li>
                  <li class="breadcrumb-item active">Payment Email Templates</li>
                </ol>
              </div>
            </div>
          </div>
        </section>
        <section class="content">
          <div class="container-fluid">
            <div class="toolbar toolbar-card">
              <button class="btn btn-sm btn-primary" id="previewBtn">👁️ Preview</button>
              <button class="btn btn-sm btn-success" id="exportBtn">📥 Export</button>
              
            </div>
            <div class="container-fluid" style="padding-bottom:20px">
              <style>
                .modal {
                  display: none;
                  position: fixed;
                  top: 0;
                  left: 0;
                  right: 0;
                  bottom: 0;
                  background: rgba(2, 6, 23, 0.6);
                  z-index: 1000;
                  align-items: center;
                  justify-content: center;
                }
                .modal.active {
                  display: flex;
                }
                .modal-content {
                  background: #0f172a;
                  padding: 24px;
                  border-radius: 12px;
                  max-width: 520px;
                  width: 90%;
                  box-shadow: 0 30px 80px rgba(15, 23, 42, 0.8);
                  border: 1px solid rgba(148, 163, 184, 0.25);
                }
                .modal-header {
                  display: flex;
                  justify-content: space-between;
                  align-items: center;
                  margin-bottom: 16px;
                  border-bottom: 1px solid rgba(148, 163, 184, 0.2);
                  padding-bottom: 10px;
                }
                .close-btn {
                  background: none;
                  border: none;
                  font-size: 24px;
                  cursor: pointer;
                  padding: 0;
                  width: 32px;
                  height: 32px;
                  color: #94a3b8;
                  line-height: 1;
                }
                .confirm-row {
                  display: grid;
                  grid-template-columns: 140px 1fr;
                  gap: 10px;
                  color: #e5e7eb;
                }
              </style>
              <div class="cards" style="grid-template-columns: 1fr 1fr 1fr;">
                <div class="card">
                  <label>Template Key *</label>
                  <input class="input" id="key" placeholder="e.g. unpaid, partial, paid" />
                  <div class="info-text" style="margin-top: 4px;">Use payment status keys</div>
                </div>
                <div class="card">
                  <label>Email Subject *</label>
                  <input class="input" id="subject" placeholder="Email subject line" />
                </div>
                <div class="card">
                  <label>Actions</label>
                  <div class="template-actions">
                    <button
                      class="btn"
                      id="saveBtn"
                      style="background:#667eea;color:white;border:none;padding:8px 16px;border-radius:6px;cursor:pointer;flex:1"
                      >💾 Save</button
                    >
                    <button
                      class="btn-sm"
                      id="deleteBtn"
                      style="background:#ef4444;color:white;border:none;padding:8px 12px;border-radius:6px;cursor:pointer"
                      >🗑️ Delete</button
                    >
                  </div>
                </div>
              </div>

              <div class="template-editor">
                <div>
                  <label>HTML Content *</label>
                  <div id="htmlEditor"></div>
                </div>
                <div>
                  <label>Preview</label>
                  <div id="preview" class="editor-preview"></div>
                </div>
              </div>

              <div class="card" style="margin-top:20px">
                <strong>Variables</strong>
                <div class="variables-tags">
                  <span class="variable-tag" data-var="{name}">&lbrace;name&rbrace;</span>
                  <span class="variable-tag" data-var="{service}">&lbrace;service&rbrace;</span>
                  <span class="variable-tag" data-var="{date}">&lbrace;date&rbrace;</span>
                  <span class="variable-tag" data-var="{time}">&lbrace;time&rbrace;</span>
                  <span class="variable-tag" data-var="{method}">&lbrace;method&rbrace;</span>
                  <span class="variable-tag" data-var="{status}">&lbrace;status&rbrace;</span>
                  <span class="variable-tag" data-var="{appointment_id}">&lbrace;appointment_id&rbrace;</span>
                  <span class="variable-tag" data-var="{follow_link}">&lbrace;follow_link&rbrace;</span>
                </div>
              </div>

              <div class="card" style="margin-top:20px">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
                  <strong>Quick Actions</strong>
                  <button
                    class="btn-sm"
                    id="seedDefaults"
                    style="background:#667eea;color:white;border:none;padding:6px 12px;border-radius:6px;cursor:pointer"
                    >📦 Load Default Set</button
                  >
                </div>
                <div
                  id="quickTemplates"
                  style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px"
                >
                </div>
              </div>

              <div class="card" style="margin-top:20px">
                <strong>Existing Templates</strong>
                <div
                  id="templateList"
                  style="margin-top:12px;display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px"
                >
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>
      <footer class="main-footer">
        <strong>JyotirSetu Admin</strong><div class="float-end d-none d-sm-inline">AdminLTE theme</div>
      </footer>
    </div>

    <!-- Delete Confirm Modal -->
    <div class="modal" id="deleteConfirmModal">
      <div class="modal-content">
        <div class="modal-header">
          <h3>Delete Email Template</h3>
          <button class="close-btn" id="deleteClose">&times;</button>
        </div>
        <div id="deleteConfirmBody" class="confirm-row"></div>
        <div
          style="display:flex; gap:12px; justify-content:flex-end; margin-top:16px; padding-top:12px; border-top:1px solid rgba(148,163,184,0.2);"
        >
          <button
            type="button"
            class="btn-sm"
            id="deleteCancel"
            style="background:#f3f4f6;color:#0f172a;border:1px solid #d1d5db;padding:8px 14px;border-radius:8px;cursor:pointer"
            >Cancel</button
          >
          <button
            type="button"
            class="btn-sm"
            id="deleteConfirm"
            style="background:#ef4444;color:#ffffff;border:none;padding:8px 14px;border-radius:8px;cursor:pointer"
            >Delete</button
          >
        </div>
      </div>
    </div>

    <script is:inline>
      let editor;
      function getCsrfToken() {
        const m = document.cookie.match(/csrf_token=([^;]+)/);
        return m ? decodeURIComponent(m[1]) : '';
      }
      const defaultTemplates = [
        {
          key: 'unpaid',
          subject: 'Payment pending for your appointment – JyotirSetu',
          html: [
            '<p>Dear {name},</p>',
            '<p>Your payment status for <strong>{service}</strong> is currently <strong>{status}</strong>.</p>',
            '<p>Please complete the payment to confirm your booking.</p>',
            '<p><strong>Appointment ID:</strong> {appointment_id}</p>',
            '<p>For assistance, reply to this email or visit <a href="{follow_link}" target="_blank">follow.jyotirsetu.com</a>.</p>',
            '<p>Warm regards,<br/>JyotirSetu Astrology</p>',
          ].join(''),
        },
        {
          key: 'partial',
          subject: 'Partial payment received – JyotirSetu',
          html: [
            '<p>Dear {name},</p>',
            '<p>We have received a partial payment for <strong>{service}</strong>. Your current status is <strong>{status}</strong>.</p>',
            '<p>Kindly complete the remaining amount to finalize your booking.</p>',
            '<p><strong>Appointment ID:</strong> {appointment_id}</p>',
            '<p>Need help? Reply to this email or visit <a href="{follow_link}" target="_blank">follow.jyotirsetu.com</a>.</p>',
            '<p>Warm regards,<br/>JyotirSetu Astrology</p>',
          ].join(''),
        },
        {
          key: 'paid',
          subject: 'Payment received – Thank you!',
          html: [
            '<p>Dear {name},</p>',
            '<p>Thank you! Your payment for <strong>{service}</strong> is <strong>{status}</strong>.</p>',
            '<p>Your appointment remains scheduled as planned.</p>',
            '<p><strong>Appointment ID:</strong> {appointment_id}</p>',
            '<p>We look forward to guiding you. For any queries, reply to this email.</p>',
            '<p>Warm regards,<br/>JyotirSetu Astrology</p>',
          ].join(''),
        },
      ];

      document.addEventListener('DOMContentLoaded', function () {
        tinymce.baseURL = 'https://cdn.jsdelivr.net/npm/tinymce@6';
        tinymce.init({
          selector: '#htmlEditor',
          height: 400,
          menubar: false,
          plugins: 'lists link image table code fullscreen advlist',
          toolbar:
            'undo redo | bold italic underline | blocks fontfamily fontsize | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | link image table | code fullscreen',
          block_formats: 'Paragraph=p; Heading 1=h1; Heading 2=h2; Heading 3=h3',
          toolbar_mode: 'sliding',
          branding: false,
          convert_urls: false,
          setup: (ed) => {
            editor = ed;
            ed.on('change keyup', () => updatePreview());
          },
        });
      });


      function updatePreview() {
        const html = editor.getContent();
        const preview = document.getElementById('preview');
        preview.innerHTML = html.replace(/\{(\w+)\}/g, function (match, varName) {
          return (
            '<span style="background:#fef3c7;padding:2px 6px;border-radius:3px;font-weight:600">{\'' +
            varName +
            "'}</span>"
          );
        });
      }

      async function loadTemplates() {
        const res = await fetch('/api/admin/templates?type=email');
        const json = await res.json();
        const list = document.getElementById('templateList');
        const templates = json.data || [];
        list.innerHTML = templates.length
          ? templates
              .map(function (t) {
                return (
                  '<div class="template-card" data-key="' +
                  t.key +
                  '">' +
                  '<div style="font-weight:600;margin-bottom:4px">' +
                  t.key +
                  '</div>' +
                  '<div class="muted" style="font-size:12px;margin-bottom:4px">' +
                  t.subject +
                  '</div>' +
                  '<div class="muted" style="font-size:11px;margin-bottom:8px">Updated: ' +
                  new Date(t.updated_at).toLocaleDateString() +
                  '</div>' +
                  '<div style="display:flex;gap:8px">' +
                  '<button class="btn-sm" data-edit="' +
                  t.key +
                  '" style="background:#667eea;color:white;border:none;padding:4px 8px;border-radius:4px;cursor:pointer;font-size:11px;flex:1">Edit</button>' +
                  '<button class="btn-sm" data-del="' +
                  t.key +
                  '" style="background:#ef4444;color:white;border:none;padding:4px 8px;border-radius:4px;cursor:pointer;font-size:11px">Delete</button>' +
                  '</div>' +
                  '</div>'
                );
              })
              .join('')
          : '<p class="muted">No templates saved yet</p>';
        list.querySelectorAll('[data-edit]').forEach((b) => {
          b.addEventListener('click', async () => {
            const key = b.getAttribute('data-edit');
            const t = templates.find((x) => x.key === key);
            if (t) {
              document.getElementById('key').value = t.key;
              document.getElementById('subject').value = t.subject;
              editor.setContent(t.html || '');
              updatePreview();
            }
          });
        });
        list.querySelectorAll('[data-del]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const key = btn.getAttribute('data-del');
            const t = templates.find((x) => x.key === key) || { key, subject: '' };
            openDeleteConfirm(t.key, t.subject);
          });
        });
      }

      async function saveTemplate(key, subject, html) {
        if (!key || !subject) {
          window.AdminNotify?.error('Missing fields', 'Key and Subject are required');
          return false;
        }
        const res = await fetch('/api/admin/templates', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': getCsrfToken() },
          body: JSON.stringify({ type: 'email', key, subject, html: html || editor.getContent() }),
        });
        const json = await res.json();
        if (json.ok) {
          window.AdminNotify?.success('Email template saved', 'Key: ' + key);
          loadTemplates();
          return true;
        } else {
          window.AdminNotify?.error('Save failed', json.error || 'Unknown error');
          return false;
        }
      }

      function renderQuickTemplates() {
        const container = document.getElementById('quickTemplates');
        container.innerHTML = defaultTemplates
          .map(function (t) {
            return (
              '<div class="template-card" data-key="' +
              t.key +
              '">' +
              '<div style="font-weight:600;margin-bottom:4px">' +
              t.key +
              '</div>' +
              '<div class="muted" style="font-size:12px;margin-bottom:8px">' +
              t.subject +
              '</div>' +
              '<div style="display:flex;gap:8px">' +
              '<button class="btn-sm" data-use="' +
              t.key +
              '" style="background:#667eea;color:white;border:none;padding:6px 10px;border-radius:4px;cursor:pointer">Use</button>' +
              '<button class="btn-sm" data-save="' +
              t.key +
              '" style="background:#22c55e;color:white;border:none;padding:6px 10px;border-radius:4px;cursor:pointer">Save</button>' +
              '</div>' +
              '</div>'
            );
          })
          .join('');
        container.querySelectorAll('[data-use]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const key = btn.getAttribute('data-use');
            const t = defaultTemplates.find((x) => x.key === key);
            if (t) {
              document.getElementById('key').value = t.key;
              document.getElementById('subject').value = t.subject;
              editor.setContent(t.html || '');
              updatePreview();
              window.AdminNotify?.info('Loaded template into editor', 'Key: ' + t.key);
            }
          });
        });
        container.querySelectorAll('[data-save]').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const key = btn.getAttribute('data-save');
            const t = defaultTemplates.find((x) => x.key === key);
            if (t) await saveTemplate(t.key, t.subject, t.html);
          });
        });
      }

      document.getElementById('saveBtn').addEventListener('click', async () => {
        const key = document.getElementById('key').value.trim();
        const subject = document.getElementById('subject').value.trim();
        await saveTemplate(key, subject);
      });
      document.getElementById('deleteBtn').addEventListener('click', () => {
        const key = document.getElementById('key').value.trim();
        const subject = document.getElementById('subject').value.trim();
        if (!key) {
          window.AdminNotify?.error('Missing key', 'Enter template key to delete');
          return;
        }
        openDeleteConfirm(key, subject);
      });
      document.getElementById('previewBtn').addEventListener('click', () => {
        updatePreview();
      });
      document.getElementById('exportBtn').addEventListener('click', async () => {
        const res = await fetch('/api/admin/templates?type=email');
        const json = await res.json();
        const dataStr = JSON.stringify(json.data || [], null, 2);
        const blob = new Blob([dataStr], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `payment-email-templates-${new Date().toISOString().split('T')[0]}.json`;
        a.click();
      });

      document.querySelectorAll('.variable-tag').forEach((tag) => {
        tag.addEventListener('click', () => {
          const varName = tag.getAttribute('data-var');
          editor.insertContent(varName);
        });
      });

      document.getElementById('seedDefaults').addEventListener('click', async () => {
        try {
          for (const t of defaultTemplates) {
            const res = await fetch('/api/admin/templates', {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json', 'x-csrf-token': getCsrfToken() },
              body: JSON.stringify({ type: 'email', key: t.key, subject: t.subject, html: t.html }),
            });
            const json = await res.json();
            if (!json.ok) throw new Error(json.error || 'failed');
          }
          window.AdminNotify?.success('Default payment templates saved');
          await loadTemplates();
        } catch (e) {
          window.AdminNotify?.error('Seeding failed', String(e?.message || e || 'Unknown error'));
        }
      });

      // Delete modal logic
      let deleteKey = '';
      function openDeleteConfirm(key, subject) {
        deleteKey = key || '';
        const body = document.getElementById('deleteConfirmBody');
        if (body)
          body.innerHTML = [
            '<div class="muted" style="color:#94a3b8">Template Key</div><div>' + (key || '') + '</div>',
            '<div class="muted" style="color:#94a3b8">Subject</div><div>' + (subject || '(no subject)') + '</div>',
            '<div class="muted" style="color:#ef4444">Warning</div><div>This will permanently delete the template from the database.</div>',
          ].join('');
        document.getElementById('deleteConfirmModal')?.classList.add('active');
      }
      function closeDeleteConfirm() {
        document.getElementById('deleteConfirmModal')?.classList.remove('active');
        deleteKey = '';
      }
      document.getElementById('deleteClose')?.addEventListener('click', closeDeleteConfirm);
      document.getElementById('deleteCancel')?.addEventListener('click', closeDeleteConfirm);
      document.getElementById('deleteConfirm')?.addEventListener('click', async () => {
        if (!deleteKey) return closeDeleteConfirm();
        try {
          const res = await fetch('/api/admin/templates', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json', 'x-csrf-token': getCsrfToken() },
            body: JSON.stringify({ type: 'email', key: deleteKey }),
          });
          const json = await res.json();
          if (json.ok) {
            window.AdminNotify?.success('Template deleted', deleteKey);
            const currentKey = document.getElementById('key').value.trim();
            if (currentKey === deleteKey) {
              document.getElementById('key').value = '';
              document.getElementById('subject').value = '';
              editor?.setContent('');
              updatePreview();
            }
            await loadTemplates();
            closeDeleteConfirm();
          } else {
            window.AdminNotify?.error('Delete failed', json.error || 'Unknown error');
          }
        } catch (e) {
          window.AdminNotify?.error('Delete failed', String(e?.message || e || 'Unknown error'));
        }
      });

      loadTemplates();
      renderQuickTemplates();


    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@latest/dist/js/adminlte.min.js" defer></script>
  </body>
</html>
