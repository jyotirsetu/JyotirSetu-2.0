<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Email Templates – Admin</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6/css/all.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@latest/dist/css/adminlte.min.css" />
<link rel="stylesheet" href="/admin.css?v=20251116" />
<Favicons />
    <script src="https://cdn.jsdelivr.net/npm/tinymce@6/tinymce.min.js"></script>
    <script src="/js/admin-notify.js" defer></script>
    <script>
      (function(){
        function defineFallback(){
          try{
            if(window.AdminNotify) return;
            window.AdminNotify = {
              success:function(msg, detail){ console.log('SUCCESS:', detail? (msg+': '+detail) : msg); },
              error:function(msg, detail){ console.error('ERROR:', detail? (msg+': '+detail) : msg); },
              info:function(msg, detail){ console.log('INFO:', detail? (msg+': '+detail) : msg); }
            };
          }catch(e){ console.error('AdminNotify fallback error:', e); }
        }
        function reinject(){
          try{
            const s = document.createElement('script');
            s.src = '/js/admin-notify.js?v=' + Date.now();
            s.defer = true;
            s.onload = function(){ if(!window.AdminNotify) defineFallback(); };
            s.onerror = function(){ defineFallback(); };
            document.head.appendChild(s);
          }catch(e){ console.error('AdminNotify reinject error:', e); defineFallback(); }
        }
        if(!window.AdminNotify){
          if(document.readyState==='loading'){ document.addEventListener('DOMContentLoaded', reinject); } else { reinject(); }
          setTimeout(function(){ if(!window.AdminNotify) defineFallback(); }, 1500);
        }
      })();
    </script>
    <style>
      .template-editor { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px; }
      .template-preview { background: white; border: 1px solid var(--border); border-radius: 8px; padding: 20px; }
      .variable-list { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0; }
      .variable-tag { background: #667eea; color: white; padding: 4px 12px; border-radius: 4px; font-size: 12px; cursor: pointer; }
      .template-actions { display: flex; gap: 8px; margin-top: 12px; }
      .template-card { border: 1px solid var(--border); border-radius: 8px; padding: 16px; background: var(--panel); }
      .template-card.active { border-color: var(--brand); background: var(--panel-2); }
      @media (max-width: 900px) {
        .template-editor { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body class="hold-transition sidebar-mini">
    <button class="sidebar-toggle" aria-label="Open Admin Menu" id="sidebarToggle">☰</button>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
    <script is:inline>
      (function(){
        function applyTheme(theme){ let t=theme; if(t==='auto'){ t=window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'; } document.body.classList.toggle('dark-mode', t==='dark'); }
        let theme='dark'; let collapsed=false; try{ const stored=localStorage.getItem('adminSettings'); if(stored){ const s=JSON.parse(stored); if(s&&typeof s==='object'){ if(s.theme) theme=s.theme; if(s.sidebarCollapsed!=null) collapsed=!!s.sidebarCollapsed; } } }catch(e){ console.error('Error loading admin settings:', e); }
        applyTheme(theme); document.body.classList.toggle('sidebar-collapse', collapsed);
        try{ Promise.all([
          fetch('/api/admin/preferences?key=theme').then(function(r){return r.json();}),
          fetch('/api/admin/preferences?key=sidebarCollapsed').then(function(r){return r.json();})
        ]).then(function(rs){ const tr=rs[0], sr=rs[1]; if(tr&&tr.ok&&typeof tr.value==='string') applyTheme(tr.value); if(sr&&sr.ok&&sr.value!=null) document.body.classList.toggle('sidebar-collapse', sr.value==='1'); }).catch(function(err){ console.error('Error syncing preferences:', err); }); }catch(e){ console.error('Error syncing preferences:', e); }
      })();
    </script>
