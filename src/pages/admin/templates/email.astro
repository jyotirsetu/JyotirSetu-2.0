---
export const prerender = false;
import Favicons from '~/components/Favicons.astro';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Email Templates – Admin</title>
<link rel="stylesheet" href="/admin.css?v=20251108" />
<Favicons />
    <script src="https://cdn.jsdelivr.net/npm/tinymce@6/tinymce.min.js"></script>
    <script src="/js/admin-notify.js" defer></script>
    <style>
      .template-editor { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px; }
      .template-preview { background: white; border: 1px solid var(--border); border-radius: 8px; padding: 20px; }
      .variable-list { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0; }
      .variable-tag { background: #667eea; color: white; padding: 4px 12px; border-radius: 4px; font-size: 12px; cursor: pointer; }
      .template-actions { display: flex; gap: 8px; margin-top: 12px; }
      .template-card { border: 1px solid var(--border); border-radius: 8px; padding: 16px; background: var(--panel); }
      .template-card.active { border-color: var(--brand); background: var(--panel-2); }
      @media (max-width: 900px) {
        .template-editor { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <button class="sidebar-toggle" aria-label="Open Admin Menu" id="sidebarToggle">☰</button>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
    <div class="layout">
      <aside class="sidebar" id="adminSidebar">
        <div class="logo"><span class="brand-dot"></span> <span>JyotirSetu Admin</span></div>
        <nav class="nav">
          <a href="/admin/dashboard">Dashboard</a>
          <a href="/admin/appointments">Appointments</a>
          <a href="/admin/contacts">Contacts</a>
          <a href="/admin/calendar">Calendar</a>
          <a href="/admin/activity-log">Activity Log</a>
          <a href="/admin/tools/follow-hub/insights">Follow Hub – Insights</a>
          <a class="active" href="/admin/templates/email">Email Templates</a>
          <a href="/admin/templates/whatsapp">WhatsApp Templates</a>
          <a href="/admin/settings">Settings</a>
        </nav>
      </aside>
      <section class="content">
        <div class="topbar">
          <strong>Email Templates</strong>
          <div style="display:flex; gap:8px; align-items:center">
            <button class="btn-sm" id="previewBtn" style="background:#667eea;color:white;border:none;padding:6px 12px;border-radius:6px;cursor:pointer">👁️ Preview</button>
            <button class="btn-sm" id="exportBtn" style="background:#22c55e;color:white;border:none;padding:6px 12px;border-radius:6px;cursor:pointer">📥 Export</button>
            <a href="/api/admin/logout" class="pill">Logout</a>
          </div>
        </div>
        <div style="padding: 20px;">
          <style>
            .modal { display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(2,6,23,0.6); z-index:1000; align-items:center; justify-content:center; }
            .modal.active { display:flex; }
            .modal-content { background:#0f172a; padding:24px; border-radius:12px; max-width:520px; width:90%; box-shadow:0 30px 80px rgba(15,23,42,0.8); border:1px solid rgba(148,163,184,0.25); }
            .modal-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; border-bottom:1px solid rgba(148,163,184,0.2); padding-bottom:10px; }
            .modal-header h3 { margin:0; font-size:18px; font-weight:700; color:#e2e8f0; }
            .close-btn { background:none; border:none; font-size:24px; cursor:pointer; padding:0; width:32px; height:32px; color:#94a3b8; line-height:1; }
            .confirm-row { display:grid; grid-template-columns:140px 1fr; gap:10px; color:#e5e7eb; }
          </style>
          <div class="cards" style="grid-template-columns: 1fr 1fr 1fr;">
            <div class="card">
              <label>Template Key *</label>
              <input class="input" id="key" placeholder="e.g. confirmed, pending, cancelled" />
              <div class="info-text" style="margin-top: 4px;">Used to identify the template</div>
            </div>
            <div class="card">
              <label>Email Subject *</label>
              <input class="input" id="subject" placeholder="Email subject line" />
            </div>
            <div class="card">
              <label>Actions</label>
              <div class="template-actions">
                <button class="btn" id="saveBtn" style="background:#667eea;color:white;border:none;padding:8px 16px;border-radius:6px;cursor:pointer;flex:1">💾 Save</button>
                <button class="btn-sm" id="deleteBtn" style="background:#ef4444;color:white;border:none;padding:8px 12px;border-radius:6px;cursor:pointer">🗑️ Delete</button>
              </div>
            </div>
          </div>

          <div class="template-editor">
            <div>
              <label style="display:block;margin-bottom:8px;font-weight:600">Email Content (HTML)</label>
              <div class="variable-list">
                <span class="variable-tag" data-var="&lbrace;name&rbrace;">&lbrace;name&rbrace;</span>
                <span class="variable-tag" data-var="&lbrace;service&rbrace;">&lbrace;service&rbrace;</span>
                <span class="variable-tag" data-var="&lbrace;date&rbrace;">&lbrace;date&rbrace;</span>
                <span class="variable-tag" data-var="&lbrace;time&rbrace;">&lbrace;time&rbrace;</span>
                <span class="variable-tag" data-var="&lbrace;method&rbrace;">&lbrace;method&rbrace;</span>
                <span class="variable-tag" data-var="&lbrace;status&rbrace;">&lbrace;status&rbrace;</span>
                <span class="variable-tag" data-var="&lbrace;appointment_id&rbrace;">&lbrace;appointment_id&rbrace;</span>
              </div>
              <textarea id="htmlEditor" style="min-height:400px;border:1px solid var(--border);border-radius:8px;background:white"></textarea>
            </div>
            <div>
              <label style="display:block;margin-bottom:8px;font-weight:600">Live Preview</label>
              <div class="template-preview" id="preview">
                <p class="muted">Preview will appear here</p>
              </div>
            </div>
          </div>

          <div class="card" style="margin-top:20px">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
              <strong>Quick Actions</strong>
              <button class="btn-sm" id="seedDefaults" style="background:#667eea;color:white;border:none;padding:6px 12px;border-radius:6px;cursor:pointer">📦 Load Default Set</button>
            </div>
            <div id="quickTemplates" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px"></div>
          </div>

          <div class="card" style="margin-top:20px">
            <strong>Existing Templates</strong>
            <div id="templateList" style="margin-top:12px;display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px"></div>
          </div>
        </div>
      </section>
    </div>

    <!-- Delete Confirm Modal -->
    <div class="modal" id="deleteConfirmModal">
      <div class="modal-content">
        <div class="modal-header">
          <h3>Delete Email Template</h3>
          <button class="close-btn" id="deleteClose">&times;</button>
        </div>
        <div id="deleteConfirmBody" class="confirm-row"></div>
        <div style="display:flex; gap:12px; justify-content:flex-end; margin-top:16px; padding-top:12px; border-top:1px solid rgba(148,163,184,0.2);">
          <button type="button" class="btn-sm" id="deleteCancel" style="background:#f3f4f6;color:#0f172a;border:1px solid #d1d5db;padding:8px 14px;border-radius:8px;cursor:pointer">Cancel</button>
          <button type="button" class="btn-sm" id="deleteConfirm" style="background:#ef4444;color:#ffffff;border:none;padding:8px 14px;border-radius:8px;cursor:pointer">Delete</button>
        </div>
      </div>
    </div>

    <script is:inline>
      let editor;
      // Default status-based templates to quickly load or seed into DB
      const defaultTemplates = [
        {
          key: 'pending',
          subject: 'We received your appointment request – JyotirSetu Astrology',
          html: [
            '<p>Dear {name},</p>',
            '<p>Thank you for choosing JyotirSetu Astrology. We have received your appointment request for <strong>{service}</strong>.</p>',
            '<p>Your appointment is currently <strong>pending</strong>. We will confirm your slot based on availability and inform you shortly.</p>',
            '<p>Appointment Details:</p>',
            '<ul>',
            '<li>Appointment ID: {appointment_id}</li>',
            '<li>Date: {date}</li>',
            '<li>Time: {time}</li>',
            '<li>Consultation Method: {method}</li>',
            '</ul>',
            '<p>Stay connected for insights and updates: <a href="https://follow.jyotirsetu.com" target="_blank">follow.jyotirsetu.com</a></p>',
            '<p>Warm regards,<br/>JyotirSetu Astrology</p>'
          ].join('')
        },
        {
          key: 'confirmed',
          subject: 'Your appointment is confirmed – JyotirSetu Astrology',
          html: [
            '<p>Dear {name},</p>',
            '<p>Your appointment for <strong>{service}</strong> is <strong>confirmed</strong> on <strong>{date}</strong> at <strong>{time}</strong> ({method}).</p>',
            '<p>To prepare and provide accurate guidance, please share your horoscope details in reply:</p>',
            '<ul>',
            '<li>Birth Date</li>',
            '<li>Birth Time</li>',
            '<li>Birth Place</li>',
            '<li>Gender</li>',
            '</ul>',
            '<p><strong>Appointment ID:</strong> {appointment_id}</p>',
            '<p>Feel free to include any specific questions you want us to focus on.</p>',
            '<p>Follow for tips and updates: <a href="https://follow.jyotirsetu.com" target="_blank">follow.jyotirsetu.com</a></p>',
            '<p>Looking forward to connecting,<br/>JyotirSetu Astrology</p>'
          ].join('')
        },
        {
          key: 'rescheduled',
          subject: 'Your appointment has been rescheduled – JyotirSetu Astrology',
          html: [
            '<p>Dear {name},</p>',
            '<p>Your appointment for <strong>{service}</strong> has been <strong>rescheduled</strong>.</p>',
            '<p>Reason: {reason}</p>',
            '<p>New Appointment Details:</p>',
            '<ul>',
            '<li>Appointment ID: {appointment_id}</li>',
            '<li>Date: {new_date}</li>',
            '<li>Time: {new_time}</li>',
            '<li>Consultation Method: {method}</li>',
            '</ul>',
            '<p>If the new schedule does not work for you, please reply with your availability.</p>',
            '<p>Stay connected: <a href="https://follow.jyotirsetu.com" target="_blank">follow.jyotirsetu.com</a></p>',
            '<p>Warm regards,<br/>JyotirSetu Astrology</p>'
          ].join('')
        },
        {
          key: 'cancelled_user',
          subject: 'Your appointment has been cancelled as requested – JyotirSetu Astrology',
          html: [
            '<p>Dear {name},</p>',
            '<p>As per your request, your appointment for <strong>{service}</strong> has been <strong>cancelled</strong>.</p>',
            '<p><strong>Appointment ID:</strong> {appointment_id}</p>',
            '<p>We look forward to connecting with you again. Feel free to reply to this email to book a new slot at your convenience.</p>',
            '<p>Explore updates and insights: <a href="https://follow.jyotirsetu.com" target="_blank">follow.jyotirsetu.com</a></p>',
            '<p>Warm regards,<br/>JyotirSetu Astrology</p>'
          ].join('')
        },
        {
          key: 'cancelled_provider',
          subject: 'Apologies — your appointment was cancelled due to unforeseen reasons',
          html: [
            '<p>Dear {name},</p>',
            '<p>We sincerely apologize — your appointment for <strong>{service}</strong> has been <strong>cancelled</strong> due to unforeseen circumstances.</p>',
            '<p><strong>Appointment ID:</strong> {appointment_id}</p>',
            '<p>We value your time and will reach out shortly to offer alternate slots. If you prefer, please reply with your availability.</p>',
            '<p>Thank you for your understanding.</p>',
            '<p>Stay connected: <a href="https://follow.jyotirsetu.com" target="_blank">follow.jyotirsetu.com</a></p>',
            '<p>Warm regards,<br/>JyotirSetu Astrology</p>'
          ].join('')
        }
      ];


      document.addEventListener('DOMContentLoaded', function() {
        // Ensure TinyMCE loads its theme/plugins from CDN instead of relative paths
        // Fixes errors like: Failed to load theme from url themes/silver/theme.js
        // See https://www.tiny.cloud/docs/tinymce/6/general-configuration/#base_url
        tinymce.baseURL = 'https://cdn.jsdelivr.net/npm/tinymce@6';
        tinymce.init({
          selector: '#htmlEditor',
          height: 400,
          menubar: false,
          plugins: 'lists link image table code fullscreen advlist',
          toolbar: 'undo redo | bold italic underline | blocks fontfamily fontsize | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | link image table | code fullscreen',
          block_formats: 'Paragraph=p; Heading 1=h1; Heading 2=h2; Heading 3=h3',
          toolbar_mode: 'sliding',
          branding: false,
          convert_urls: false,
          setup: (ed) => {
            editor = ed;
            ed.on('change keyup', () => updatePreview());
          }
        });
      });

      function updatePreview() {
        const html = editor.getContent();
        const preview = document.getElementById('preview');
        preview.innerHTML = html.replace(/\{(\w+)\}/g, function(match, varName) {
          return '<span style="background:#fef3c7;padding:2px 6px;border-radius:3px;font-weight:600">{\'' + varName + '\'}</span>';
        });
      }



      async function loadTemplates() {
        const res = await fetch('/api/admin/templates?type=email');
        const json = await res.json();
        const list = document.getElementById('templateList');
        const templates = json.data || [];
        list.innerHTML = templates.length ? templates.map(function(t) {
          return '<div class="template-card" data-key="' + t.key + '">' +
            '<div style="font-weight:600;margin-bottom:4px">' + t.key + '</div>' +
            '<div class="muted" style="font-size:12px;margin-bottom:4px">' + t.subject + '</div>' +
            '<div class="muted" style="font-size:11px;margin-bottom:8px">Updated: ' + new Date(t.updated_at).toLocaleDateString() + '</div>' +
            '<div style="display:flex;gap:8px">' +
              '<button class="btn-sm" data-edit="' + t.key + '" style="background:#667eea;color:white;border:none;padding:4px 8px;border-radius:4px;cursor:pointer;font-size:11px;flex:1">Edit</button>' +
              '<button class="btn-sm" data-del="' + t.key + '" style="background:#ef4444;color:white;border:none;padding:4px 8px;border-radius:4px;cursor:pointer;font-size:11px">Delete</button>' +
            '</div>' +
            '</div>';
        }).join('') : '<p class="muted">No templates saved yet</p>';
        
        list.querySelectorAll('[data-edit]').forEach(b => {
          b.addEventListener('click', async () => {
            const key = b.getAttribute('data-edit');
            const t = templates.find(x => x.key === key);
            if (t) {
              document.getElementById('key').value = t.key;
              document.getElementById('subject').value = t.subject;
              editor.setContent(t.html || '');
              updatePreview();
            }
          });
        });

        // Per-card delete opens modal
        list.querySelectorAll('[data-del]').forEach(btn => {
          btn.addEventListener('click', () => {
            const key = btn.getAttribute('data-del');
            const t = templates.find(x => x.key === key) || { key, subject: '' };
            openDeleteConfirm(t.key, t.subject);
          });
        });
      }

      async function saveTemplate(key, subject, html) {
        if (!key || !subject) {
          window.AdminNotify?.error('Missing fields', 'Key and Subject are required');
          return false;
        }
        const res = await fetch('/api/admin/templates', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: 'email', key, subject, html: html || editor.getContent() })
        });
        const json = await res.json();
        if (json.ok) {
          window.AdminNotify?.success('Email template saved', `Key: ${key}`);
          loadTemplates();
          return true;
        } else {
          window.AdminNotify?.error('Save failed', (json.error || 'Unknown error'));
          return false;
        }
      }

      // Render Quick Templates section from defaults
      function renderQuickTemplates() {
        const container = document.getElementById('quickTemplates');
        container.innerHTML = defaultTemplates.map(function(t) {
          return '<div class="template-card" data-key="' + t.key + '">' +
            '<div style="font-weight:600;margin-bottom:4px">' + t.key + '</div>' +
            '<div class="muted" style="font-size:12px;margin-bottom:8px">' + t.subject + '</div>' +
            '<div style="display:flex;gap:8px">' +
              '<button class="btn-sm" data-use="' + t.key + '" style="background:#667eea;color:white;border:none;padding:6px 10px;border-radius:4px;cursor:pointer">Use</button>' +
              '<button class="btn-sm" data-save="' + t.key + '" style="background:#22c55e;color:white;border:none;padding:6px 10px;border-radius:4px;cursor:pointer">Save</button>' +
            '</div>' +
          '</div>';
        }).join('');

        container.querySelectorAll('[data-use]').forEach(btn => {
          btn.addEventListener('click', () => {
            const key = btn.getAttribute('data-use');
            const t = defaultTemplates.find(x => x.key === key);
            if (t) {
              document.getElementById('key').value = t.key;
              document.getElementById('subject').value = t.subject;
              editor.setContent(t.html || '');
              updatePreview();
              window.AdminNotify?.info('Loaded template into editor', `Key: ${t.key}`);
            }
          });
        });

        container.querySelectorAll('[data-save]').forEach(btn => {
          btn.addEventListener('click', async () => {
            const key = btn.getAttribute('data-save');
            const t = defaultTemplates.find(x => x.key === key);
            if (t) await saveTemplate(t.key, t.subject, t.html);
          });
        });
      }

      document.getElementById('saveBtn').addEventListener('click', async () => {
        const key = document.getElementById('key').value.trim();
        const subject = document.getElementById('subject').value.trim();
        await saveTemplate(key, subject);
      });

      // Top delete button opens modal
      document.getElementById('deleteBtn').addEventListener('click', () => {
        const key = document.getElementById('key').value.trim();
        const subject = document.getElementById('subject').value.trim();
        if (!key) {
          window.AdminNotify?.error('Missing key', 'Enter template key to delete');
          return;
        }
        openDeleteConfirm(key, subject);
      });

      document.getElementById('previewBtn').addEventListener('click', () => {
        updatePreview();
      });

      document.getElementById('exportBtn').addEventListener('click', async () => {
        const res = await fetch('/api/admin/templates?type=email');
        const json = await res.json();
        const dataStr = JSON.stringify(json.data || [], null, 2);
        const blob = new Blob([dataStr], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `email-templates-${new Date().toISOString().split('T')[0]}.json`;
        a.click();
      });



      document.querySelectorAll('.variable-tag').forEach(tag => {
        tag.addEventListener('click', () => {
          const varName = tag.getAttribute('data-var');
          editor.insertContent(varName);
        });
      });


      // Seed defaults into DB in one click
      document.getElementById('seedDefaults').addEventListener('click', async () => {
        try {
          for (const t of defaultTemplates) {
            const res = await fetch('/api/admin/templates', {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ type: 'email', key: t.key, subject: t.subject, html: t.html })
            });
            const json = await res.json();
            if (!json.ok) throw new Error(json.error || 'failed');
          }
          window.AdminNotify?.success('Default email templates saved');
          await loadTemplates();
        } catch (e) {
          window.AdminNotify?.error('Seeding failed', String(e?.message || e || 'Unknown error'));
        }
      });

      loadTemplates();
      renderQuickTemplates();

      // Mobile drawer
      const sidebar = document.getElementById('adminSidebar');
      const backdrop = document.getElementById('sidebarBackdrop');
      const toggleBtn = document.getElementById('sidebarToggle');
      let isOpen = false;
      
      function openSidebar() {
        sidebar?.classList.add('active');
        backdrop?.classList.add('active');
        toggleBtn?.classList.add('active');
        toggleBtn.innerHTML = '✕';
        isOpen = true;
      }
      
      function closeSidebar() {
        sidebar?.classList.remove('active');
        backdrop?.classList.remove('active');
        toggleBtn?.classList.remove('active');
        toggleBtn.innerHTML = '☰';
        isOpen = false;
      }
      
      toggleBtn?.addEventListener('click', () => {
        if (isOpen) closeSidebar();
        else openSidebar();
      });

      // Delete modal logic
      let deleteKey = '';
      function openDeleteConfirm(key, subject) {
        deleteKey = key || '';
        const body = document.getElementById('deleteConfirmBody');
        if (body) body.innerHTML = [
          '<div class="muted" style="color:#94a3b8">Template Key</div><div>' + (key || '') + '</div>',
          '<div class="muted" style="color:#94a3b8">Subject</div><div>' + (subject || '(no subject)') + '</div>',
          '<div class="muted" style="color:#ef4444">Warning</div><div>This will permanently delete the template from the database.</div>'
        ].join('');
        document.getElementById('deleteConfirmModal')?.classList.add('active');
      }
      function closeDeleteConfirm() {
        document.getElementById('deleteConfirmModal')?.classList.remove('active');
        deleteKey = '';
      }
      document.getElementById('deleteClose')?.addEventListener('click', closeDeleteConfirm);
      document.getElementById('deleteCancel')?.addEventListener('click', closeDeleteConfirm);
      document.getElementById('deleteConfirm')?.addEventListener('click', async () => {
        if (!deleteKey) return closeDeleteConfirm();
        try {
          const res = await fetch('/api/admin/templates', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ type: 'email', key: deleteKey })
          });
          const json = await res.json();
          if (json.ok) {
            window.AdminNotify?.success('Template deleted', deleteKey);
            // Clear form if the deleted key is currently loaded
            const currentKey = document.getElementById('key').value.trim();
            if (currentKey === deleteKey) {
              document.getElementById('key').value = '';
              document.getElementById('subject').value = '';
              editor?.setContent('');
              updatePreview();
            }
            await loadTemplates();
            closeDeleteConfirm();
          } else {
            window.AdminNotify?.error('Delete failed', json.error || 'Unknown error');
          }
        } catch (e) {
          window.AdminNotify?.error('Delete failed', String(e?.message || e || 'Unknown error'));
        }
      });
      
      backdrop?.addEventListener('click', closeSidebar);
      sidebar?.querySelectorAll('a').forEach(a => {
        a.addEventListener('click', () => {
          if (window.innerWidth <= 900) closeSidebar();
        });
      });
      
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isOpen) closeSidebar();
      });
    </script>
  </body>
</html>
