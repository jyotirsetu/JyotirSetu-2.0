---
export const prerender = false;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Email Templates – Admin</title>
<link rel="stylesheet" href="/admin.css?v=20251108" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <script src="https://cdn.jsdelivr.net/npm/tinymce@6/tinymce.min.js"></script>
    <style>
      .template-editor { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px; }
      .template-preview { background: white; border: 1px solid var(--border); border-radius: 8px; padding: 20px; }
      .variable-list { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0; }
      .variable-tag { background: #667eea; color: white; padding: 4px 12px; border-radius: 4px; font-size: 12px; cursor: pointer; }
      .template-actions { display: flex; gap: 8px; margin-top: 12px; }
      .template-card { border: 1px solid var(--border); border-radius: 8px; padding: 16px; background: var(--panel); }
      .template-card.active { border-color: var(--brand); background: var(--panel-2); }
      @media (max-width: 900px) {
        .template-editor { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <button class="sidebar-toggle" aria-label="Open Admin Menu" id="sidebarToggle">☰</button>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
    <div class="layout">
      <aside class="sidebar" id="adminSidebar">
        <div class="logo"><span class="brand-dot"></span> <span>JyotirSetu Admin</span></div>
        <nav class="nav">
          <a href="/admin/dashboard">Dashboard</a>
          <a href="/admin/appointments">Appointments</a>
          <a href="/admin/contacts">Contacts</a>
          <a href="/admin/calendar">Calendar</a>
          <a href="/admin/activity-log">Activity Log</a>
          <a class="active" href="/admin/templates/email">Email Templates</a>
          <a href="/admin/templates/whatsapp">WhatsApp Templates</a>
          <a href="/admin/settings">Settings</a>
        </nav>
      </aside>
      <section class="content">
        <div class="topbar">
          <strong>Email Templates</strong>
          <div style="display:flex; gap:8px; align-items:center">
            <button class="btn-sm" id="previewBtn" style="background:#667eea;color:white;border:none;padding:6px 12px;border-radius:6px;cursor:pointer">👁️ Preview</button>
            <button class="btn-sm" id="exportBtn" style="background:#22c55e;color:white;border:none;padding:6px 12px;border-radius:6px;cursor:pointer">📥 Export</button>
            <a href="/api/admin/logout" class="pill">Logout</a>
          </div>
        </div>
        <div style="padding: 20px;">
          <div class="cards" style="grid-template-columns: 1fr 1fr 1fr;">
            <div class="card">
              <label>Template Key *</label>
              <input class="input" id="key" placeholder="e.g. confirmed, pending, cancelled" />
              <div class="info-text" style="margin-top: 4px;">Used to identify the template</div>
            </div>
            <div class="card">
              <label>Email Subject *</label>
              <input class="input" id="subject" placeholder="Email subject line" />
            </div>
            <div class="card">
              <label>Actions</label>
              <div class="template-actions">
                <button class="btn" id="saveBtn" style="background:#667eea;color:white;border:none;padding:8px 16px;border-radius:6px;cursor:pointer;flex:1">💾 Save</button>
                <button class="btn-sm" id="deleteBtn" style="background:#ef4444;color:white;border:none;padding:8px 12px;border-radius:6px;cursor:pointer">🗑️ Delete</button>
              </div>
            </div>
          </div>

          <div class="template-editor">
            <div>
              <label style="display:block;margin-bottom:8px;font-weight:600">Email Content (HTML)</label>
              <div class="variable-list">
                <span class="variable-tag" data-var="&lbrace;name&rbrace;">&lbrace;name&rbrace;</span>
                <span class="variable-tag" data-var="&lbrace;service&rbrace;">&lbrace;service&rbrace;</span>
                <span class="variable-tag" data-var="&lbrace;date&rbrace;">&lbrace;date&rbrace;</span>
                <span class="variable-tag" data-var="&lbrace;time&rbrace;">&lbrace;time&rbrace;</span>
                <span class="variable-tag" data-var="&lbrace;method&rbrace;">&lbrace;method&rbrace;</span>
                <span class="variable-tag" data-var="&lbrace;status&rbrace;">&lbrace;status&rbrace;</span>
              </div>
              <div id="htmlEditor" style="min-height:400px;border:1px solid var(--border);border-radius:8px;background:white"></div>
            </div>
            <div>
              <label style="display:block;margin-bottom:8px;font-weight:600">Live Preview</label>
              <div class="template-preview" id="preview">
                <p class="muted">Preview will appear here</p>
              </div>
            </div>
          </div>

          <div class="card" style="margin-top:20px">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
              <strong>Quick Actions</strong>
              <button class="btn-sm" id="seedDefaults" style="background:#667eea;color:white;border:none;padding:6px 12px;border-radius:6px;cursor:pointer">📦 Load Default Set</button>
            </div>
            <div id="quickTemplates" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px"></div>
          </div>

          <div class="card" style="margin-top:20px">
            <strong>Existing Templates</strong>
            <div id="templateList" style="margin-top:12px;display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px"></div>
          </div>
        </div>
      </section>
    </div>

    <script is:inline>
      let editor;


      document.addEventListener('DOMContentLoaded', function() {
        tinymce.init({
          selector: '#htmlEditor',
          height: 400,
          menubar: false,
          plugins: 'lists link image table code fullscreen advlist',
          toolbar: 'undo redo | bold italic underline | blocks fontfamily fontsize | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | link image table | code fullscreen',
          block_formats: 'Paragraph=p; Heading 1=h1; Heading 2=h2; Heading 3=h3',
          toolbar_mode: 'sliding',
          branding: false,
          convert_urls: false,
          setup: (ed) => {
            editor = ed;
            ed.on('change keyup', () => updatePreview());
          }
        });
      });

      function updatePreview() {
        const html = editor.getContent();
        const preview = document.getElementById('preview');
        preview.innerHTML = html.replace(/\{(\w+)\}/g, function(match, varName) {
          return '<span style="background:#fef3c7;padding:2px 6px;border-radius:3px;font-weight:600">{\'' + varName + '\'}</span>';
        });
      }



      async function loadTemplates() {
        const res = await fetch('/api/admin/templates?type=email');
        const json = await res.json();
        const list = document.getElementById('templateList');
        const templates = json.data || [];
        list.innerHTML = templates.length ? templates.map(function(t) {
          return '<div class="template-card" data-key="' + t.key + '">' +
            '<div style="font-weight:600;margin-bottom:4px">' + t.key + '</div>' +
            '<div class="muted" style="font-size:12px;margin-bottom:4px">' + t.subject + '</div>' +
            '<div class="muted" style="font-size:11px;margin-bottom:8px">Updated: ' + new Date(t.updated_at).toLocaleDateString() + '</div>' +
            '<button class="btn-sm" data-edit="' + t.key + '" style="background:#667eea;color:white;border:none;padding:4px 8px;border-radius:4px;cursor:pointer;font-size:11px;width:100%">Edit</button>' +
            '</div>';
        }).join('') : '<p class="muted">No templates saved yet</p>';
        
        list.querySelectorAll('[data-edit]').forEach(b => {
          b.addEventListener('click', async () => {
            const key = b.getAttribute('data-edit');
            const t = templates.find(x => x.key === key);
            if (t) {
              document.getElementById('key').value = t.key;
              document.getElementById('subject').value = t.subject;
              editor.setContent(t.html || '');
              updatePreview();
            }
          });
        });
      }

      async function saveTemplate(key, subject, html) {
        if (!key || !subject) {
          alert('Key and Subject are required');
          return false;
        }
        const res = await fetch('/api/admin/templates', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: 'email', key, subject, html: html || editor.getContent() })
        });
        const json = await res.json();
        if (json.ok) {
          alert('Template saved!');
          loadTemplates();
          return true;
        } else {
          alert('Failed to save: ' + (json.error || 'Unknown error'));
          return false;
        }
      }

      document.getElementById('saveBtn').addEventListener('click', async () => {
        const key = document.getElementById('key').value.trim();
        const subject = document.getElementById('subject').value.trim();
        await saveTemplate(key, subject);
      });

      document.getElementById('deleteBtn').addEventListener('click', async () => {
        const key = document.getElementById('key').value.trim();
        if (!key || !confirm(`Delete template "${key}"?`)) return;
        // Note: Delete endpoint would need to be added to API
        alert('Delete functionality coming soon');
      });

      document.getElementById('previewBtn').addEventListener('click', () => {
        updatePreview();
      });

      document.getElementById('exportBtn').addEventListener('click', async () => {
        const res = await fetch('/api/admin/templates?type=email');
        const json = await res.json();
        const dataStr = JSON.stringify(json.data || [], null, 2);
        const blob = new Blob([dataStr], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `email-templates-${new Date().toISOString().split('T')[0]}.json`;
        a.click();
      });



      document.querySelectorAll('.variable-tag').forEach(tag => {
        tag.addEventListener('click', () => {
          const varName = tag.getAttribute('data-var');
          editor.insertContent(varName);
        });
      });


      loadTemplates();

      // Mobile drawer
      const sidebar = document.getElementById('adminSidebar');
      const backdrop = document.getElementById('sidebarBackdrop');
      const toggleBtn = document.getElementById('sidebarToggle');
      let isOpen = false;
      
      function openSidebar() {
        sidebar?.classList.add('active');
        backdrop?.classList.add('active');
        toggleBtn?.classList.add('active');
        toggleBtn.innerHTML = '✕';
        isOpen = true;
      }
      
      function closeSidebar() {
        sidebar?.classList.remove('active');
        backdrop?.classList.remove('active');
        toggleBtn?.classList.remove('active');
        toggleBtn.innerHTML = '☰';
        isOpen = false;
      }
      
      toggleBtn?.addEventListener('click', () => {
        if (isOpen) closeSidebar();
        else openSidebar();
      });
      
      backdrop?.addEventListener('click', closeSidebar);
      sidebar?.querySelectorAll('a').forEach(a => {
        a.addEventListener('click', () => {
          if (window.innerWidth <= 900) closeSidebar();
        });
      });
      
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isOpen) closeSidebar();
      });
    </script>
  </body>
</html>
