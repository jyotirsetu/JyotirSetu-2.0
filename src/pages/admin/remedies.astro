             showToast('Error inserting smart content: ' + e.message, 'error');
         }
      };

      // 1. Initialize Professional Editor
      const startEditor = () => {
        if (typeof tinymce === 'undefined') {
          console.log('TinyMCE not loaded yet, retrying...');
          setTimeout(startEditor, 100);
          return;
        }

        tinymce.init({
          base_url: 'https://cdnjs.cloudflare.com/ajax/libs/tinymce/6.8.2',
          suffix: '.min',
          selector: '#mainEditor',
          height: 600, // Occupy most of the page
          menubar: false,
          skin: 'oxide',
          content_css: 'default',
          plugins: 'lists link image table code charmap emoticons hr pagebreak',
          toolbar: 'undo redo | styleselect | fontfamily fontsize | bold italic underline | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | table hr | image | removeformat',
          // Image Upload Handler
          images_upload_handler: (blobInfo, progress) => new Promise((resolve, reject) => {
            const xhr = new XMLHttpRequest();
            xhr.withCredentials = false;
            xhr.open('POST', '/api/upload-image');
            
            xhr.upload.onprogress = (e) => {
              progress(e.loaded / e.total * 100);
            };
            
            xhr.onload = () => {
              if (xhr.status === 403) {
                reject({ message: 'HTTP Error: ' + xhr.status, remove: true });
                return;
              }
              if (xhr.status < 200 || xhr.status >= 300) {
                reject('HTTP Error: ' + xhr.status);
                return;
              }
              const json = JSON.parse(xhr.responseText);
              if (!json || typeof json.location != 'string') {
                reject('Invalid JSON: ' + xhr.responseText);
                return;
              }
              resolve(json.location);
            };
            
            xhr.onerror = () => {
              reject('Image upload failed due to a XHR Transport error. Code: ' + xhr.status);
            };
            
            const formData = new FormData();
            formData.append('file', blobInfo.blob(), blobInfo.filename());
            
            xhr.send(formData);
          }),
          content_style: `
            body { font-family: 'Lato', sans-serif; font-size: 11pt; line-height: 1.6; color: #1e293b !important; background-color: #ffffff !important; margin: 20px; }
            h1, h2, h3 { font-family: 'Merriweather', serif; color: #1e293b !important; margin-top: 1em; }
            ul { margin-bottom: 1em; }
            table { border-collapse: collapse; width: 100%; margin: 15px 0; }
            td, th { padding: 10px; border: 1px solid #e2e8f0; }
            th { background-color: #f8fafc; font-weight: 600; color: #475569; }
          `,
        setup: (editor) => {
          editor.on('init', () => {
             console.log('Editor Initialized');
             
             // Load draft if exists (only if not loading a saved remedy or appointment)
             const urlParams = new URLSearchParams(window.location.search);
             const apptId = urlParams.get('appointment_id') || urlParams.get('appt_id');

             if(!urlParams.get('id') && !apptId) {
                 const saved = localStorage.getItem('remedyDraft_v2');
                 if(saved) {
                   try {
                     const d = JSON.parse(saved);
                     if(Date.now() - d.time < 3600000) {
                        editor.setContent(d.content);
                        if(d.meta) populateMeta(d.meta);
                        showToast('Restored draft from local storage', 'info');
                     }
                   } catch { /* ignore */ }
                 }
             }

             // Load Appointment Details if provided
             if(apptId && !urlParams.get('id')) {
                fetch('/api/admin/appointments?id=' + apptId)
                  .then(r => r.json())
                  .then(d => {
                     if(d.data && d.data.length > 0) {
                        const appt = d.data[0];
                        // Try to parse service_details if it's a string, though API should parse it
                        let details = appt.service_details || {};
                        if(typeof details === 'string') {
                            try { details = JSON.parse(details); } catch { /* ignore */ }
                        }

                        const meta = {
                           customer_name: appt.name,
                           customer_email: appt.email || '',
                           customer_phone: appt.phone || '',
                           appointment_id: appt.id,
                           customer_appointment_id: appt.customer_appointment_id,
                           dob: details.dob || '',
                           tob: details.tob || '',
                           pob: details.pob || '',
                           rasi: details.rasi || '',
                           nakshatra: details.nakshatra || '',
                           lagna: details.lagna || ''
                        };
                        populateMeta(meta);
                        showToast('Loaded appointment details', 'success');
                     }
                  })
                  .catch(e => console.error('Failed to load appointment', e));
             }
          });
          editor.on('keyup change', () => {
             // Auto-save logic
             const content = editor.getContent();
             const meta = getFormData();
             localStorage.setItem('remedyDraft_v2', JSON.stringify({
               content, meta, time: Date.now()
             }));
             document.getElementById('statusMsg').innerHTML = '<i class="fas fa-check text-success"></i> Draft saved locally';
          });
        }
      });
      };
      
      // Start initialization
      if (document.readyState === 'complete') {
        startEditor();
      } else {
        window.addEventListener('load', startEditor);
      }

      // 2. Client Management
      const form = document.getElementById('metaForm');
      const clientBox = document.getElementById('clientInfoBox');
      
      function getFormData() {
        const fd = new FormData(form);
        return Object.fromEntries(fd.entries());
      }

      function populateMeta(data) {
        if(data.customer_name) {
          form.customer_name.value = data.customer_name;
          document.getElementById('displayClientName').textContent = data.customer_name;
          clientBox.style.display = 'block';
        }
        
        // Handle Appointment ID (Friendly vs UUID)
        const apptId = data.appointment_id || '';
        const friendlyId = data.customer_appointment_id || data.appointment_id_display || apptId;
        
        if(apptId) {
          form.appointment_id.value = apptId;
          if(form.appointment_id_display) form.appointment_id_display.value = friendlyId;
          document.querySelector('#displayApptId span').textContent = friendlyId;
        }

        if(data.customer_email) {
          form.customer_email.value = data.customer_email;
          document.getElementById('displayClientEmail').textContent = data.customer_email; 
        }
        if(data.customer_phone) {
          form.customer_phone.value = data.customer_phone;
          document.getElementById('displayClientPhone').textContent = data.customer_phone;
        }

        if(data.heading) {
          form.heading.value = data.heading;
          document.getElementById('displayTitle').textContent = data.heading;
        }
        if(data.remedy_id) {
           form.remedy_id.value = data.remedy_id;
        }

        // Horoscope Details
        if(form.dob) form.dob.value = data.dob || '';
        if(form.tob) form.tob.value = data.tob || '';
        if(form.pob) form.pob.value = data.pob || '';
        if(form.rasi) form.rasi.value = data.rasi || '';
        if(form.nakshatra) form.nakshatra.value = data.nakshatra || '';
        if(form.lagna) form.lagna.value = data.lagna || '';
        
        updateHoroscopeDisplay();
      }

      function updateHoroscopeDisplay() {
         const fields = ['dob', 'tob', 'pob', 'rasi', 'nakshatra', 'lagna'];
         let hasData = false;
         
         fields.forEach(f => {
             const val = form[f]?.value;
             const el = document.getElementById('disp_' + f);
             const wrap = document.getElementById('disp_' + f + '_wrapper');
             if(el && wrap) {
                 el.textContent = val || '';
                 wrap.style.display = val ? 'block' : 'none';
                 if(val) hasData = true;
             }
         });
         
         const container = document.getElementById('displayHoroscope');
         if(container) container.style.display = hasData ? 'block' : 'none';
      }

      // Live update of display fields
      form.customer_name.addEventListener('input', (e) => {
        document.getElementById('displayClientName').textContent = e.target.value;
        clientBox.style.display = e.target.value ? 'block' : 'none';
      });
      form.customer_phone.addEventListener('input', (e) => {
        document.getElementById('displayClientPhone').textContent = e.target.value;
      });
      form.customer_email.addEventListener('input', (e) => {
        document.getElementById('displayClientEmail').textContent = e.target.value;
      });
      
      // Horoscope inputs
      ['dob', 'tob', 'pob', 'rasi', 'nakshatra', 'lagna'].forEach(f => {
          if(form[f]) {
              form[f].addEventListener('input', updateHoroscopeDisplay);
          }
      });

      form.heading.addEventListener('input', (e) => {
        document.getElementById('displayTitle').textContent = e.target.value;
      });

      // 3. Search & Sync Logic
      let customers = [];
      const searchInp = document.getElementById('clientSearch');
      const drop = document.getElementById('clientDropdown');

      // Helper to parse details
      function parseServiceDetails(str) {
        if(!str) return {};
        if(typeof str === 'object') return str;
        try { return JSON.parse(str); } catch { return {}; }
      }

      // Auto-load clients on start
      (async function initClients() {
        try {
           const r = await fetch('/api/admin/appointments?page=1&limit=200');
           if(r.ok) {
             const d = await r.json();
             if(d.data && Array.isArray(d.data)) {
               customers = d.data.map(x => {
                 const details = parseServiceDetails(x.service_details);
                 return {
                   id: x.id,
                   name: x.name || 'Unknown',
                   email: x.email || '',
                   phone: x.phone || '',
                   customer_appointment_id: x.customer_appointment_id,
                   dob: details.dob || '',
                   tob: details.tob || '',
                   pob: details.pob || '',
                   rasi: details.rasi || '',
                   nakshatra: details.nakshatra || '',
                   lagna: details.lagna || ''
                 };
               });
             }
           }
        } catch(e) { console.error('Auto-sync failed', e); }
      })();

      document.getElementById('syncBtn').addEventListener('click', async () => {
        const btn = document.getElementById('syncBtn');
        const origIcon = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
        try {
          // Fetch logic
          let page = 1;
          let all = [];
          while(page <= 5) { // Quick sync top 500
             const r = await fetch(`/api/admin/appointments?page=${page}&limit=100`);
             const d = await r.json();
             if(!d.data || d.data.length === 0) break;
             all = [...all, ...d.data];
             page++;
          }
          // Dedupe
          const seen = new Set();
          customers = [];
          all.forEach(x => {
            const k = (x.name + (x.email||'')).toLowerCase();
            if(!seen.has(k) && x.name) {
              seen.add(k);
              const details = parseServiceDetails(x.service_details);
              customers.push({
                id: x.id,
                name: x.name,
                email: x.email || '',
                phone: x.phone || '',
                customer_appointment_id: x.customer_appointment_id,
                dob: details.dob || '',
                tob: details.tob || '',
                pob: details.pob || '',
                rasi: details.rasi || '',
                nakshatra: details.nakshatra || '',
                lagna: details.lagna || ''
              });
            }
          });
          showToast(`Synced ${customers.length} clients`, 'success');
        } catch(e) { console.error(e); showToast('Sync failed', 'error'); }
        btn.innerHTML = origIcon;
      });

      // Debounced Search
      let searchTimeout;
      searchInp.addEventListener('input', (e) => {
        clearTimeout(searchTimeout);
        const v = e.target.value.toLowerCase().trim();
        if(!v) { drop.style.display = 'none'; return; }

        searchTimeout = setTimeout(async () => {
           // 1. Local Search
           let res = customers.filter(c => c.name.toLowerCase().includes(v) || (c.email && c.email.toLowerCase().includes(v))).slice(0, 10);
           
           // 2. If no local results, try server search
           if(res.length === 0) {
             try {
               const r = await fetch(`/api/admin/appointments?q=${encodeURIComponent(v)}&limit=5`);
               if(r.ok) {
                 const d = await r.json();
                 if(d.data) {
                   res = d.data.map(x => {
                     const details = parseServiceDetails(x.service_details);
                     return {
                       id: x.id,
                       name: x.name,
                       email: x.email,
                       phone: x.phone,
                       customer_appointment_id: x.customer_appointment_id,
                       dob: details.dob || '',
                       tob: details.tob || '',
                       pob: details.pob || '',
                       rasi: details.rasi || '',
                       nakshatra: details.nakshatra || '',
                       lagna: details.lagna || ''
                     };
                   });
                 }
               }
            } catch { /* ignore */ }
          }

          drop.innerHTML = '';
           if(res.length) {
            drop.style.display = 'block';
            res.forEach(c => {
              const a = document.createElement('a');
              a.className = 'list-group-item list-group-item-action small';
              a.style.cursor = 'pointer';
              a.innerHTML = `<strong>${c.name}</strong> <div class="text-muted" style="font-size:10px">${c.email || ''}</div>`;
              a.onclick = (evt) => {
                evt.preventDefault();
                evt.stopPropagation();
                populateMeta({
                  customer_name: c.name,
                  customer_email: c.email || '',
                  customer_phone: c.phone || '',
                  appointment_id: c.id,
                  customer_appointment_id: c.customer_appointment_id,
                  dob: c.dob,
                  tob: c.tob,
                  pob: c.pob,
                  rasi: c.rasi,
                  nakshatra: c.nakshatra,
                  lagna: c.lagna
                });
                drop.style.display = 'none';
                searchInp.value = ''; // Clear search after selection
                showToast('Client selected', 'success');
              };
              drop.appendChild(a);
            });
           } else {
             drop.innerHTML = '<div class="list-group-item small text-muted">No results found</div>';
             drop.style.display = 'block';
           }
        }, 300);
      });
      
      // Close dropdown when clicking outside
      document.addEventListener('click', (e) => {
        if (!searchInp.contains(e.target) && !drop.contains(e.target)) {
          drop.style.display = 'none';
        }
      });

      // 4. Template Logic
      // Filter
      document.getElementById('templateFilter').addEventListener('input', (e) => {
        const val = e.target.value.toLowerCase();
        const items = document.querySelectorAll('.template-card');
        items.forEach(el => {
          const txt = el.innerText.toLowerCase();
          el.style.display = txt.includes(val) ? 'block' : 'none';
        });
      });

      window.insertTemplate = (id) => {
        const editor = tinymce.get('mainEditor');
        if (!editor) return;
        const content = document.getElementById('tpl-' + id).textContent;
        editor.insertContent(content);
        showToast('Template inserted', 'success');
      };

      // Modal Logic
      const tmplModal = document.getElementById('templateModal');
      window.saveAsTemplate = () => {
        document.getElementById('tmplId').value = '';
        document.getElementById('tmplTitle').value = '';
        document.getElementById('tmplCategory').value = 'General';
        document.getElementById('tmplModalTitle').innerText = 'Save New Template';
        tmplModal.style.display = 'flex';
      };

      window.editTemplate = (id, title, category) => {
         document.getElementById('tmplId').value = id;
         document.getElementById('tmplTitle').value = title;
         document.getElementById('tmplCategory').value = category;
         document.getElementById('tmplModalTitle').innerText = 'Edit Template';
         tmplModal.style.display = 'flex';
         
         // Also load content into editor if needed? 
         // For now we assume the user has loaded content, edited it, and now wants to save changes back to template
         // OR we can load the template content into editor now?
         // Let's Ask: usually edit template means load it, change it, save it.
         // But here we are clicking 'edit' on the card.
         // Let's load the content too so they can see what they are editing.
         const content = document.getElementById('tpl-' + id).textContent;
         const editor = tinymce.get('mainEditor');
         if(editor) editor.setContent(content);
         showToast('Template loaded for editing', 'info');
      };

      window.closeTemplateModal = () => {
        tmplModal.style.display = 'none';
      };

      window.submitTemplate = async () => {
        const id = document.getElementById('tmplId').value;
        const title = document.getElementById('tmplTitle').value;
        const category = document.getElementById('tmplCategory').value;
        
        if(!title) { showToast('Title is required', 'error'); return; }

        const editor = tinymce.get('mainEditor');
        const content = editor ? editor.getContent() : '';

        const method = id ? 'PUT' : 'POST';
        const body = { title, content, category };
        if(id) body.id = id;

        try {
          const res = await fetch('/api/admin/remedy-templates', {
            method: method,
            body: JSON.stringify(body)
          });
          if(res.ok) {
            showToast('Template Saved!', 'success');
            setTimeout(() => window.location.reload(), 1000);
          } else {
             throw new Error('Failed');
          }
        } catch { showToast('Error saving template', 'error'); }
      };

      window.deleteTemplate = (id) => {
        document.getElementById('deleteTemplateId').value = id;
        document.getElementById('deleteTemplateModal').style.display = 'flex';
      };

      window.closeDeleteTemplateModal = () => {
        document.getElementById('deleteTemplateModal').style.display = 'none';
      };

      window.confirmDeleteTemplate = async () => {
            const id = document.getElementById('deleteTemplateId').value;
            try {
              await fetch('/api/admin/remedy-templates?id=' + id, { method: 'DELETE' });
              showToast('Template deleted', 'success');
              setTimeout(() => window.location.reload(), 1000);
            } catch { showToast('Error deleting template', 'error'); }
            closeDeleteTemplateModal();
      };

      // 5. Saved Remedies Logic
      
      // Load saved remedies data from hidden div
      let savedRemedies = [];
      try {
        savedRemedies = JSON.parse(document.getElementById('remediesData').textContent);
      } catch { /* ignore */ }

      window.loadRemedy = (id) => {
         const r = savedRemedies.find(x => x.id === id);
         if(!r) return;
         
         // Populate Form
         populateMeta({
           customer_name: r.customer_name,
           customer_email: r.customer_email || '',
           customer_phone: r.customer_phone || '',
           heading: r.heading || 'Remedial Measures',
           remedy_id: r.id,
           appointment_id: r.appointment_id,
           customer_appointment_id: r.customer_appointment_id,
           dob: r.dob,
           tob: r.tob,
           pob: r.pob,
           rasi: r.rasi,
           nakshatra: r.nakshatra,
           lagna: r.lagna
         });
         
         // Populate Editor
         const editor = tinymce.get('mainEditor');
         if(editor) {
           editor.setContent(r.content || '');
         }
         
         // Scroll to top
         document.querySelector('.editor-area').scrollTop = 0;
         window.scrollTo({ top: 0, behavior: 'smooth' });
         
         document.getElementById('statusMsg').innerHTML = '<span class="text-info"><i class="fas fa-pencil"></i> Editing Saved Remedy</span>';
         showToast('Remedy loaded', 'success');
      };

      window.deleteRemedy = async (id) => {
        showConfirm('Delete Remedy?', 'Are you sure you want to delete this remedy permanently? This cannot be undone.', async () => {
            try {
              const r = await fetch('/api/admin/remedies?id=' + id, { method: 'DELETE' });
              if(r.ok) {
                showToast('Remedy deleted', 'success');
                setTimeout(() => window.location.reload(), 1000);
              } else {
                showToast('Failed to delete', 'error');
              }
            } catch { showToast('Error deleting', 'error'); }
        });
      };

      window.copyShareLink = (token) => {
        const url = window.location.origin + '/r/' + token;
        navigator.clipboard.writeText(url).then(() => {
          showToast('Link copied to clipboard!', 'success');
        });
      };

      window.sendEmailRemedy = async (id) => {
        const r = savedRemedies.find(x => x.id === id);
        if(!r) { showToast('Remedy not found', 'error'); return; }
        const to = (r.customer_email || '').trim();
        if(!to) { showToast('Client email missing', 'error'); return; }
        const shareLink = window.location.origin + '/r/' + r.share_token;
        const confirm = () => {
          (async () => {
            try {
              // Ensure template exists
              const tRes = await fetch('/api/admin/templates?type=email');
              const tJson = await tRes.json();
              const found = Array.isArray(tJson.data) ? tJson.data.find(x => x.key === 'remedies_share_email') : null;
              if(!found) {
                await fetch('/api/admin/templates', { method: 'PUT', body: JSON.stringify({ type: 'email', key: 'remedies_share_email', subject: 'Your Personalized Remedies – JyotirSetu', html: '<p>Dear {name},</p><p>Your personalized remedies report is ready:</p><p><a href="{share_link}" target="_blank">Open Remedies Report</a></p><p>Warm regards,<br/>JyotirSetu Astrology</p>' }) });
              }
              const res = await fetch('/api/admin/send-remedy-email', { method: 'POST', body: JSON.stringify({ email: to, name: r.customer_name || 'Friend', share_link: shareLink, template_key: 'remedies_share_email' }) });
              const json = await res.json();
              if(json && json.ok) {
                showToast('Email sent successfully', 'success');
              } else {
                showToast('Failed to send email', 'error');
              }
            } catch(e) {
              console.error(e); showToast('Error sending email', 'error');
            }
          })();
        };
        showConfirm('Send Email?', `Send remedies link to ${to}?`, confirm);
      };

      // Table Search
      document.getElementById('tableSearch').addEventListener('input', (e) => {
         const val = e.target.value.toLowerCase();
         const rows = document.querySelectorAll('#savedRemediesTable tbody tr');
         rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            row.style.display = text.includes(val) ? '' : 'none';
         });
      });

      // 6. Final Save
      document.getElementById('saveBtn').addEventListener('click', async () => {
        const btn = document.getElementById('saveBtn');
        const origText = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
        
        const data = getFormData();
        const editor = tinymce.get('mainEditor');
        data.content = editor ? editor.getContent() : '';
        data.astrologer_name = 'JyotirSetu Team'; 
        // Ensure friendly ID is saved
        if(data.appointment_id_display) {
            data.customer_appointment_id = data.appointment_id_display;
        } 
        
        if(!data.customer_name) {
          showToast('Please enter a Client Name', 'error');
          btn.innerHTML = origText;
          btn.disabled = false;
          return;
        }

        // Determine method: POST (create) or PUT (update)
        const method = data.remedy_id ? 'PUT' : 'POST';
        if(method === 'PUT') data.id = data.remedy_id;

        try {
          const res = await fetch('/api/admin/remedies', {
            method: method,
            body: JSON.stringify(data)
          });
          if(res.ok) {
            document.getElementById('statusMsg').innerHTML = '<span class="text-success fw-bold">Saved Successfully!</span>';
            showToast('Remedy Saved Successfully!', 'success');
            localStorage.removeItem('remedyDraft_v2');
            setTimeout(() => window.location.reload(), 1000);
          } else throw new Error('Failed');
        } catch(e) {
          showToast('Error saving: ' + e.message, 'error');
          btn.innerHTML = origText;
        } finally {
          btn.disabled = false;
        }
      });

      // Kundli & WhatsApp Utilities
      window.generateKundli = () => {
         const lagna = document.getElementById('kundliLagna').value;
         if(!lagna) {
           showToast('Please select a Lagna first', 'error');
           return;
         }
         const size = 400;
         const half = size/2;
         const getRasi = (houseNum) => {
             const val = (parseInt(lagna) + houseNum - 1) % 12;
             return val === 0 ? 12 : val;
         };
         const svgContent = `
         <svg width="${size}" height="${size}" viewBox="0 0 ${size} ${size}" xmlns="http://www.w3.org/2000/svg" style="background:white;">
            <rect x="2" y="2" width="${size-4}" height="${size-4}" fill="white" stroke="black" stroke-width="2"/>
            <line x1="0" y1="0" x2="${size}" y2="${size}" stroke="black" stroke-width="2"/>
            <line x1="${size}" y1="0" x2="0" y2="${size}" stroke="black" stroke-width="2"/>
            <line x1="0" y1="${half}" x2="${half}" y2="0" stroke="black" stroke-width="2"/>
            <line x1="${half}" y1="0" x2="${size}" y2="${half}" stroke="black" stroke-width="2"/>
            <line x1="${size}" y1="${half}" x2="${half}" y2="${size}" stroke="black" stroke-width="2"/>
            <line x1="${half}" y1="${size}" x2="0" y2="${half}" stroke="black" stroke-width="2"/>
            <g font-family="Arial" font-size="18" text-anchor="middle" font-weight="bold">
                <text x="${half}" y="${half - 50}">${getRasi(1)}</text>
                <text x="${half - 80}" y="${80}">${getRasi(2)}</text>
                <text x="${60}" y="${60}">${getRasi(3)}</text>
                <text x="${half - 50}" y="${half}">${getRasi(4)}</text>
                <text x="${60}" y="${size-60}">${getRasi(5)}</text>
                <text x="${half - 80}" y="${size-80}">${getRasi(6)}</text>
                <text x="${half}" y="${half + 60}">${getRasi(7)}</text>
                <text x="${half + 80}" y="${size-80}">${getRasi(8)}</text>
                <text x="${size-60}" y="${size-60}">${getRasi(9)}</text>
                <text x="${half + 50}" y="${half}">${getRasi(10)}</text>
                <text x="${size-60}" y="${60}">${getRasi(11)}</text>
                <text x="${half + 80}" y="${80}">${getRasi(12)}</text>
            </g>
         </svg>`;
         const encoded = encodeURIComponent(svgContent);
         const dataUrl = `data:image/svg+xml;charset=utf-8,${encoded}`;
         const img = `<img src="${dataUrl}" width="300" height="300" alt="Lagna Kundli" class="draggable-kundli" style="display:block; margin: 20px auto; max-width:100%; height:auto;">`;
         const editor = tinymce.get('mainEditor');
         if(editor) {
             editor.insertContent(img);
             showToast('Kundli inserted!', 'success');
         }
      };

      let whatsappTemplates = [];
      // Fetch templates on load
      (async function() {
          try {
              const res = await fetch('/api/admin/templates?type=whatsapp');
              const json = await res.json();
              if(json.ok && Array.isArray(json.data)) {
                  whatsappTemplates = json.data;
              }
          } catch(e) { console.error('Failed to load WA templates', e); }
      })();

      window.sendWhatsAppRemedy = (id) => {
         const r = savedRemedies.find(x => x.id === id);
         if(!r) { showToast('Remedy not found', 'error'); return; }
         
         const shareLink = window.location.origin + '/r/' + r.share_token;
         
         // Try to find 'remedies_share' template, else fallback to hardcoded
         let templateText = '';
         const tmpl = whatsappTemplates.find(t => t.key === 'remedies_share');
         
         if(tmpl && tmpl.text) {
             templateText = tmpl.text
                 .replace(/{name}/g, r.customer_name || 'Customer')
                 .replace(/{share_link}/g, shareLink)
                 .replace(/{appointment_id}/g, r.appointment_id || '');
         } else {
             // Fallback
             templateText = `Namaste ${r.customer_name},\n\nHere is your personalized remedies report from JyotirSetu:\n${shareLink}\n\nRegards,\nJyotirSetu Astrology`;
         }
         
         const phone = r.customer_phone ? r.customer_phone.replace(/\D/g, '') : '';
         const waUrl = `https://web.whatsapp.com/send?phone=${phone}&text=${encodeURIComponent(templateText)}`;
         
         window.open(waUrl, '_blank');
      };

    </script>
  </body>
</html>
