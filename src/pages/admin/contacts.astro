---
export const prerender = false;
import Favicons from '~/components/Favicons.astro';
import AdminNavbar from '~/components/AdminNavbar.astro';
 
 
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contacts – Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@latest/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="/admin.css?v=20251129" />
    <Favicons />
  </head>
  <body class="hold-transition sidebar-mini">
    <button class="sidebar-toggle" aria-label="Open Admin Menu" id="sidebarToggle">☰</button>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
    <script is:inline>
      /* @ts-nocheck */
      (function () {
        function applyTheme(theme) {
          let t = theme;
          if (t === 'auto') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.body.classList.toggle('dark-mode', t === 'dark');
        }
        let theme = 'dark';
        let collapsed = false;
        try {
          const stored = localStorage.getItem('adminSettings');
          if (stored) {
            const s = JSON.parse(stored);
            if (s && typeof s === 'object') {
              if (s.theme) theme = s.theme;
              if (s.sidebarCollapsed != null) collapsed = !!s.sidebarCollapsed;
            }
          }
        } catch (e) {
          console.error('Error loading admin settings:', e);
        }
        applyTheme(theme);
        document.body.classList.toggle('sidebar-collapse', collapsed);
        try {
          Promise.all([
            fetch('/api/admin/preferences?key=theme').then(function (r) {
              return r.json();
            }),
            fetch('/api/admin/preferences?key=sidebarCollapsed').then(function (r) {
              return r.json();
            }),
          ])
            .then(function (rs) {
              const tr = rs[0],
                sr = rs[1];
              if (tr && tr.ok && typeof tr.value === 'string') applyTheme(tr.value);
              if (sr && sr.ok && sr.value != null) document.body.classList.toggle('sidebar-collapse', sr.value === '1');
            })
            .catch(function (err) {
              console.error('Error syncing preferences:', err);
            });
        } catch (e) {
          console.error('Error syncing preferences:', e);
        }
      })();
    </script>
    <div class="wrapper">
      
      <AdminNavbar />
      <aside class="main-sidebar sidebar-dark-primary elevation-4" id="adminSidebar">
        <a href="/admin/dashboard" class="brand-link" style="display:flex;align-items:center;gap:8px">
          <img
            src="https://images.unsplash.com/vector-1763306579596-25a002c977df?q=80&w=1979&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
            alt="Brand"
            style="height:40px;width:auto;border-radius:0;box-shadow:0 2px 6px rgba(0,0,0,0.25)"
          />
        </a>
        <div class="sidebar">
          <nav class="mt-2">
            <ul class="nav nav-pills nav-sidebar flex-column" role="menu" data-accordion="false" data-widget="treeview">
              <li class="nav-item">
                <a href="/admin/dashboard" class="nav-link"><i class="nav-icon fas fa-gauge"></i><p>Dashboard</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/leads" class="nav-link"><i class="nav-icon fas fa-route"></i><p>Leads</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/appointments" class="nav-link"
                  ><i class="nav-icon fas fa-calendar-check"></i><p>Appointments</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/contacts" class="nav-link active"
                  ><i class="nav-icon fas fa-comments"></i><p>Contacts</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/newsletter" class="nav-link"
                  ><i class="nav-icon fas fa-envelope-open-text"></i><p>Newsletter</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/calendar" class="nav-link"><i class="nav-icon fas fa-calendar"></i><p>Calendar</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/quotes" class="nav-link"
                  ><i class="nav-icon fas fa-file-invoice"></i><p>Quotations</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/after-service" class="nav-link"
                  ><i class="nav-icon fas fa-handshake"></i><p>After Service</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/activity-log" class="nav-link"
                  ><i class="nav-icon fas fa-list"></i><p>Activity Log</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/templates/email" class="nav-link"
                  ><i class="nav-icon fas fa-file-alt"></i><p>Email Templates</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/templates/payment" class="nav-link"
                  ><i class="nav-icon fas fa-file-invoice-dollar"></i><p>Payment Templates</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/templates/whatsapp" class="nav-link"
                  ><i class="nav-icon fas fa-file-alt"></i><p>WhatsApp Templates</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/client360" class="nav-link"
                  ><i class="nav-icon fas fa-user-circle"></i><p>Client 360°</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/users" class="nav-link"><i class="nav-icon fas fa-users-cog"></i><p>Users</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/tools/follow-hub/insights" class="nav-link"
                  ><i class="nav-icon fas fa-toolbox"></i><p>Follow Hub – Insights</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/settings" class="nav-link"><i class="nav-icon fas fa-gear"></i><p>Settings</p></a>
              </li>
            </ul>
          </nav>
        </div>
      </aside>
      <div class="content-wrapper">
        <section class="content-header">
          <div class="container-fluid">
            <div class="row mb-2">
              <div class="col-sm-6"><h1>Contacts</h1></div>
              <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                  <li class="breadcrumb-item"><a href="/admin/dashboard">Home</a></li>
                  <li class="breadcrumb-item active">Contacts</li>
                </ol>
              </div>
            </div>
          </div>
        </section>
        <section class="content">
          <div class="container-fluid">
            <div class="toolbar toolbar-card">
              <button class="btn btn-sm btn-info" id="columnsBtn">☰ Columns</button>
              <button class="btn btn-sm btn-success" id="exportBtn">📥 Export CSV</button>
              <span class="badge bg-primary">Reply and track status</span>
              
            </div>
            <div class="toolbar toolbar-card">
              <input class="input" id="search" placeholder="Search name, email, subject" style="width:220px" />
              <select class="select" id="statusFilter">
                <option value="">All status</option>
                <option>new</option>
                <option>read</option>
                <option>replied</option>
                <option>closed</option>
              </select>
              <!-- View controls placed next to All status (row 1) -->
              <input class="input" id="viewName" placeholder="View name" style="width:140px" />
              <button class="btn-sm" id="saveViewBtn" style="background:#10b981; color:#fff; border:none"
                >Save View</button
              >
              <button class="btn-sm" id="deleteViewBtn" style="background:#ef4444; color:#fff; border:none"
                >Delete View</button
              >
              <select class="select" id="priorityFilter">
                <option value="">All priorities</option>
                <option>normal</option>
                <option>high</option>
                <option>urgent</option>
              </select>
              <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap">
                <span class="muted" style="color:#6b7280">Date range:</span>
                <input class="input" type="date" id="fromDate" placeholder="From" />
                <input class="input" type="date" id="toDate" placeholder="To" />
                <button
                  class="btn-sm"
                  id="presetToday"
                  style="background:#f3f4f6; color:#374151; border:1px solid #d1d5db">Today</button
                >
                <button class="btn-sm" id="preset7" style="background:#f3f4f6; color:#374151; border:1px solid #d1d5db"
                  >Last 7 days</button
                >
                <button class="btn-sm" id="preset30" style="background:#f3f4f6; color:#374151; border:1px solid #d1d5db"
                  >Last 30 days</button
                >
                <button
                  class="btn-sm"
                  id="presetMonth"
                  style="background:#f3f4f6; color:#374151; border:1px solid #d1d5db">This month</button
                >
                <button
                  class="btn-sm"
                  id="clearDates"
                  style="background:#fee2e2; color:#991b1b; border:1px solid #fecaca">Clear</button
                >
                <select class="select" id="savedViews" style="min-width:180px">
                  <option value="">Saved views…</option>
                </select>
              </div>
            </div>
            <div id="activeChips" class="callout callout-info" style="display:flex; gap:8px; flex-wrap:wrap"></div>
        <div class="container-fluid" style="padding-bottom:20px">
              <div id="tableWrap"></div>
              <div id="pagination"></div>
        </div>
          </div>
        </section>
      </div>
      <footer class="main-footer">
        <strong>JyotirSetu Admin</strong><div class="float-end d-none d-sm-inline">AdminLTE theme</div>
      </footer>
    </div>

    <!-- Notes Modal -->
    <div class="modal" id="notesModal">
      <div class="modal-content">
        <div class="modal-header">
          <h3>Notes & History</h3>
          <button class="close-btn" id="closeNotesModal">&times;</button>
        </div>
        <div id="notesContent">
          <div style="margin-bottom:20px">
            <label style="display:block;margin-bottom:8px;font-weight:600" class="section-title">Add Note</label>
            <textarea id="newNote" class="input" rows="3" placeholder="Enter your note here..."></textarea>
            <button
              class="btn"
              id="saveNoteBtn"
              style="margin-top:8px;background:#667eea;color:white;border:none;padding:8px 16px;border-radius:6px;cursor:pointer"
              >Save Note</button
            >
          </div>
          <div>
            <strong class="section-title">Notes History</strong>
            <div id="notesList" style="max-height:300px;overflow-y:auto"></div>
          </div>
          <div class="section">
            <strong class="section-title">Email History</strong>
            <div id="emailHistoryList" style="max-height:200px;overflow-y:auto"></div>
          </div>
          <div class="section">
            <strong class="section-title">WhatsApp History</strong>
            <div id="whatsappHistoryList" style="max-height:200px;overflow-y:auto"></div>
          </div>
        </div>
        <!-- Inline Note Edit Modal -->
        <div class="modal" id="noteEditModal" style="position:fixed;inset:0;display:none">
          <div class="modal-content" style="max-width:520px">
            <div class="modal-header">
              <h3>Edit Note</h3>
              <button class="close-btn" id="noteEditCancel">&times;</button>
            </div>
            <div>
              <textarea id="noteEditText" class="input" rows="4" placeholder="Edit note..."></textarea>
              <div style="margin-top:12px;display:flex;gap:8px;justify-content:flex-end">
                <button
                  type="button"
                  class="btn"
                  id="noteEditSave"
                  style="background:#667eea;color:#fff;border:none;padding:8px 16px;border-radius:6px">Save</button
                >
                <button
                  type="button"
                  class="btn"
                  id="noteEditCancelBtn"
                  style="background:#1f2937;color:#fff;border:none;padding:8px 16px;border-radius:6px">Cancel</button
                >
              </div>
            </div>
          </div>
        </div>
        <!-- Note Delete Confirm Modal -->
        <div class="modal" id="noteDeleteModal" style="position:fixed;inset:0;display:none">
          <div class="modal-content" style="max-width:420px">
            <div class="modal-header">
              <h3>Confirm Delete</h3>
              <button class="close-btn" id="noteDeleteCancel">&times;</button>
            </div>
            <div>
              <p style="margin-bottom:12px">Are you sure you want to delete this note?</p>
              <div style="display:flex;gap:8px;justify-content:flex-end">
                <button
                  type="button"
                  class="btn"
                  id="noteDeleteConfirmBtn"
                  style="background:#ef4444;color:#fff;border:none;padding:8px 16px;border-radius:6px">Delete</button
                >
                <button
                  type="button"
                  class="btn"
                  id="noteDeleteCancelBtn"
                  style="background:#1f2937;color:#fff;border:none;padding:8px 16px;border-radius:6px">Cancel</button
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script src="/js/contacts.js" defer></script>
    <!-- Export Columns Modal -->
    <div class="modal" id="columnsModal">
      <div class="modal-content">
        <div class="modal-header">
          <h3>Choose Export Columns</h3>
          <button class="close-btn" id="columnsClose">&times;</button>
        </div>
        <div id="columnsList"></div>
        <div style="display:flex; gap:8px; justify-content:flex-end; margin-top:16px">
          <button
            class="btn"
            id="columnsSave"
            style="background:#667eea; color:white; border:none; padding:8px 16px; border-radius:6px">Save</button
          >
        </div>
      </div>
    </div>
    
  </body><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/admin-lte@latest/dist/js/adminlte.min.js" defer></script>
</html>
