---
export const prerender = false;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login</title>
    <link rel="stylesheet" href="/admin.css" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  </head>
  <body class="auth-wrap">
    <form class="auth-card" method="post" action="/api/admin/login">
      <div class="brand"><span class="brand-dot"></span><span>JyotirSetu Admin</span></div>
      <h1 class="title">Sign in</h1>
      <p class="subtitle">Secure access to appointments and contacts</p>
      <div class="field">
        <label for="username">Username</label>
        <input id="username" name="username" type="text" placeholder="Enter username" required />
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" placeholder="Enter password" required />
      </div>
      <button class="btn" type="submit">Continue</button>
    </form>
  </body>
 </html>


