---
export const prerender = false;
import Favicons from '~/components/Favicons.astro';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login</title>
<link rel="stylesheet" href="/admin.css?v=20251116" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@latest/dist/css/adminlte.min.css" />
<Favicons />
  </head>
  <body class="hold-transition login-page">
    <div class="login-box">
      <div class="card card-outline card-primary">
        <div class="card-header text-center">
          <a href="#" class="h1"><span class="brand-dot"></span><span>JyotirSetu Admin</span></a>
        </div>
        <div class="card-body">
          <p class="login-box-msg">Sign in to start your session</p>
          <form method="post" action="/api/admin/login">
            <div class="input-group mb-3">
              <input id="username" name="username" type="text" class="form-control" placeholder="Username" required />
              <span class="input-group-text">👤</span>
            </div>
            <div class="input-group mb-3">
              <input id="password" name="password" type="password" class="form-control" placeholder="Password" required />
              <span class="input-group-text">🔒</span>
            </div>
            <div class="row">
              <div class="col-12">
                <button class="btn btn-primary w-100" type="submit">Sign In</button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </body>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/admin-lte@latest/dist/js/adminlte.min.js" defer></script>
 </html>


