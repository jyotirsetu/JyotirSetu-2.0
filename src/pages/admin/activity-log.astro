---
export const prerender = false;
import Favicons from '~/components/Favicons.astro';
import AdminNavbar from '~/components/AdminNavbar.astro';
import MobilePageSelect from '~/components/MobilePageSelect.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Activity Log – Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@latest/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="/admin.css?v=20251129" />
    <Favicons />
  </head>
  <body class="hold-transition sidebar-mini">
    <button class="sidebar-toggle" aria-label="Open Admin Menu" id="sidebarToggle">☰</button>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
    <script is:inline>
      (function () {
        function applyTheme(theme) {
          let t = theme;
          if (t === 'auto') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.body.classList.toggle('dark-mode', t === 'dark');
        }
        let theme = 'dark';
        let collapsed = false;
        try {
          const stored = localStorage.getItem('adminSettings');
          if (stored) {
            const s = JSON.parse(stored);
            if (s && typeof s === 'object') {
              if (s.theme) theme = s.theme;
              if (s.sidebarCollapsed != null) collapsed = !!s.sidebarCollapsed;
            }
          }
        } catch (e) {
          console.error('Error loading admin settings:', e);
        }
        applyTheme(theme);
        document.body.classList.toggle('sidebar-collapse', collapsed);
        try {
          Promise.all([
            fetch('/api/admin/preferences?key=theme').then(function (r) {
              return r.json();
            }),
            fetch('/api/admin/preferences?key=sidebarCollapsed').then(function (r) {
              return r.json();
            }),
          ])
            .then(function (rs) {
              const tr = rs[0],
                sr = rs[1];
              if (tr && tr.ok && typeof tr.value === 'string') applyTheme(tr.value);
              if (sr && sr.ok && sr.value != null) document.body.classList.toggle('sidebar-collapse', sr.value === '1');
            })
            .catch(function (err) {
              console.error('Error syncing preferences:', err);
            });
        } catch (e) {
          console.error('Error syncing preferences:', e);
        }
      })();
    </script>
    <div class="wrapper">
      
      <AdminNavbar />
      <!-- legacy navbar kept below for reference
      <nav class="main-header navbar navbar-expand navbar-dark">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button" aria-label="Toggle sidebar"
              ><i class="fas fa-bars"></i></a
            >
          </li>
          <li class="nav-item"><a href="/admin/dashboard" class="nav-link">Dashboard</a></li>
        </ul>
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><MobilePageSelect /></li>
          <li class="nav-item">
            <button class="btn btn-sm btn-outline-secondary" id="toggleSidebarDesktop">Hide sidebar</button>
          </li>
          <li class="nav-item"><a href="/api/admin/logout" class="nav-link">Logout</a></li>
        </ul>
      </nav> -->
      <aside class="main-sidebar sidebar-dark-primary elevation-4" id="adminSidebar">
        <a href="/admin/dashboard" class="brand-link" style="display:flex;align-items:center;gap:8px">
          <img
            src="https://images.unsplash.com/vector-1763306579596-25a002c977df?q=80&w=1979&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
            alt="Brand"
            style="height:40px;width:auto;border-radius:0;box-shadow:0 2px 6px rgba(0,0,0,0.25)"
          />
        </a>
        <div class="sidebar">
          <nav class="mt-2">
            <ul class="nav nav-pills nav-sidebar flex-column" role="menu" data-accordion="false" data-widget="treeview">
              <li class="nav-item">
                <a href="/admin/dashboard" class="nav-link"><i class="nav-icon fas fa-gauge"></i><p>Dashboard</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/appointments" class="nav-link"
                  ><i class="nav-icon fas fa-calendar-check"></i><p>Appointments</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/contacts" class="nav-link"><i class="nav-icon fas fa-comments"></i><p>Contacts</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/newsletter" class="nav-link"
                  ><i class="nav-icon fas fa-envelope-open-text"></i><p>Newsletter</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/calendar" class="nav-link"><i class="nav-icon fas fa-calendar"></i><p>Calendar</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/quotes" class="nav-link"
                  ><i class="nav-icon fas fa-file-invoice"></i><p>Quotations</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/after-service" class="nav-link"
                  ><i class="nav-icon fas fa-handshake"></i><p>After Service</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/activity-log" class="nav-link active"
                  ><i class="nav-icon fas fa-list"></i><p>Activity Log</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/templates/email" class="nav-link"
                  ><i class="nav-icon fas fa-file-alt"></i><p>Email Templates</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/templates/payment" class="nav-link"
                  ><i class="nav-icon fas fa-file-invoice-dollar"></i><p>Payment Templates</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/templates/whatsapp" class="nav-link"
                  ><i class="nav-icon fas fa-file-alt"></i><p>WhatsApp Templates</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/client360" class="nav-link"
                  ><i class="nav-icon fas fa-user-circle"></i><p>Client 360°</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/tools/follow-hub/insights" class="nav-link"
                  ><i class="nav-icon fas fa-toolbox"></i><p>Follow Hub – Insights</p></a
                >
              </li>
              <li class="nav-item">
                <a href="/admin/settings" class="nav-link"><i class="nav-icon fas fa-gear"></i><p>Settings</p></a>
              </li>
            </ul>
          </nav>
        </div>
      </aside>
      <div class="content-wrapper">
        <section class="content-header">
          <div class="container-fluid">
            <div class="row mb-2">
              <div class="col-sm-6"><h1>Activity Log</h1></div>
              <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                  <li class="breadcrumb-item"><a href="/admin/dashboard">Home</a></li>
                  <li class="breadcrumb-item active">Activity Log</li>
                </ol>
              </div>
            </div>
          </div>
        </section>
        <section class="content">
          <div class="container-fluid">
            <div class="toolbar">
              <select class="form-select form-select-sm" id="actionFilter">
                <option value="">All actions</option>
                <option>appointment_created</option>
                <option>status_updated</option>
                <option>email_sent</option>
                <option>contact_created</option>
                <option>note_created</option>
              </select>
              <select class="form-select form-select-sm" id="entityFilter">
                <option value="">All entities</option>
                <option>appointment</option>
                <option>contact</option>
                <option>note</option>
              </select>
            </div>
            <div class="container-fluid" style="padding-bottom:20px">
              <div id="logWrap"></div>
            </div>
          </div>
        </section>
      </div>
      <footer class="main-footer">
        <strong>JyotirSetu Admin</strong><div class="float-end d-none d-sm-inline">AdminLTE theme</div>
      </footer>
    </div>

    <script is:inline>
      async function loadActivityLog() {
        const res = await fetch('/api/admin/activity-log?limit=200', { credentials: 'include' });
        const json = await res.json();
        return json?.data || [];
      }

      function render(logs) {
        const wrap = document.getElementById('logWrap');
        if (!wrap) return;
        if (!logs.length) {
          wrap.innerHTML = '<p class="muted">No activity yet.</p>';
          return;
        }
        function formatIndiaTime(ts) {
          try {
            let d;
            if (typeof ts === 'string') {
              const s = ts.trim();
              // Handle SQLite current_timestamp (UTC, no timezone)
              if (/^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}(\.\d+)?$/.test(s)) {
                d = new Date(s.replace(' ', 'T') + 'Z');
              } else {
                d = new Date(s);
              }
            } else {
              d = new Date(ts);
            }
            return d.toLocaleString('en-IN', {
              timeZone: 'Asia/Kolkata',
              year: 'numeric',
              month: 'short',
              day: '2-digit',
              hour: '2-digit',
              minute: '2-digit',
              hour12: true,
            });
          } catch (e) {
            console.error('formatIndiaTime error:', e);
            return String(ts || '');
          }
        }

        const actionFilterEl = document.getElementById('actionFilter');
        const entityFilterEl = document.getElementById('entityFilter');
        const actionFilter = actionFilterEl?.value || '';
        const entityFilter = entityFilterEl?.value || '';
        const filtered = logs.filter((l) => {
          return (!actionFilter || l.action === actionFilter) && (!entityFilter || l.entity_type === entityFilter);
        });

        const html = filtered
          .map((l) => {
            const actionIcon =
              {
                appointment_created: '📅',
                status_updated: '🔄',
                email_sent: '📧',
                contact_created: '💬',
                note_created: '📝',
                note_deleted: '🗑️',
                contact_deleted: '🗑️',
              }[l.action] || '⚡';

            return `<div style="padding:12px;margin-bottom:8px;background:linear-gradient(180deg,var(--panel),var(--panel-2));border:1px solid var(--border);border-radius:8px">
            <div style="display:flex;gap:12px;align-items:start">
              <span style="font-size:20px">${actionIcon}</span>
              <div style="flex:1">
                <div style="font-weight:600;margin-bottom:4px">${l.action.replace(/_/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase())}</div>
                <div class="muted" style="font-size:12px;margin-bottom:4px">${l.entity_type}${l.appointment_name || l.contact_name || l.appointment_email || l.contact_email ? ` – ${l.appointment_name || l.contact_name || l.appointment_email || l.contact_email}` : ''}</div>
                ${l.details ? `<div style="font-size:13px;color:var(--muted);margin-top:4px">${l.details}</div>` : ''}
                <div style="font-size:11px;color:var(--muted);margin-top:6px">${formatIndiaTime(l.created_at)}</div>
              </div>
            </div>
          </div>`;
          })
          .join('');

        wrap.innerHTML = html || '<p class="muted">No matching activity.</p>';
      }

      let allLogs = [];

      async function refresh() {
        allLogs = await loadActivityLog();
        try {
          const actions = Array.from(
            new Set(
              (allLogs || []).map(function (l) {
                return String(l.action || '').trim();
              })
            )
          ).filter(Boolean).sort();
          const af = document.getElementById('actionFilter');
          if (af) {
            const current = af.value || '';
            af.innerHTML = ['<option value="">All actions</option>']
              .concat(actions.map(function (a) { return `<option value="${a}">${a}</option>`; }))
              .join('');
            if (current) af.value = current;
          }
        } catch { /* ignore populate errors */ }
        render(allLogs);
      }

      document.getElementById('refreshBtn')?.addEventListener('click', refresh);
      document.getElementById('actionFilter')?.addEventListener('change', () => render(allLogs));
      document.getElementById('entityFilter')?.addEventListener('change', () => render(allLogs));

      refresh();

      // Auto-refresh every 30 seconds
      setInterval(refresh, 30000);

      // Mobile drawer
      const sidebar = document.getElementById('adminSidebar');
      const backdrop = document.getElementById('sidebarBackdrop');
      const toggleBtn = document.getElementById('sidebarToggle');
      let isOpen = false;

      function openSidebar() {
        sidebar?.classList.add('active');
        backdrop?.classList.add('active');
        toggleBtn?.classList.add('active');
        if (toggleBtn) toggleBtn.innerHTML = '✕';
        isOpen = true;
      }

      function closeSidebar() {
        sidebar?.classList.remove('active');
        backdrop?.classList.remove('active');
        toggleBtn?.classList.remove('active');
        if (toggleBtn) toggleBtn.innerHTML = '☰';
        isOpen = false;
      }

      toggleBtn?.addEventListener('click', () => {
        if (isOpen) closeSidebar();
        else openSidebar();
      });

      backdrop?.addEventListener('click', closeSidebar);
      sidebar?.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', () => {
          if (window.innerWidth <= 900) closeSidebar();
        });
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isOpen) closeSidebar();
      });
      (function () {
        const btn = document.getElementById('toggleSidebarDesktop');
        function sync() {
          if (!btn) return;
          const c = document.body.classList.contains('sidebar-collapse');
          btn.textContent = c ? 'Show sidebar' : 'Hide sidebar';
        }
        async function toggle() {
          const c = document.body.classList.toggle('sidebar-collapse');
          sync();
          try {
            await fetch('/api/admin/preferences', {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ key: 'sidebarCollapsed', value: c ? '1' : '0' }),
            });
          } catch (e) {
            console.error('Error saving sidebarCollapsed:', e);
          }
        }
        btn?.addEventListener('click', toggle);
        sync();
      })();
    </script>
  </body><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/admin-lte@latest/dist/js/adminlte.min.js" defer></script>
</html>
