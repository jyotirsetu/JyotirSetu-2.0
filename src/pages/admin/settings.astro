---
export const prerender = false;
import Favicons from '~/components/Favicons.astro';
import AdminNavbar from '~/components/AdminNavbar.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Settings – Admin</title>
    <link rel="stylesheet" href="/admin.css?v=20251116" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@latest/dist/css/adminlte.min.css" />
    <Favicons />
    <script src="/js/admin-notify.js" defer></script>
    <script is:inline>
      (function () {
        function defineFallback() {
          try {
            if (window.AdminNotify) return;
            window.AdminNotify = {
              success: function (msg, detail) {
                console.log('SUCCESS:', detail ? msg + ': ' + detail : msg);
              },
              error: function (msg, detail) {
                console.error('ERROR:', detail ? msg + ': ' + detail : msg);
              },
              info: function (msg, detail) {
                console.log('INFO:', detail ? msg + ': ' + detail : msg);
              },
            };
          } catch {
            /* ignore */
          }
        }
        function reinject() {
          try {
            const s = document.createElement('script');
            s.src = '/js/admin-notify.js?v=' + Date.now();
            s.defer = true;
            s.onload = function () {
              if (!window.AdminNotify) defineFallback();
            };
            s.onerror = function () {
              defineFallback();
            };
            document.head.appendChild(s);
          } catch {
            defineFallback();
          }
        }
        if (!window.AdminNotify) {
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', reinject);
          } else {
            reinject();
          }
          setTimeout(function () {
            if (!window.AdminNotify) defineFallback();
          }, 1500);
        }
      })();
    </script>
    <style>
      .settings-section {
        background: linear-gradient(180deg, var(--panel), var(--panel-2));
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 24px;
        margin-bottom: 20px;
      }
      .settings-section h3 {
        margin: 0 0 16px;
        font-size: 18px;
        font-weight: 700;
      }
      .form-row {
        display: grid;
        grid-template-columns: 200px 1fr;
        gap: 16px;
        margin-bottom: 16px;
        align-items: center;
      }
      .form-row label {
        font-weight: 500;
        color: var(--text);
      }
      .form-row .input,
      .form-row .select {
        flex: 1;
      }
      .toggle-switch {
        position: relative;
        display: inline-block;
        width: 50px;
        height: 24px;
      }
      .toggle-switch input {
        opacity: 0;
        width: 0;
        height: 0;
      }
      .toggle-slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #374151;
        transition: 0.4s;
        border-radius: 24px;
      }
      .toggle-slider:before {
        position: absolute;
        content: '';
        height: 18px;
        width: 18px;
        left: 3px;
        bottom: 3px;
        background-color: white;
        transition: 0.4s;
        border-radius: 50%;
      }
      input:checked + .toggle-slider {
        background-color: var(--brand);
      }
      input:checked + .toggle-slider:before {
        transform: translateX(26px);
      }
      .info-text {
        font-size: 12px;
        color: var(--muted);
        margin-top: 4px;
      }
    </style>
  </head>
  <body class="hold-transition sidebar-mini">
    <button class="sidebar-toggle" aria-label="Open Admin Menu" id="sidebarToggle">☰</button>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
    <script is:inline>
      (function () {
        function applyTheme(theme) {
          let t = theme;
          if (t === 'auto') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.body.classList.toggle('dark-mode', t === 'dark');
        }
        let theme = 'dark';
        let collapsed = false;
        try {
          const stored = localStorage.getItem('adminSettings');
          if (stored) {
            const s = JSON.parse(stored);
            if (s && typeof s === 'object') {
              if (s.theme) theme = s.theme;
              if (s.sidebarCollapsed != null) collapsed = !!s.sidebarCollapsed;
            }
          }
        } catch (e) {
          console.error('Error loading admin settings:', e);
        }
        applyTheme(theme);
        document.body.classList.toggle('sidebar-collapse', collapsed);
        try {
          Promise.all([
            fetch('/api/admin/preferences?key=theme').then(function (r) {
              return r.json();
            }),
            fetch('/api/admin/preferences?key=sidebarCollapsed').then(function (r) {
              return r.json();
            }),
          ])
            .then(function (rs) {
              const tr = rs[0],
                sr = rs[1];
              if (tr && tr.ok && typeof tr.value === 'string') applyTheme(tr.value);
              if (sr && sr.ok && sr.value != null) document.body.classList.toggle('sidebar-collapse', sr.value === '1');
            })
            .catch(function (err) {
              console.error('Error syncing preferences:', err);
            });
        } catch (e) {
          console.error('Error syncing preferences:', e);
        }
      })();
    </script>
    <div class="wrapper">
      <AdminNavbar />
      <!-- legacy navbar
      <nav class="main-header navbar navbar-expand navbar-dark">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button" aria-label="Toggle sidebar"
              ><i class="fas fa-bars"></i></a
            >
          </li>
          <li class="nav-item"><a href="/admin/dashboard" class="nav-link">Dashboard</a></li>
        </ul>
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a href="/api/admin/logout" class="nav-link">Logout</a></li>
        </ul>
      </nav> -->
      <aside class="main-sidebar sidebar-dark-primary elevation-4" id="adminSidebar">
        <div class="logo">
          <img
            src="https://images.unsplash.com/vector-1763306579596-25a002c977df?q=80&w=1979&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
            alt="Brand"
            style="height:40px;width:auto;border-radius:0;box-shadow:0 2px 6px rgba(0,0,0,0.25)"
          />
        </div>
        <nav class="mt-2">
          <ul class="nav nav-pills nav-sidebar flex-column" role="menu" data-accordion="false" data-widget="treeview">
            <li class="nav-item">
              <a href="/admin/dashboard" class="nav-link"><i class="nav-icon fas fa-gauge"></i><p>Dashboard</p></a>
            </li>
            <li class="nav-item">
              <a href="/admin/appointments" class="nav-link"
                ><i class="nav-icon fas fa-calendar-check"></i><p>Appointments</p></a
              >
            </li>
            <li class="nav-item">
              <a href="/admin/contacts" class="nav-link"><i class="nav-icon fas fa-comments"></i><p>Contacts</p></a>
            </li>
            <li class="nav-item">
              <a href="/admin/newsletter" class="nav-link"
                ><i class="nav-icon fas fa-envelope-open-text"></i><p>Newsletter</p></a
              >
            </li>
            <li class="nav-item">
              <a href="/admin/calendar" class="nav-link"><i class="nav-icon fas fa-calendar"></i><p>Calendar</p></a>
            </li>
            <li class="nav-item">
              <a href="/admin/quotes" class="nav-link"><i class="nav-icon fas fa-file-invoice"></i><p>Quotations</p></a>
            </li>
            <li class="nav-item">
              <a href="/admin/activity-log" class="nav-link"><i class="nav-icon fas fa-list"></i><p>Activity Log</p></a>
            </li>
            <li class="nav-item">
              <a href="/admin/templates/email" class="nav-link"
                ><i class="nav-icon fas fa-file-alt"></i><p>Email Templates</p></a
              >
            </li>
            <li class="nav-item">
              <a href="/admin/templates/payment" class="nav-link"
                ><i class="nav-icon fas fa-file-invoice-dollar"></i><p>Payment Templates</p></a
              >
            </li>
            <li class="nav-item">
              <a href="/admin/templates/whatsapp" class="nav-link"
                ><i class="nav-icon fas fa-file-alt"></i><p>WhatsApp Templates</p></a
              >
            </li>
            <li class="nav-item">
              <a href="/admin/client360" class="nav-link"
                ><i class="nav-icon fas fa-user-circle"></i><p>Client 360°</p></a
              >
            </li>
            <li class="nav-item">
              <a href="/admin/tools/follow-hub/insights" class="nav-link"
                ><i class="nav-icon fas fa-toolbox"></i><p>Follow Hub – Insights</p></a
              >
            </li>
            <li class="nav-item">
              <a href="/admin/settings" class="nav-link active"><i class="nav-icon fas fa-gear"></i><p>Settings</p></a>
            </li>
          </ul>
        </nav>
      </aside>
      <div class="content-wrapper">
        <div class="topbar">
          <strong>Settings</strong>
          <div style="display:flex; gap:8px; align-items:center">
            <a href="/api/admin/logout" class="pill">Logout</a>
          </div>
        </div>
        <div style="padding: 20px;">
          <div class="settings-section">
            <h3>🔐 Account Settings</h3>
            <div class="form-row">
              <label>Admin Username</label>
              <div>
                <input class="input" id="username" type="text" placeholder="Current username" disabled />
                <div class="info-text">Change via ADMIN_USERNAME environment variable</div>
              </div>
            </div>
            <div class="form-row">
              <label>Admin Password</label>
              <div>
                <input class="input" id="password" type="password" placeholder="Enter new password" />
                <div class="info-text">Change via ADMIN_PASSWORD environment variable</div>
              </div>
            </div>
            <div class="form-row">
              <label>Session Duration</label>
              <select class="select" id="sessionDuration">
                <option value="7">7 days</option>
                <option value="30" selected>30 days</option>
                <option value="90">90 days</option>
              </select>
            </div>
          </div>

          <div class="settings-section">
            <h3>🔔 Notifications</h3>
            <div class="form-row">
              <label>Browser Notifications</label>
              <label class="toggle-switch">
                <input type="checkbox" id="browserNotifications" />
                <span class="toggle-slider"></span>
              </label>
            </div>
            <div class="form-row">
              <label>Email Alerts</label>
              <label class="toggle-switch">
                <input type="checkbox" id="emailAlerts" checked />
                <span class="toggle-slider"></span>
              </label>
            </div>
            <div class="form-row">
              <label>Notify on New Appointment</label>
              <label class="toggle-switch">
                <input type="checkbox" id="notifyNewAppointment" checked />
                <span class="toggle-slider"></span>
              </label>
            </div>
            <div class="form-row">
              <label>Notify on New Contact</label>
              <label class="toggle-switch">
                <input type="checkbox" id="notifyNewContact" checked />
                <span class="toggle-slider"></span>
              </label>
            </div>
          </div>

          <div class="settings-section">
            <h3>📧 Email Configuration</h3>
            <div class="form-row">
              <label>Email Service</label>
              <div>
                <span class="pill" style="background:#22c55e">SMTP (Active)</span>
                <div class="info-text" style="margin-top: 8px;">
                  SMTP configuration is managed via environment variables (SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS)
                </div>
              </div>
            </div>
            <div class="form-row">
              <label>Test Email</label>
              <div style="display:flex;gap:8px;align-items:center">
                <input
                  class="input"
                  id="testEmail"
                  type="email"
                  placeholder="Enter email to test"
                  style="flex:1;max-width:300px"
                />
                <button
                  class="btn-sm"
                  id="testEmailBtn"
                  style="background:#667eea;color:white;border:none;padding:8px 16px;border-radius:6px;cursor:pointer"
                  >Send Test</button
                >
              </div>
            </div>
          </div>

          <div class="settings-section">
            <h3>🗄️ Database</h3>
            <div class="form-row">
              <label>Database Status</label>
              <div>
                <span class="pill" id="dbStatus">Checking...</span>
              </div>
            </div>
            <div class="form-row">
              <label>Backup Database</label>
              <button
                class="btn-sm"
                id="backupBtn"
                style="background:#667eea;color:white;border:none;padding:8px 16px;border-radius:6px;cursor:pointer"
                >Download Backup</button
              >
            </div>
          </div>

          <div class="settings-section">
            <h3>🎨 Appearance</h3>
            <div class="form-row">
              <label>Theme</label>
              <select class="select" id="theme">
                <option value="dark">Dark (Default)</option>
                <option value="light">Light</option>
                <option value="auto">Auto (System)</option>
              </select>
            </div>
            <div class="form-row">
              <label>Collapse Sidebar by default</label>
              <label class="toggle-switch">
                <input type="checkbox" id="sidebarCollapsed" />
                <span class="toggle-slider"></span>
              </label>
            </div>
            <div class="form-row">
              <label>Items Per Page</label>
              <select class="select" id="itemsPerPage">
                <option value="10">10</option>
                <option value="20" selected>20</option>
                <option value="50">50</option>
                <option value="100">100</option>
              </select>
            </div>
            <div class="form-row">
              <label>Compact Mode</label>
              <label class="toggle-switch">
                <input type="checkbox" id="compactMode" />
                <span class="toggle-slider"></span>
              </label>
            </div>
          </div>

          <div class="settings-section">
            <h3>⚙️ General Settings</h3>
            <div class="form-row">
              <label>Auto-refresh Interval</label>
              <select class="select" id="autoRefresh">
                <option value="0">Disabled</option>
                <option value="30" selected>30 seconds</option>
                <option value="60">1 minute</option>
                <option value="300">5 minutes</option>
              </select>
            </div>
            <div class="form-row">
              <label>Show Email Preview</label>
              <label class="toggle-switch">
                <input type="checkbox" id="showEmailPreview" checked />
                <span class="toggle-slider"></span>
              </label>
            </div>
            <div class="form-row">
              <label>Confirm Before Delete</label>
              <label class="toggle-switch">
                <input type="checkbox" id="confirmDelete" checked />
                <span class="toggle-slider"></span>
              </label>
            </div>
            <div class="form-row">
              <label>Show Timestamps</label>
              <label class="toggle-switch">
                <input type="checkbox" id="showTimestamps" checked />
                <span class="toggle-slider"></span>
              </label>
            </div>
          </div>

          <div class="settings-section">
            <h3>📄 Invoice Settings</h3>
            <div class="form-row">
              <label>Invoice Number Seed</label>
              <input class="input" id="invoiceNumberSeed" type="text" placeholder="25-26/JA001" />
            </div>
            <div class="form-row">
              <label>Default Due Days</label>
              <input class="input" id="invoiceDueDays" type="number" placeholder="7" />
            </div>
          </div>

          <div class="settings-section">
            <h3>📊 Dashboard Settings</h3>
            <div class="form-row">
              <label>Show Last 24h Stats</label>
              <label class="toggle-switch">
                <input type="checkbox" id="show24hStats" checked />
                <span class="toggle-slider"></span>
              </label>
            </div>
            <div class="form-row">
              <label>Show Pending Actions</label>
              <label class="toggle-switch">
                <input type="checkbox" id="showPendingActions" checked />
                <span class="toggle-slider"></span>
              </label>
            </div>
            <div class="form-row">
              <label>Default View</label>
              <select class="select" id="defaultView">
                <option value="dashboard">Dashboard</option>
                <option value="appointments">Appointments</option>
                <option value="contacts">Contacts</option>
                <option value="calendar">Calendar</option>
              </select>
            </div>
          </div>

          <div style="margin-top: 24px; display: flex; gap: 12px; justify-content: flex-end;">
            <button class="btn-primary" id="saveBtn" style="width:100%;padding:12px;font-size:16px;margin-top:20px"
              >Save Settings</button
            >
          </div>
        </div>
      </div>
      <footer class="main-footer">
        <strong>JyotirSetu Admin</strong><div class="float-end d-none d-sm-inline">AdminLTE theme</div>
      </footer>
    </div>

    <script is:inline>
      /**
       * @typedef {object} Settings
       * @property {string} theme
       * @property {number} itemsPerPage
       * @property {boolean} compactMode
       * @property {number} sessionDuration
       * @property {boolean} browserNotifications
       * @property {boolean} emailAlerts
       * @property {boolean} notifyNewAppointment
       * @property {boolean} notifyNewContact
       * @property {number} autoRefresh
       * @property {boolean} showEmailPreview
       * @property {boolean} confirmDelete
       * @property {boolean} showTimestamps
       */

      /** @type {Settings} */
      const DEFAULT_SETTINGS = {
        theme: 'dark',
        itemsPerPage: 20,
        compactMode: false,
        sessionDuration: 30,
        browserNotifications: false,
        emailAlerts: true,
        notifyNewAppointment: true,
        notifyNewContact: true,
        autoRefresh: 30,
        showEmailPreview: true,
        confirmDelete: true,
        showTimestamps: true,
      };

      /** @returns {Settings} */
      function getSettings() {
        try {
          const stored = localStorage.getItem('adminSettings');
          if (stored) return { ...DEFAULT_SETTINGS, ...JSON.parse(stored) };
        } catch (e) {
          console.error('Failed to parse settings', e);
        }
        return DEFAULT_SETTINGS;
      }

      /** @param {Partial<Settings>} newSettings */
      async function saveSettings(newSettings) {
        const current = getSettings();
        const updated = { ...current, ...newSettings };
        try {
          localStorage.setItem('adminSettings', JSON.stringify(updated));
        } catch (e) {
          console.error('Failed to save adminSettings:', e);
        }
        applySettings(updated);
        try {
          if (newSettings.theme != null) {
            await fetch('/api/admin/preferences', {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ key: 'theme', value: String(newSettings.theme) }),
            });
          }
          if (newSettings.sidebarCollapsed != null) {
            await fetch('/api/admin/preferences', {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ key: 'sidebarCollapsed', value: newSettings.sidebarCollapsed ? '1' : '0' }),
            });
          }
          if (newSettings.invoiceNumberSeed != null) {
            await fetch('/api/admin/preferences', {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ key: 'invoiceNumberSeed', value: String(newSettings.invoiceNumberSeed || '') }),
            });
          }
          if (newSettings.invoiceDueDays != null) {
            await fetch('/api/admin/preferences', {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ key: 'invoiceDueDays', value: String(newSettings.invoiceDueDays || 0) }),
            });
          }
        } catch (e) {
          console.error('Failed to save preferences:', e);
        }
      }

      /** @param {Settings} settings */
      function applySettings(settings) {
        // Theme
        let effective = settings.theme;
        if (effective === 'auto') {
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          effective = prefersDark ? 'dark' : 'light';
        }
        document.body.classList.toggle('dark-mode', effective === 'dark');
        document.body.classList.toggle('sidebar-collapse', !!settings.sidebarCollapsed);

        // Other settings
        setInputValue('theme', settings.theme);
        setInputValue('itemsPerPage', settings.itemsPerPage);
        setInputValue('sidebarCollapsed', !!settings.sidebarCollapsed);
        setInputValue('compactMode', settings.compactMode);
        setInputValue('sessionDuration', settings.sessionDuration);
        setInputValue('browserNotifications', settings.browserNotifications);
        setInputValue('emailAlerts', settings.emailAlerts);
        setInputValue('notifyNewAppointment', settings.notifyNewAppointment);
        setInputValue('notifyNewContact', settings.notifyNewContact);
        setInputValue('autoRefresh', settings.autoRefresh);
        setInputValue('showEmailPreview', settings.showEmailPreview);
        setInputValue('confirmDelete', settings.confirmDelete);
        setInputValue('showTimestamps', settings.showTimestamps);
        setInputValue('invoiceNumberSeed', settings.invoiceNumberSeed ?? '');
        setInputValue('invoiceDueDays', settings.invoiceDueDays ?? 7);
      }

      /**
       * @param {string} id
       * @param {string | number | boolean} value
       */
      function setInputValue(id, value) {
        const el = document.getElementById(id);
        if (!el) return;
        if (el.type === 'checkbox') {
          el.checked = !!value;
        } else {
          el.value = String(value);
        }
      }

      /**
       * @param {string} id
       * @returns {string | number | boolean}
       */
      function getInputValue(id) {
        const el = document.getElementById(id);
        if (!el) return null;
        if (el.type === 'checkbox') return el.checked;
        return el.value;
      }

      document.addEventListener('DOMContentLoaded', () => {
        const settings = getSettings();
        applySettings(settings);

        const saveBtn = document.getElementById('saveBtn');
        saveBtn?.addEventListener('click', () => {
          /** @type {Partial<Settings>} */
          const newSettings = {
            theme: getInputValue('theme'),
            itemsPerPage: Number(getInputValue('itemsPerPage')),
            compactMode: !!getInputValue('compactMode'),
            sidebarCollapsed: !!getInputValue('sidebarCollapsed'),
            sessionDuration: Number(getInputValue('sessionDuration')),
            browserNotifications: !!getInputValue('browserNotifications'),
            emailAlerts: !!getInputValue('emailAlerts'),
            notifyNewAppointment: !!getInputValue('notifyNewAppointment'),
            notifyNewContact: !!getInputValue('notifyNewContact'),
            autoRefresh: Number(getInputValue('autoRefresh')),
            showEmailPreview: !!getInputValue('showEmailPreview'),
            confirmDelete: !!getInputValue('confirmDelete'),
            showTimestamps: !!getInputValue('showTimestamps'),
            invoiceNumberSeed: String(getInputValue('invoiceNumberSeed') || ''),
            invoiceDueDays: Number(getInputValue('invoiceDueDays')),
          };
          saveSettings(newSettings);
          window.AdminNotify?.success('Settings saved');
        });

        // Load preferences from DB and apply
        (async () => {
          try {
            const tr = await fetch('/api/admin/preferences?key=theme').then((r) => r.json());
            if (tr?.ok && typeof tr.value === 'string') {
              setInputValue('theme', tr.value);
            }
            const sr = await fetch('/api/admin/preferences?key=sidebarCollapsed').then((r) => r.json());
            if (sr?.ok && sr.value != null) {
              setInputValue('sidebarCollapsed', sr.value === '1');
            }
            const ir = await fetch('/api/admin/preferences?key=invoiceNumberSeed').then((r) => r.json());
            if (ir?.ok && typeof ir.value === 'string') {
              setInputValue('invoiceNumberSeed', ir.value);
            }
            const dr = await fetch('/api/admin/preferences?key=invoiceDueDays').then((r) => r.json());
            if (dr?.ok && dr.value != null) {
              setInputValue('invoiceDueDays', dr.value);
            }
          } catch (e) {
            console.error('Failed to load preferences:', e);
          }
          applySettings(getSettings());
        })();

        // Check DB status
        fetch('/api/db-health')
          .then((res) => res.json())
          .then((data) => {
            const statusEl = document.getElementById('dbStatus');
            if (!statusEl) return;
            if (data.ok) {
              statusEl.textContent = 'Connected';
              statusEl.style.background = '#22c55e';
            } else {
              statusEl.textContent = 'Error';
              statusEl.style.background = '#ef4444';
            }
          });

        // Test email
        const testEmailBtn = document.getElementById('testEmailBtn');
        testEmailBtn?.addEventListener('click', async () => {
          const email = getInputValue('testEmail');
          if (!email || !/\S+@\S+\.\S+/.test(String(email))) {
            window.AdminNotify?.error('Invalid email', 'Please enter a valid email address');
            return;
          }
          const btn = document.getElementById('testEmailBtn');
          if (btn) {
            btn.textContent = 'Sending...';
            btn.disabled = true;
          }
          try {
            const res = await fetch('/api/test-email', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email }),
            });
            const result = await res.json();
            if (result.ok) window.AdminNotify?.success('Test email sent');
            else window.AdminNotify?.error('Email error', result.error || 'Failed to send');
          } catch (e) {
            window.AdminNotify?.error('Error occurred', e.message);
          }
          if (btn) {
            btn.textContent = 'Send Test';
            btn.disabled = false;
          }
        });

        // Backup DB
        const backupBtn = document.getElementById('backupBtn');
        backupBtn?.addEventListener('click', () => {
          window.location.href = '/api/admin/backup';
        });
        (function () {
          const btn = document.getElementById('toggleSidebarDesktop');
          function sync() {
            if (!btn) return;
            const c = document.body.classList.contains('sidebar-collapse');
            btn.textContent = c ? 'Show sidebar' : 'Hide sidebar';
          }
          async function toggle() {
            const c = document.body.classList.toggle('sidebar-collapse');
            sync();
            try {
              await fetch('/api/admin/preferences', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ key: 'sidebarCollapsed', value: c ? '1' : '0' }),
              });
            } catch (e) {
              console.error('Error saving sidebarCollapsed:', e);
            }
          }
          btn?.addEventListener('click', toggle);
          sync();
        })();
      });
    </script>
  </body><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/admin-lte@latest/dist/js/adminlte.min.js" defer></script>
</html>
