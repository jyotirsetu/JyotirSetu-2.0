---
import Favicons from '~/components/Favicons.astro';
import MobilePageSelect from '~/components/MobilePageSelect.astro';

interface Document {
  id: string;
  title: string;
  client_id?: string | null;
  entity_type?: string | null;
  entity_id?: string | null;
  mime_type?: string | null;
  size?: number | null;
  created_at: string;
}

interface ShareLink {
  token: string;
  document_id: string;
  expires_at?: string | null;
  created_at: string;
}

interface DownloadAudit {
  id: string;
  document_id: string;
  by_user?: string | null;
  downloaded_at: string;
  ip?: string | null;
}

let documentsList: Document[] = [];
let shareLinksList: ShareLink[] = [];
let downloadAuditsList: DownloadAudit[] = [];
let error: string | null = null;

try {
  const [docsRes, sharesRes, auditsRes] = await Promise.all([
    fetch(new URL('/api/admin/documents', Astro.url.origin).toString(), {
      headers: { Cookie: Astro.request.headers.get('Cookie') || '' },
    }),
    fetch(new URL('/api/admin/documents-share', Astro.url.origin).toString(), {
      headers: { Cookie: Astro.request.headers.get('Cookie') || '' },
    }),
    fetch(new URL('/api/admin/documents-audit', Astro.url.origin).toString(), {
      headers: { Cookie: Astro.request.headers.get('Cookie') || '' },
    })
  ]);
  
  if (docsRes.ok) {
    const docsResult = await docsRes.json();
    if (docsResult.ok && docsResult.data) {
      documentsList = docsResult.data;
    }
  }
  
  if (sharesRes.ok) {
    const sharesResult = await sharesRes.json();
    if (sharesResult.ok && sharesResult.data) {
      shareLinksList = sharesResult.data;
    }
  }
  
  if (auditsRes.ok) {
    const auditsResult = await auditsRes.json();
    if (auditsResult.ok && auditsResult.data) {
      downloadAuditsList = auditsResult.data;
    }
  }
} catch (e) {
  console.error('Failed to load data', e);
  error = 'Failed to load document sharing data';
}

// Group share links and audits by document
const sharesByDocument = shareLinksList.reduce((acc, share) => {
  if (!acc[share.document_id]) {
    acc[share.document_id] = [];
  }
  acc[share.document_id].push(share);
  return acc;
}, {} as Record<string, ShareLink[]>);

const auditsByDocument = downloadAuditsList.reduce((acc, audit) => {
  if (!acc[audit.document_id]) {
    acc[audit.document_id] = [];
  }
  acc[audit.document_id].push(audit);
  return acc;
}, {} as Record<string, DownloadAudit[]>);

function formatFileSize(bytes?: number | null): string {
  if (!bytes) return '-';
  if (bytes < 1024) return bytes + ' B';
  if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
  return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
}

function isExpired(expiresAt?: string | null): boolean {
  if (!expiresAt) return false;
  return new Date(expiresAt) < new Date();
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Documents Share – Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@latest/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="/admin.css?v=20251129" />
    <Favicons />
  </head>
  <body class="hold-transition sidebar-mini">
    <script is:inline>
      /* @ts-nocheck */
      (function () {
        function applyTheme(theme) {
          let t = theme;
          if (t === 'auto') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.body.classList.toggle('dark-mode', t === 'dark');
        }
        let theme = 'dark';
        let collapsed = false;
        try {
          const stored = localStorage.getItem('adminSettings');
          if (stored) {
            const s = JSON.parse(stored);
            if (s && typeof s === 'object') {
              if (s.theme) theme = s.theme;
              if (s.sidebarCollapsed != null) collapsed = !!s.sidebarCollapsed;
            }
          }
        } catch (e) {
          console.error('Error loading admin settings:', e);
        }
        applyTheme(theme);
        document.body.classList.toggle('sidebar-collapse', collapsed);
        try {
          Promise.all([
            fetch('/api/admin/preferences?key=theme').then(function (r) {
              return r.json();
            }),
            fetch('/api/admin/preferences?key=sidebarCollapsed').then(function (r) {
              return r.json();
            }),
          ])
            .then(function (rs) {
              const tr = rs[0],
                sr = rs[1];
              if (tr && tr.ok && typeof tr.value === 'string') applyTheme(tr.value);
              if (sr && sr.ok && sr.value != null) document.body.classList.toggle('sidebar-collapse', sr.value === '1');
            })
            .catch(function (err) {
              console.error('Error syncing preferences:', err);
            });
        } catch (e) {
          console.error('Error syncing preferences:', e);
        }
      })();
    </script>
    <div class="wrapper">
      <nav class="main-header navbar navbar-expand navbar-dark">
        <ul class="navbar-nav">
          <li class="nav-item">
            <MobilePageSelect />
          </li>
          <li class="nav-item"><a href="/admin/dashboard" class="nav-link">Dashboard</a></li>
        </ul>
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a href="/api/admin/logout" class="nav-link">Logout</a></li>
        </ul>
      </nav>
      <aside class="main-sidebar sidebar-dark-primary elevation-4" id="adminSidebar">
        <a href="/admin/dashboard" class="brand-link" style="display:flex;align-items:center;gap:8px">
          <img
            src="https://images.unsplash.com/vector-1763306579596-25a002c977df?q=80&w=1979&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
            alt="Brand"
            style="height:40px;width:auto;border-radius:0;box-shadow:0 2px 6px rgba(0,0,0,0.25)"
          />
        </a>
        <div class="sidebar">
          <nav class="mt-2">
            <ul class="nav nav-pills nav-sidebar flex-column" role="menu" data-accordion="false" data-widget="treeview">
              <li class="nav-item">
                <a href="/admin/dashboard" class="nav-link"><i class="nav-icon fas fa-gauge"></i><p>Dashboard</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/leads" class="nav-link"><i class="nav-icon fas fa-route"></i><p>Leads</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/appointments" class="nav-link"><i class="nav-icon fas fa-calendar-check"></i><p>Appointments</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/contacts" class="nav-link"><i class="nav-icon fas fa-comments"></i><p>Contacts</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/newsletter" class="nav-link"><i class="nav-icon fas fa-envelope-open-text"></i><p>Newsletter</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/calendar" class="nav-link"><i class="nav-icon fas fa-calendar"></i><p>Calendar</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/quotes" class="nav-link"><i class="nav-icon fas fa-file-invoice"></i><p>Quotations</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/after-service" class="nav-link"><i class="nav-icon fas fa-handshake"></i><p>After Service</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/remedies" class="nav-link"><i class="nav-icon fas fa-prescription-bottle-alt"></i><p>Remedies</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/activity-log" class="nav-link"><i class="nav-icon fas fa-list"></i><p>Activity Log</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/templates/email" class="nav-link"><i class="nav-icon fas fa-file-alt"></i><p>Email Templates</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/templates/payment" class="nav-link"><i class="nav-icon fas fa-file-invoice-dollar"></i><p>Payment Templates</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/client360" class="nav-link"><i class="nav-icon fas fa-user-circle"></i><p>Client 360°</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/users" class="nav-link"><i class="nav-icon fas fa-users-cog"></i><p>Users</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/tools/follow-hub/insights" class="nav-link"><i class="nav-icon fas fa-toolbox"></i><p>Follow Hub – Insights</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/settings" class="nav-link"><i class="nav-icon fas fa-gear"></i><p>Settings</p></a>
              </li>
            </ul>
          </nav>
        </div>
      </aside>

      <div class="content-wrapper">
    <section class="content">
      <div class="container-fluid">
        <div class="row">
          <div class="col-12">
            <div class="card">
              <div class="card-header">
                <h3 class="card-title">Documents</h3>
              </div>
              <div class="card-body">
                {error && (
                  <div class="alert alert-danger">{error}</div>
                )}
                
                {documentsList.length === 0 ? (
                  <div class="alert alert-info">
                    No documents found. Please upload documents first.
                    <a href="/admin/client360" class="btn btn-sm btn-primary ms-2">Go to Client 360</a>
                  </div>
                ) : (
                  <div class="table-responsive">
                    <table class="table table-bordered table-striped">
                      <thead>
                        <tr>
                          <th>Title</th>
                          <th>Type</th>
                          <th>Size</th>
                          <th>Created</th>
                          <th>Share Links</th>
                          <th>Downloads</th>
                          <th>Actions</th>
                        </tr>
                      </thead>
                      <tbody>
                        {documentsList.map((doc) => {
                          const shares = sharesByDocument[doc.id] || [];
                          const audits = auditsByDocument[doc.id] || [];
                          return (
                            <tr data-doc-id={doc.id}>
                              <td>{doc.title}</td>
                              <td>{doc.mime_type || '-'}</td>
                              <td>{formatFileSize(doc.size)}</td>
                              <td>{new Date(doc.created_at).toLocaleDateString()}</td>
                              <td>
                                <span class="badge bg-info">{shares.length}</span>
                                {shares.length > 0 && (
                                  <div class="small text-muted">
                                    {shares.filter(s => !isExpired(s.expires_at)).length} active
                                  </div>
                                )}
                              </td>
                              <td>
                                <span class="badge bg-secondary">{audits.length}</span>
                              </td>
                              <td>
                                <button class="btn btn-sm btn-primary create-share-link" data-doc-id={doc.id}>
                                  <i class="fas fa-link"></i> Share
                                </button>
                                <button class="btn btn-sm btn-info view-details" data-doc-id={doc.id}>
                                  <i class="fas fa-eye"></i> Details
                                </button>
                              </td>
                            </tr>
                          );
                        })}
                      </tbody>
                    </table>
                  </div>
                )}
              </div>
            </div>
          </div>
        </div>

        <!-- Document Details Modal -->
        <div class="modal fade" id="documentDetailsModal" tabindex="-1">
          <div class="modal-dialog modal-lg">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title" id="documentDetailsTitle">Document Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
              </div>
              <div class="modal-body">
                <div id="documentDetailsContent">
                  <!-- Content will be loaded dynamically -->
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Create Share Link Modal -->
        <div class="modal fade" id="shareLinkModal" tabindex="-1">
          <div class="modal-dialog">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title">Create Share Link</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
              </div>
              <div class="modal-body">
                <form id="shareLinkForm">
                  <input type="hidden" id="shareDocId" />
                  <div class="mb-3">
                    <label for="expiresAt" class="form-label">Expiration Date (Optional)</label>
                    <input type="date" class="form-control" id="expiresAt" />
                    <small class="form-text text-muted">Leave empty for no expiration</small>
                  </div>
                </form>
                <div id="shareLinkResult" class="alert alert-success d-none">
                  <strong>Share Link Created:</strong>
                  <div id="shareLinkUrl" class="mt-2"></div>
                  <button class="btn btn-sm btn-outline-secondary mt-2" id="copyShareLink">
                    <i class="fas fa-copy"></i> Copy Link
                  </button>
                </div>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="createShareLinkBtn">Create Link</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script>
    (function() {
      let csrfToken = '';
      let currentShareLink = '';
      
      async function fetchCsrfToken() {
        try {
          const res = await fetch('/api/csrf-token', { credentials: 'include' });
          const data = await res.json();
          csrfToken = data.token || '';
        } catch (e) {
          console.error('Failed to fetch CSRF token', e);
        }
      }

      fetchCsrfToken();

      const bs = (typeof window !== 'undefined' && window && (window['bootstrap'])) ? (window['bootstrap']) : null;
      const shareLinkModal = bs ? new bs.Modal(document.getElementById('shareLinkModal')) : null;
      const documentDetailsModal = bs ? new bs.Modal(document.getElementById('documentDetailsModal')) : null;
      const shareDocIdEl = document.getElementById('shareDocId');
      const expiresAtEl = document.getElementById('expiresAt');
      const shareLinkResultEl = document.getElementById('shareLinkResult');
      const createShareLinkBtnEl = document.getElementById('createShareLinkBtn');
      const shareLinkUrlEl = document.getElementById('shareLinkUrl');

      document.addEventListener('click', async (e) => {
        const target = e && e.target ? e.target : null;
        if ((target instanceof Element) && target.closest('.create-share-link')) {
          const docId = ((target.closest('.create-share-link') as HTMLElement) && (target.closest('.create-share-link') as HTMLElement).dataset ? (target.closest('.create-share-link') as HTMLElement).dataset.docId : '') || '';
          await showCreateShareLink(docId);
        } else if ((target instanceof Element) && target.closest('.view-details')) {
          const docId = ((target.closest('.view-details') as HTMLElement) && (target.closest('.view-details') as HTMLElement).dataset ? (target.closest('.view-details') as HTMLElement).dataset.docId : '') || '';
          await showDocumentDetails(docId);
        }
      });

      if (createShareLinkBtnEl) createShareLinkBtnEl.addEventListener('click', async () => { await createShareLink(); });

      document.getElementById('copyShareLink')?.addEventListener('click', async () => {
        if (currentShareLink) {
          try {
            await navigator.clipboard.writeText(currentShareLink);
            const btn = document.getElementById('copyShareLink');
            if (!btn) return;
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-check"></i> Copied!';
            btn.classList.remove('btn-outline-secondary');
            btn.classList.add('btn-success');
            setTimeout(() => {
              btn.innerHTML = originalText;
              btn.classList.remove('btn-success');
              btn.classList.add('btn-outline-secondary');
            }, 2000);
          } catch (e) {
            console.error('Failed to copy link', e);
          }
        }
      });

      async function showCreateShareLink(docId) {
        if (shareDocIdEl && shareDocIdEl instanceof HTMLInputElement) shareDocIdEl.value = docId;
        if (shareLinkResultEl) shareLinkResultEl.classList.add('d-none');
        if (createShareLinkBtnEl) createShareLinkBtnEl.style.display = 'block';
        if (expiresAtEl && expiresAtEl instanceof HTMLInputElement) expiresAtEl.value = '';
        
        // Set default expiration to 7 days from now
        const defaultDate = new Date();
        defaultDate.setDate(defaultDate.getDate() + 7);
        if (expiresAtEl && expiresAtEl instanceof HTMLInputElement) expiresAtEl.value = defaultDate.toISOString().split('T')[0];
        
        currentShareLink = '';
        if (shareLinkModal) shareLinkModal.show();
      }

      async function createShareLink() {
        const docId = (shareDocIdEl && shareDocIdEl instanceof HTMLInputElement) ? shareDocIdEl.value : '';
        const expiresAt = (expiresAtEl && expiresAtEl instanceof HTMLInputElement) ? expiresAtEl.value : '';

        if (!docId) {
          alert('Document ID is required');
          return;
        }

        try {
          const res = await fetch('/api/admin/documents-share', {
            method: 'POST',
            headers: { 
              'Content-Type': 'application/json',
              'X-CSRF-Token': csrfToken
            },
            body: JSON.stringify({
              document_id: docId,
              expires_at: expiresAt || null
            }),
            credentials: 'include'
          });

          const data = await res.json();
          if (data.ok && data.token) {
            currentShareLink = `${window.location.origin}/api/admin/documents-share/${data.token}`;
            if (shareLinkUrlEl) shareLinkUrlEl.textContent = currentShareLink;
            if (shareLinkResultEl) shareLinkResultEl.classList.remove('d-none');
            if (createShareLinkBtnEl) createShareLinkBtnEl.style.display = 'none';
          } else {
            alert('Failed to create share link: ' + (data.error || 'Unknown error'));
          }
        } catch (e) {
          console.error('Failed to create share link', e);
          alert('Failed to create share link');
        }
      }

      async function showDocumentDetails(docId) {
        try {
          // Fetch document details, share links, and audit logs
          const [docRes, sharesRes, auditsRes] = await Promise.all([
            fetch(`/api/admin/documents?id=${docId}`, { credentials: 'include' }),
            fetch(`/api/admin/documents-share?document_id=${docId}`, { credentials: 'include' }),
            fetch(`/api/admin/documents-audit?document_id=${docId}`, { credentials: 'include' })
          ]);

          const docData = await docRes.json();
          const sharesData = await sharesRes.json();
          const auditsData = await auditsRes.json();

          if (docData.ok && docData.data) {
            const doc = docData.data;
            const shares = sharesData.data || [];
            const audits = auditsData.data || [];

            let content = `
              <div class="row">
                <div class="col-md-6">
                  <h6>Document Information</h6>
                  <table class="table table-sm">
                    <tr><td><strong>Title:</strong></td><td>${doc.title}</td></tr>
                    <tr><td><strong>Type:</strong></td><td>${doc.mime_type || '-'}</td></tr>
                    <tr><td><strong>Size:</strong></td><td>${formatFileSize(doc.size)}</td></tr>
                    <tr><td><strong>Created:</strong></td><td>${new Date(doc.created_at).toLocaleString()}</td></tr>
                  </table>
                </div>
                <div class="col-md-6">
                  <h6>Statistics</h6>
                  <table class="table table-sm">
                    <tr><td><strong>Share Links:</strong></td><td>${shares.length}</td></tr>
                    <tr><td><strong>Active Links:</strong></td><td>${shares.filter(s => !isExpired(s.expires_at)).length}</td></tr>
                    <tr><td><strong>Total Downloads:</strong></td><td>${audits.length}</td></tr>
                    <tr><td><strong>Unique Users:</strong></td><td>${new Set(audits.map(a => a.by_user).filter(Boolean)).size}</td></tr>
                  </table>
                </div>
              </div>
            `;

            if (shares.length > 0) {
              content += `
                <h6 class="mt-3">Share Links</h6>
                <div class="table-responsive">
                  <table class="table table-sm table-striped">
                    <thead>
                      <tr>
                        <th>Token</th>
                        <th>Created</th>
                        <th>Expires</th>
                        <th>Status</th>
                        <th>Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                      ${shares.map(share => `
                        <tr>
                          <td><code>${share.token.substring(0, 8)}...</code></td>
                          <td>${new Date(share.created_at).toLocaleString()}</td>
                          <td>${share.expires_at ? new Date(share.expires_at).toLocaleString() : 'Never'}</td>
                          <td>
                            <span class="badge ${isExpired(share.expires_at) ? 'bg-danger' : 'bg-success'}">
                              ${isExpired(share.expires_at) ? 'Expired' : 'Active'}
                            </span>
                          </td>
                          <td>
                            <button class="btn btn-sm btn-outline-primary copy-link" data-token="${share.token}">
                              <i class="fas fa-copy"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger delete-share" data-token="${share.token}">
                              <i class="fas fa-trash"></i>
                            </button>
                          </td>
                        </tr>
                      `).join('')}
                    </tbody>
                  </table>
                </div>
              `;
            }

            if (audits.length > 0) {
              content += `
                <h6 class="mt-3">Download History</h6>
                <div class="table-responsive">
                  <table class="table table-sm table-striped">
                    <thead>
                      <tr>
                        <th>User</th>
                        <th>Downloaded At</th>
                        <th>IP Address</th>
                      </tr>
                    </thead>
                    <tbody>
                      ${audits.map(audit => `
                        <tr>
                          <td>${audit.by_user || 'Anonymous'}</td>
                          <td>${new Date(audit.downloaded_at).toLocaleString()}</td>
                          <td>${audit.ip || '-'}</td>
                        </tr>
                      `).join('')}
                    </tbody>
                  </table>
                </div>
              `;
            }

            const detailsContentEl = document.getElementById('documentDetailsContent');
            const detailsTitleEl = document.getElementById('documentDetailsTitle');
            if (detailsContentEl) detailsContentEl.innerHTML = content;
            if (detailsTitleEl) detailsTitleEl.textContent = `Document: ${doc.title}`;
            if (documentDetailsModal) documentDetailsModal.show();
          }
        } catch (e) {
          console.error('Failed to load document details', e);
          alert('Failed to load document details');
        }
      }

      // Handle copy link and delete share actions within the modal
      const documentDetailsContentEl = document.getElementById('documentDetailsContent');
      documentDetailsContentEl?.addEventListener('click', async (e) => {
        const target = e && e.target ? e.target : null;
        if ((target instanceof Element) && target.closest('.copy-link')) {
          const token = ((target.closest('.copy-link') as HTMLElement) && (target.closest('.copy-link') as HTMLElement).dataset ? (target.closest('.copy-link') as HTMLElement).dataset.token : '') || '';
          const link = `${window.location.origin}/api/admin/documents-share/${token}`;
          try {
            await navigator.clipboard.writeText(link);
            const btn = (target instanceof Element) ? target.closest('.copy-link') as HTMLElement : null;
            if (!btn) return;
            const originalHTML = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-check"></i>';
            btn.classList.remove('btn-outline-primary');
            btn.classList.add('btn-success');
            setTimeout(() => {
              btn.innerHTML = originalHTML;
              btn.classList.remove('btn-success');
              btn.classList.add('btn-outline-primary');
            }, 2000);
          } catch (err) {
            console.error('Failed to copy link', err);
          }
        } else if ((target instanceof Element) && target.closest('.delete-share')) {
          const token = ((target.closest('.delete-share') as HTMLElement) && (target.closest('.delete-share') as HTMLElement).dataset ? (target.closest('.delete-share') as HTMLElement).dataset.token : '') || '';
          if (confirm('Are you sure you want to delete this share link?')) {
            await deleteShareLink(token);
          }
        }
      });

      async function deleteShareLink(token) {
        try {
          const res = await fetch(`/api/admin/documents-share?token=${token}`, {
            method: 'DELETE',
            headers: { 
              'Content-Type': 'application/json',
              'X-CSRF-Token': csrfToken
            },
            credentials: 'include'
          });
          
          const data = await res.json();
          if (data.ok) {
            location.reload();
          } else {
            alert('Failed to delete share link');
          }
        } catch (e) {
          console.error('Failed to delete share link', e);
          alert('Failed to delete share link');
        }
      }

      function formatFileSize(bytes) {
        if (!bytes) return '-';
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
      }

      function isExpired(expiresAt) {
        if (!expiresAt) return false;
        return new Date(expiresAt) < new Date();
      }


    })();
  </script>
</div>
</body>
</html>
