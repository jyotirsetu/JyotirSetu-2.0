---
export const prerender = false;
import Favicons from '~/components/Favicons.astro';
import MobilePageSelect from '~/components/MobilePageSelect.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WhatsApp Templates – Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@latest/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="/admin.css?v=20251129" />
    <Favicons />
  </head>
  <body class="hold-transition sidebar-mini">
    <script is:inline>
      /* @ts-nocheck */
      (function () {
        function applyTheme(theme) {
          let t = theme;
          if (t === 'auto') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.body.classList.toggle('dark-mode', t === 'dark');
        }
        let theme = 'dark';
        let collapsed = false;
        try {
          const stored = localStorage.getItem('adminSettings');
          if (stored) {
            const s = JSON.parse(stored);
            if (s && typeof s === 'object') {
              if (s.theme) theme = s.theme;
              if (s.sidebarCollapsed != null) collapsed = !!s.sidebarCollapsed;
            }
          }
        } catch (e) {
          console.error('Error loading admin settings:', e);
        }
        applyTheme(theme);
        document.body.classList.toggle('sidebar-collapse', collapsed);
        try {
          Promise.all([
            fetch('/api/admin/preferences?key=theme').then(function (r) {
              return r.json();
            }),
            fetch('/api/admin/preferences?key=sidebarCollapsed').then(function (r) {
              return r.json();
            }),
          ])
            .then(function (rs) {
              const tr = rs[0],
                sr = rs[1];
              if (tr && tr.ok && typeof tr.value === 'string') applyTheme(tr.value);
              if (sr && sr.ok && sr.value != null) document.body.classList.toggle('sidebar-collapse', sr.value === '1');
            })
            .catch(function (err) {
              console.error('Error syncing preferences:', err);
            });
        } catch (e) {
          console.error('Error syncing preferences:', e);
        }
      })();
    </script>
    <div class="wrapper">
      <nav class="main-header navbar navbar-expand navbar-dark">
        <ul class="navbar-nav">
          <li class="nav-item">
            <MobilePageSelect />
          </li>
          <li class="nav-item"><a href="/admin/dashboard" class="nav-link">Dashboard</a></li>
        </ul>
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a href="/api/admin/logout" class="nav-link">Logout</a></li>
        </ul>
      </nav>
      <aside class="main-sidebar sidebar-dark-primary elevation-4" id="adminSidebar">
        <a href="/admin/dashboard" class="brand-link" style="display:flex;align-items:center;gap:8px">
          <img
            src="https://images.unsplash.com/vector-1763306579596-25a002c977df?q=80&w=1979&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
            alt="Brand"
            style="height:40px;width:auto;border-radius:0;box-shadow:0 2px 6px rgba(0,0,0,0.25)"
          />
        </a>
        <div class="sidebar">
          <nav class="mt-2">
            <ul class="nav nav-pills nav-sidebar flex-column" role="menu" data-accordion="false" data-widget="treeview">
              <li class="nav-item">
                <a href="/admin/dashboard" class="nav-link"><i class="nav-icon fas fa-gauge"></i><p>Dashboard</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/leads" class="nav-link"><i class="nav-icon fas fa-route"></i><p>Leads</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/appointments" class="nav-link"><i class="nav-icon fas fa-calendar-check"></i><p>Appointments</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/contacts" class="nav-link"><i class="nav-icon fas fa-comments"></i><p>Contacts</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/newsletter" class="nav-link"><i class="nav-icon fas fa-envelope-open-text"></i><p>Newsletter</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/calendar" class="nav-link"><i class="nav-icon fas fa-calendar"></i><p>Calendar</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/quotes" class="nav-link"><i class="nav-icon fas fa-file-invoice"></i><p>Quotations</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/after-service" class="nav-link"><i class="nav-icon fas fa-handshake"></i><p>After Service</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/remedies" class="nav-link"><i class="nav-icon fas fa-prescription-bottle-alt"></i><p>Remedies</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/activity-log" class="nav-link"><i class="nav-icon fas fa-list"></i><p>Activity Log</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/templates/email" class="nav-link"><i class="nav-icon fas fa-file-alt"></i><p>Email Templates</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/templates/payment" class="nav-link"><i class="nav-icon fas fa-file-invoice-dollar"></i><p>Payment Templates</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/client360" class="nav-link"><i class="nav-icon fas fa-user-circle"></i><p>Client 360°</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/users" class="nav-link"><i class="nav-icon fas fa-users-cog"></i><p>Users</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/tools/follow-hub/insights" class="nav-link"><i class="nav-icon fas fa-toolbox"></i><p>Follow Hub – Insights</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/settings" class="nav-link"><i class="nav-icon fas fa-gear"></i><p>Settings</p></a>
              </li>
            </ul>
          </nav>
        </div>
      </aside>

      <div class="content-wrapper">
        <div class="topbar">
          <strong>WhatsApp Templates</strong>
          <div style="display:flex; gap:8px; align-items:center">
            <span class="pill">Personalize and copy</span>
          </div>
        </div>
        <div class="toolbar">
          <input class="input" id="waName" placeholder="Name" />
          <input class="input" id="waPhone" placeholder="Phone (digits only)" />
          <input class="input" id="waService" placeholder="Service" />
          <select class="select" id="waStatus">
            <option>pending</option>
            <option>confirmed</option>
            <option>rescheduled</option>
            <option>cancelled</option>
          </select>
        </div>
        <div class="cards" id="templates"></div>
      </div>
    </div>

    <script is:inline>
      if (typeof window !== 'undefined') {
        function formatWaPhone(input) {
          const digits = String(input || '').replace(/\D/g, '');
          if (digits.startsWith('91')) return digits;
          if (digits.length === 10) return '91' + digits;
          return digits;
        }
        const nameInput = document.getElementById('waName');
        const phoneInput = document.getElementById('waPhone');
        const serviceInput = document.getElementById('waService');
        const statusSelect = document.getElementById('waStatus');
        const qs = new URLSearchParams(window.location.search);
        nameInput.value = qs.get('name') || '';
        phoneInput.value = qs.get('phone') || '';
        serviceInput.value = qs.get('service') || '';
        statusSelect.value = qs.get('status') || 'pending';

        let dbTemplates = [];
        const fallback = [
          {
            key: 'pending',
            text: '🕐 Hi {name}, your appointment request for {service} is pending. ID: {appointment_id}. We’ll confirm soon. Follow Hub: https://follow.jyotirsetu.com',
          },
          {
            key: 'confirmed',
            text: '✅ Confirmed: {service} on {date} at {time} ({method}). ID: {appointment_id}. Details: https://follow.jyotirsetu.com',
          },
          {
            key: 'rescheduled',
            text: '🔁 Rescheduled: {service}. New {date} {time} ({method}). ID: {appointment_id}. Details: https://follow.jyotirsetu.com',
          },
          {
            key: 'cancelled_user',
            text: '❌ Cancelled as requested: {service}. ID: {appointment_id}. Book again anytime: https://follow.jyotirsetu.com',
          },
          {
            key: 'cancelled_provider',
            text: '⚠️ Cancelled by provider: {service}. ID: {appointment_id}. We’ll offer alternate slots shortly. Updates: https://follow.jyotirsetu.com',
          },
        ];

        async function loadTemplates() {
          try {
            const res = await fetch('/api/admin/templates?type=whatsapp', { credentials: 'include' });
            const j = await res.json();
            dbTemplates = Array.isArray(j.data) ? j.data : [];
          } catch {
            dbTemplates = [];
          }
        }

        function render() {
          const p = {
            name: nameInput.value,
            phone: phoneInput.value,
            service: serviceInput.value,
            status: statusSelect.value,
            appointment_id: qs.get('id') || '',
          };
          const list = dbTemplates.length ? dbTemplates : fallback;
          const html = list
            .map((t) => {
              const base = (t.text || '')
                .replaceAll('{name}', p.name)
                .replaceAll('{service}', p.service)
                .replaceAll('{status}', p.status)
                .replaceAll('{date}', '')
                .replaceAll('{time}', '')
                .replaceAll('{appointment_id}', p.appointment_id || '');
              const link = `https://wa.me/${encodeURIComponent(formatWaPhone(p.phone))}?text=${encodeURIComponent(base)}`;
              const title = (t.key || '').charAt(0).toUpperCase() + (t.key || '').slice(1);
              return `<div class="card"><strong>${title || 'Template'}</strong><p class="muted" style="margin:8px 0 12px">${base}</p><a class="btn-sm" href="${link}" target="_blank">Open in WhatsApp</a></div>`;
            })
            .join('');
          document.getElementById('templates').innerHTML = html;
        }

        (async () => {
          await loadTemplates();
          render();
          ['input', 'change'].forEach((ev) => {
            nameInput.addEventListener(ev, render);
            phoneInput.addEventListener(ev, render);
            serviceInput.addEventListener(ev, render);
            statusSelect.addEventListener(ev, render);
          });
        })();
      }
    </script>

  </body>
</html>
