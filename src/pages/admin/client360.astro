  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@latest/dist/css/adminlte.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6/css/all.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/admin-lte@latest/dist/js/adminlte.min.js" defer></script>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      if (typeof window === 'undefined') return;
      try { window.addEventListener('unhandledrejection', function(e){ try { e.preventDefault(); console.warn('Unhandled promise rejection suppressed'); } catch (err) { console.warn(err); } }); } catch (err) { console.warn(err); }
      try { window.addEventListener('error', function(_e){ try { console.warn('Window error'); } catch (err) { console.warn(err); } }); } catch (err) { console.warn(err); }
      
    // CSRF Helper
      const csrf = () => (document.cookie.match(/csrf_token=([^;]+)/)||[])[1]||'';
      
      // Ensure CSRF token is available
      if (!csrf()) {
        try { fetch('/api/csrf-token', { credentials: 'include' }).catch(() => {}); } catch { /* ignore */ }
      }

      let customers = [];

      async function loadCustomers(){
        let allRows = [];
        let page = 1;
        const limit = 100;
        let hasMore = true;
        let totalLoaded = 0;
        const countEl = document.getElementById('customerCount');
        if (countEl) countEl.textContent = '(loading…)';
        while (hasMore) {
          try {
            const c = new AbortController();
            const timer = setTimeout(()=>{ try { c.abort(); } catch { /* ignore */ } }, 15000);
            const res = await fetch(`/api/admin/appointments?page=${page}&limit=${limit}`, { signal: c.signal });
            const j = await res.json();
            const rows = Array.isArray(j.data) ? j.data : [];
            const pagination = j.pagination || {};
            if (!rows.length) {
              hasMore = false;
            } else {
              allRows = allRows.concat(rows);
              totalLoaded += rows.length;
              if (pagination.total && totalLoaded >= pagination.total) {
                hasMore = false;
              } else {
                page++;
                if (page > 50) hasMore = false;
              }
            }
            clearTimeout(timer);
          } catch {
            hasMore = false;
          }
        }
        const processed = [];
        const seen = new Set();
        allRows.forEach(function(r){
          const email = String(r.email || '').trim();
          const name = String(r.name || '').trim();
          const phone = String(r.phone || '').trim();
          if (!email || !name) return;
          const key = `${name.toLowerCase()}|${email.toLowerCase()}|${phone.toLowerCase()}`;
          if (!seen.has(key)){
            seen.add(key);
            processed.push({ name, email, phone });
          }
        });
        customers = processed.sort(function(a,b){ return String(a.name||'').localeCompare(String(b.name||'')); });
        if (countEl) countEl.textContent = `(${customers.length} customers)`;
      }
      function showCustomerDropdown(list){
        const dd = document.getElementById('customerDropdown');
        if (!dd) return;
        if (!list.length){ dd.style.display='none'; return; }
        dd.innerHTML = list.map(function(c){
          return `<a class="dropdown-item" href="#" data-name="${c.name}" data-email="${c.email}" data-phone="${c.phone}"><strong>${c.name}</strong><br><small class="text-muted">${c.email}${c.phone? ' • '+c.phone:''}</small></a>`;
        }).join('');
        dd.style.display='block';
        dd.querySelectorAll('.dropdown-item').forEach(function(it){
          it.addEventListener('click', function(e){
            e.preventDefault();
            const phone = this.getAttribute('data-phone') || '';
            const email = this.getAttribute('data-email') || '';
            if (phone) {
              window.location.href = `/admin/client360?phone=${encodeURIComponent(phone)}`;
            } else if (email) {
              window.location.href = `/admin/client360?email=${encodeURIComponent(email)}`;
            }
          });
        });
      }
      document.getElementById('customerSearch')?.addEventListener('input', function(){
        const q = String(this.value||'').toLowerCase().trim();
        if (!q) { const dd=document.getElementById('customerDropdown'); if(dd) dd.style.display='none'; return; }
        const filtered = customers.filter(function(c){
          return String(c.name||'').toLowerCase().includes(q) || String(c.email||'').toLowerCase().includes(q) || String(c.phone||'').toLowerCase().includes(q);
        });
        showCustomerDropdown(filtered.slice(0,12));
      });
      document.getElementById('customerSearch')?.addEventListener('focus', function(){
        const q = String(this.value||'').toLowerCase().trim();
        if (!q) return;
        const filtered = customers.filter(function(c){
          return String(c.name||'').toLowerCase().includes(q) || String(c.email||'').toLowerCase().includes(q) || String(c.phone||'').toLowerCase().includes(q);
        });
        showCustomerDropdown(filtered.slice(0,12));
      });
      document.addEventListener('click', function(e){
        const target = e && e.target ? e.target : null;
        const isInsideSearch = (target instanceof Element) && !!target.closest('#customerSearch');
        const isInsideDD = (target instanceof Element) && !!target.closest('#customerDropdown');
        if (!isInsideSearch && !isInsideDD) {
          const dd=document.getElementById('customerDropdown'); if(dd) dd.style.display='none';
        }
      });
      document.getElementById('syncCustomers')?.addEventListener('click', async function(){
        const icon = this.querySelector('i');
        icon?.classList.add('fa-spin');
        this.disabled = true;
        try { await loadCustomers(); icon?.classList.remove('fa-spin'); icon?.classList.add('fa-check'); setTimeout(()=>{ icon?.classList.remove('fa-check'); icon?.classList.add('fa-sync-alt'); },1000); }
