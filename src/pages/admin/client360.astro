      background: linear-gradient(180deg, var(--panel), var(--panel-2));
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 16px;
      margin-bottom: 12px;
      color: var(--text);
    }
    .info-box {
      margin-bottom: 0;
    }
    .info-box-icon {
      height: 60px;
      width: 60px;
      line-height: 60px;
    }
    .info-box-content {
      padding: 5px 10px;
    }
  </style>
</Layout>
