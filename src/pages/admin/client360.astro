                              <span class="info-box-text">Total Appointments</span>
                              <span class="info-box-number">{clientData.appointments.length}</span>
                            </div>
                          </div>
                        </div>
                        <div class="col-6">
                          <div class="info-box">
                            <span class="info-box-icon bg-success">
                              <i class="fas fa-comments" />
                            </span>
                            <div class="info-box-content">
                              <span class="info-box-text">Total Contacts</span>
                              <span class="info-box-number">{clientData.contacts.length}</span>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="col-md-8">
                  <div class="card card-success">
                    <div class="card-header">
                      <h3 class="card-title">Appointment History</h3>
                    </div>
                    <div class="card-body">
                      {clientData.appointments.length > 0 ? (
                        <div class="timeline">
                          {clientData.appointments.map((apt) => (
                            <Fragment>
                              <div class="time-label">
                                <span class="bg-success">{new Date(apt.date).toLocaleDateString()}</span>
                              </div>
                              <div>
                                <i class="fas fa-calendar bg-primary" />
                                <div class="timeline-item">
                                  <span class="time">
                                    <i class="fas fa-clock" /> {apt.time}
                                  </span>
                                  <h3 class="timeline-header">
                                    {apt.service} – {apt.name || clientData.client.name}
                                  </h3>
                                  <div class="timeline-body">
                                    <p>
                                      <strong>Appt ID:</strong> {apt.customer_appointment_id || apt.id}
                                    </p>
                                    <p>
                                      <strong>Status:</strong>
                                      <span
                                        class={`badge ${
                                          apt.status === 'confirmed'
                                            ? 'badge-success'
                                            : apt.status === 'cancelled'
                                              ? 'badge-danger'
                                              : apt.status === 'completed'
                                                ? 'badge-info'
                                                : 'badge-warning'
                                        }`}
                                      >
                                        {apt.status}
                                      </span>
                                    </p>
                                    <p>
                                      <strong>Payment:</strong>
                                      <span
                                        class={`badge ${
                                          apt.payment_status === 'paid'
                                            ? 'badge-success'
                                            : apt.payment_status === 'partial'
                                              ? 'badge-warning'
                                              : 'badge-danger'
                                        }`}
                                      >
                                        {apt.payment_status}
                                      </span>
                                    </p>
                                    {apt.consultation_method && (
                                      <p>
                                        <strong>Method:</strong> {apt.consultation_method}
                                      </p>
                                    )}
                                  </div>
                                </div>
                              </div>
                            </Fragment>
                          ))}
                        </div>
                      ) : (
                        <p class="text-muted text-center">No appointments found</p>
                      )}
                    </div>
                  </div>

                  <div class="card card-warning">
                    <div class="card-header">
                      <h3 class="card-title">Payment Ledger</h3>
                    </div>
                    <div class="card-body">
                      {clientData.payments.length > 0 ? (
                        <div class="table-responsive">
                          <table class="table table-bordered">
                            <thead>
                              <tr>
                                <th>Date</th>
                                <th>Amount</th>
                                <th>Mode</th>
                                <th>Reference</th>
                                <th>Note</th>
                              </tr>
                            </thead>
                            <tbody>
                              {clientData.payments.map((payment) => (
                                <tr>
                                  <td>{new Date(payment.created_at).toLocaleDateString()}</td>
                                  <td>
                                    <span class="text-success font-weight-bold">
                                      ₹{payment.amount.toLocaleString()}
                                    </span>
                                  </td>
                                  <td>
                                    <span class="badge badge-info">{payment.mode}</span>
                                  </td>
                                  <td>{payment.reference || 'N/A'}</td>
                                  <td>{payment.note || 'N/A'}</td>
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                      ) : (
                        <p class="text-muted text-center">No payments recorded</p>
                      )}
                    </div>
                  </div>

                  <div class="card card-info">
                    <div class="card-header">
                      <h3 class="card-title">Contact History</h3>
                    </div>
                    <div class="card-body">
                      {clientData.contacts.length > 0 ? (
                        <div class="table-responsive">
                          <table class="table table-bordered">
                            <thead>
                              <tr>
                                <th>Date</th>
                                <th>Subject</th>
                                <th>Status</th>
                                <th>Priority</th>
                              </tr>
                            </thead>
                            <tbody>
                              {clientData.contacts.map((contact) => (
                                <tr>
                                  <td>{new Date(contact.created_at).toLocaleDateString()}</td>
                                  <td>{contact.subject}</td>
                                  <td>
                                    <span
                                      class={`badge ${
                                        contact.status === 'resolved'
                                          ? 'badge-success'
                                          : contact.status === 'pending'
                                            ? 'badge-warning'
                                            : 'badge-info'
                                      }`}
                                    >
                                      {contact.status}
                                    </span>
                                  </td>
                                  <td>
                                    <span
                                      class={`badge ${
                                        contact.priority === 'high'
                                          ? 'badge-danger'
                                          : contact.priority === 'medium'
                                            ? 'badge-warning'
                                            : 'badge-secondary'
                                      }`}
                                    >
                                      {contact.priority}
                                    </span>
                                  </td>
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                      ) : (
                        <p class="text-muted text-center">No contacts found</p>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </div>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@latest/dist/css/adminlte.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6/css/all.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/admin-lte@latest/dist/js/adminlte.min.js" defer></script>

  <script is:inline>
    (function(){
      if (typeof window === 'undefined') return;
      let customers = [];
      async function loadCustomers(){
        let allRows = [];
        let page = 1;
        const limit = 100;
        let hasMore = true;
        let totalLoaded = 0;
        while (hasMore) {
          try {
            const res = await fetch(`/api/admin/appointments?page=${page}&limit=${limit}`);
            const j = await res.json();
            const rows = Array.isArray(j.data) ? j.data : [];
            const pagination = j.pagination || {};
            if (!rows.length) {
              hasMore = false;
            } else {
              allRows = allRows.concat(rows);
              totalLoaded += rows.length;
              if (pagination.total && totalLoaded >= pagination.total) {
                hasMore = false;
              } else {
                page++;
                if (page > 50) hasMore = false;
              }
            }
          } catch {
            hasMore = false;
          }
        }
        const processed = [];
        const seen = new Set();
        allRows.forEach(function(r){
          const email = String(r.email || '').trim();
          const name = String(r.name || '').trim();
          const phone = String(r.phone || '').trim();
          if (!email || !name) return;
          const key = `${name.toLowerCase()}|${email.toLowerCase()}|${phone.toLowerCase()}`;
          if (!seen.has(key)){
            seen.add(key);
            processed.push({ name, email, phone });
          }
        });
        customers = processed.sort(function(a,b){ return String(a.name||'').localeCompare(String(b.name||'')); });
        const countEl = document.getElementById('customerCount');
        if (countEl) countEl.textContent = `(${customers.length} customers)`;
      }
      function showCustomerDropdown(list){
        const dd = document.getElementById('customerDropdown');
        if (!dd) return;
        if (!list.length){ dd.style.display='none'; return; }
        dd.innerHTML = list.map(function(c){
          return `<a class="dropdown-item" href="#" data-name="${c.name}" data-email="${c.email}" data-phone="${c.phone}"><strong>${c.name}</strong><br><small class="text-muted">${c.email}${c.phone? ' • '+c.phone:''}</small></a>`;
        }).join('');
        dd.style.display='block';
        dd.querySelectorAll('.dropdown-item').forEach(function(it){
          it.addEventListener('click', function(e){
            e.preventDefault();
            const email = this.getAttribute('data-email') || '';
            if (email) {
              window.location.href = `/admin/client360?email=${encodeURIComponent(email)}`;
            }
          });
        });
      }
      document.getElementById('customerSearch')?.addEventListener('input', function(){
        const q = String(this.value||'').toLowerCase().trim();
        if (!q) { const dd=document.getElementById('customerDropdown'); if(dd) dd.style.display='none'; return; }
        const filtered = customers.filter(function(c){
          return String(c.name||'').toLowerCase().includes(q) || String(c.email||'').toLowerCase().includes(q) || String(c.phone||'').toLowerCase().includes(q);
        });
        showCustomerDropdown(filtered.slice(0,12));
      });
      document.getElementById('customerSearch')?.addEventListener('focus', function(){
        const q = String(this.value||'').toLowerCase().trim();
        if (!q) return;
        const filtered = customers.filter(function(c){
          return String(c.name||'').toLowerCase().includes(q) || String(c.email||'').toLowerCase().includes(q) || String(c.phone||'').toLowerCase().includes(q);
        });
        showCustomerDropdown(filtered.slice(0,12));
      });
      document.addEventListener('click', function(e){
        if (!e.target.closest('#customerSearch') && !e.target.closest('#customerDropdown')) {
          const dd=document.getElementById('customerDropdown'); if(dd) dd.style.display='none';
        }
      });
      document.getElementById('syncCustomers')?.addEventListener('click', async function(){
        const icon = this.querySelector('i');
        icon?.classList.add('fa-spin');
        this.disabled = true;
        try { await loadCustomers(); icon?.classList.remove('fa-spin'); icon?.classList.add('fa-check'); setTimeout(()=>{ icon?.classList.remove('fa-check'); icon?.classList.add('fa-sync-alt'); },1000); }
        catch{ icon?.classList.remove('fa-spin'); icon?.classList.add('fa-exclamation-triangle'); setTimeout(()=>{ icon?.classList.remove('fa-exclamation-triangle'); icon?.classList.add('fa-sync-alt'); },2000); }
        finally { this.disabled = false; }
      });
      loadCustomers();
    })();
  </script>

  <style>
    .profile-avatar {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      font-weight: bold;
    }
    .timeline-item {
      background: linear-gradient(180deg, var(--panel), var(--panel-2));
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 16px;
      margin-bottom: 12px;
      color: var(--text);
    }
    .info-box {
      margin-bottom: 0;
    }
    .info-box-icon {
      height: 60px;
      width: 60px;
      line-height: 60px;
    }
    .info-box-content {
      padding: 5px 10px;
    }
  </style>
</Layout>
