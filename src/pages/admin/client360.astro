      // Render checklist as toggles and persist changes
      (function initChecklist(){
        try {
          document.querySelectorAll('tr').forEach(function(row){
            const delEl = row.querySelector('.deleteTask'); const id = delEl ? delEl.getAttribute('data-task-id') || '' : '';
            const cell = row.querySelector('td:nth-child(4)');
            if (!id || !cell) return;
            const raw = cell.textContent || '';
            let arr = [];
            try {
              const parsed = JSON.parse(raw);
              if (Array.isArray(parsed)) {
                arr = parsed.map(function(it){
                  if (typeof it === 'string') return { text: it, done: false };
                  if (it && typeof it === 'object') return { text: String((it.text||it.title||'')), done: !!(it.done) };
                  return { text: String(it), done: false };
                });
              }
            } catch {
              arr = raw ? raw.split(',').map(function(s){ return { text: s.trim(), done: false }; }) : [];
            }
            if (!arr.length) return;
            cell.innerHTML = arr.map(function(it, idx){ return `<label style="display:block;font-weight:normal"><input type="checkbox" class="taskItem" data-task-id="${id}" data-idx="${idx}" ${it.done ? 'checked':''} /> ${it.text}</label>`; }).join('');
          });
        } catch { /* ignore */ }
      })();

      document.addEventListener('change', function(ev){
        const t = ev.target instanceof Element ? ev.target : null;
        const item = t && t instanceof HTMLInputElement && t.classList.contains('taskItem') ? t : null;
        if (!item) return;
        const id = item.getAttribute('data-task-id') || '';
        const row = item.closest('tr');
        const cell = row ? row.querySelector('td:nth-child(4)') : null;
        if (!cell) return;
        const current = Array.from(cell.querySelectorAll('.taskItem')).map(function(cb){ return { text: (cb.parentElement && cb.parentElement.textContent ? cb.parentElement.textContent.replace(/^[^A-Za-z0-9]+/,'').trim() : ''), done: (cb instanceof HTMLInputElement ? cb.checked : false) }; });
        fetch('/api/admin/fulfillment', { method:'POST', headers:{ 'Content-Type':'application/json','X-CSRF-Token': csrf() }, body: JSON.stringify({ action:'update_fields', id, checklist: current }) })
          .then(res => res.json().then(j => ({ ok: res.ok, j })))
          .then(({ ok }) => { if (!ok) alert('Failed to update checklist'); })
          .catch(() => alert('Failed to update checklist'));
      });

      // Appointment Notes: table rendering and periodic sync
      function renderNotesTable(items){
        const list = document.getElementById('clientNotesList');
        const empty = document.getElementById('clientNotesEmpty');
        if (!list || !empty) return;
        if (!items.length) { list.innerHTML=''; empty.style.display='block'; return; }
        empty.style.display='none';
        list.innerHTML = items.map(function(n){ return `<tr><td>${n.when}</td><td>${n.text}</td></tr>`; }).join('');
      }
      function refreshNotes(){
        const ld = document.getElementById('notesLoading');
        if (ld) ld.style.display='block';
        const url = new URL('/api/admin/notes', window.location.origin);
        const email = new URLSearchParams(window.location.search).get('email')||'';
        const phone = new URLSearchParams(window.location.search).get('phone')||'';
        url.searchParams.set('entity_type','appointment');
        if (email) url.searchParams.set('email', email);
        if (phone) url.searchParams.set('phone', phone);
        fetch(url.toString(), { credentials:'include' })
          .then(r=>r.json())
          .then(j=>{ const rows = Array.isArray(j.data)? j.data: []; const mapped = rows.map(function(n){ return { when: String(n.created_at||''), text: String(n.note_text||'') }; }).sort(function(a,b){ return String(b.when).localeCompare(String(a.when)); }); renderNotesTable(mapped); })
          .catch(()=>{})
          .finally(()=>{ if (ld) ld.style.display='none'; });
      }
      document.getElementById('refreshApptNotes')?.addEventListener('click', refreshNotes);
      try { setInterval(refreshNotes, 30000); } catch { /* ignore */ }
      refreshNotes();

      (function indicateLinkedProfiles(){
        try {
          const ind = document.getElementById('linkedProfilesIndicator'); if (!ind) return;
          const phone = String(clientData?.client?.phone||'').trim(); if (!phone) return;
          const emails = new Set();
          (clientData?.appointments||[]).forEach(function(ap){ if (ap && ap.name) { /* keep */ } });
          (clientData?.appointments||[]).forEach(function(ap){ if (ap && ap.name!=null) { /* noop */ } });
          (clientData?.appointments||[]).forEach(function(ap){ if (ap && ap.email) emails.add(String(ap.email)); });
          if (emails.size > 1) ind.style.display = 'block';
        } catch { /* ignore */ }
      })();

      document.getElementById('updateDocBtn')?.addEventListener('click', function(){
        const idEl4 = document.getElementById('editDocId'); const id = (idEl4 && idEl4 instanceof HTMLInputElement) ? idEl4.value : '';
        const tEl2 = document.getElementById('editDocTitle'); const title = (tEl2 && tEl2 instanceof HTMLInputElement) ? tEl2.value || '' : '';
        const uEl2 = document.getElementById('editDocUrl'); const url = (uEl2 && uEl2 instanceof HTMLInputElement) ? uEl2.value || '' : '';
        const errDiv = document.getElementById('editDocError'); if (errDiv) { errDiv.style.display='none'; errDiv.textContent=''; }
        fetch('/api/admin/documents', { method:'POST', headers:{ 'Content-Type':'application/json','X-CSRF-Token': csrf() }, body: JSON.stringify({ action:'update', id, title, storage_url: url }) })
          .then(res => res.json().then(j => ({ ok: res.ok, j })))
          .then(({ ok }) => {
            if (ok) {
              const bs = window.bootstrap || (typeof bootstrap !== 'undefined' ? bootstrap : null);
              const el = document.getElementById('editDocumentModal'); if (bs && bs.Modal && el) { try { (bs.Modal.getInstance(el) || new bs.Modal(el)).hide(); } catch { /* ignore */ } }
              location.reload();
            } else {
              if (errDiv) { errDiv.textContent = 'Failed to update document'; errDiv.style.display='block'; } else alert('Failed to update document');
            }
          }).catch(() => { if (errDiv) { errDiv.textContent = 'Failed to update document'; errDiv.style.display='block'; } else alert('Failed to update document'); });
      });
    });
  </script>

  <style>
