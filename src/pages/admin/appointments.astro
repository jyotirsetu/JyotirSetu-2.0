    <script is:inline>
      // Convenience: normalize invalid date ranges and render chips
      function normalizeDateRange(){
        const fromEl = document.getElementById('fromDate');
        const toEl = document.getElementById('toDate');
        const f = fromEl?.value || '';
        const t = toEl?.value || '';
        if (f && t && f > t) {
          // Auto-correct: set `to` = `from`
          if (toEl) toEl.value = f;
          window.AdminNotify?.info?.('Adjusted date range: To matched From');
        }
      }
      function renderActiveChips(){
        const chipsEl = document.getElementById('activeChips'); if (!chipsEl) return;
        const svcEl = document.getElementById('serviceFilter');
        const srcEl = document.getElementById('sourceFilter');
        const stEl = document.getElementById('statusFilter');
        const fromEl = document.getElementById('fromDate');
        const toEl = document.getElementById('toDate');
        const svc = (svcEl instanceof HTMLSelectElement) ? (svcEl.value || '') : '';
        const src = (srcEl instanceof HTMLSelectElement) ? (srcEl.value || '') : '';
        const st = (stEl instanceof HTMLSelectElement) ? (stEl.value || '') : '';
        const f = (fromEl instanceof HTMLInputElement) ? (fromEl.value || '') : '';
        const t = (toEl instanceof HTMLInputElement) ? (toEl.value || '') : '';
        const chips = [];
        if (svc) chips.push({ key:'serviceFilter', label:`Service: ${svc}` });
        if (src) chips.push({ key:'sourceFilter', label:`Source: ${src}` });
        if (st) chips.push({ key:'statusFilter', label:`Status: ${st}` });
        if (f) chips.push({ key:'fromDate', label:`From: ${f}` });
        if (t) chips.push({ key:'toDate', label:`To: ${t}` });
        const hasAny = chips.length > 0;
        chipsEl.innerHTML = hasAny 
          ? chips.map(c=>`<button class="pill" data-clear="${c.key}">${c.label} ✕</button>`).join('') + 
            `<button class="pill" data-clear="__all__">Clear all ✕</button>`
          : '';
        chipsEl.querySelectorAll('[data-clear]').forEach(btn=>{
          btn.addEventListener('click', (e)=>{
            const t = e.currentTarget; const key = (t instanceof Element) ? (t.getAttribute('data-clear') || '') : '';
            if (!key) return;
            if (key === '__all__') {
              ['serviceFilter','sourceFilter','statusFilter','fromDate','toDate'].forEach(id=>{ const el = document.getElementById(id); if (el instanceof HTMLInputElement || el instanceof HTMLSelectElement) { el.value = ''; } });
            } else {
              const el = document.getElementById(key); if (el instanceof HTMLInputElement || el instanceof HTMLSelectElement) { el.value = ''; }
              // If clearing from/to, keep the other intact
            }
            window.loadPage?.(1);
            renderActiveChips();
          });
        });
      }
      // Date inputs: validate and reload
      document.getElementById('fromDate')?.addEventListener('change', ()=>{ normalizeDateRange(); window.loadPage?.(1); renderActiveChips(); });
      document.getElementById('toDate')?.addEventListener('change', ()=>{ normalizeDateRange(); window.loadPage?.(1); renderActiveChips(); });
      // Preset: Last 30 days
      document.getElementById('preset30')?.addEventListener('click', ()=>{
        const fromEl = document.getElementById('fromDate');
        const toEl = document.getElementById('toDate');
        const d = new Date(); const to = d.toISOString().slice(0,10);
        d.setDate(d.getDate()-30); const from = d.toISOString().slice(0,10);
        if (fromEl instanceof HTMLInputElement) fromEl.value = from; if (toEl instanceof HTMLInputElement) toEl.value = to;
        window.loadPage?.(1); renderActiveChips();
      });
      // Other filters: update chips on change
      ['serviceFilter','sourceFilter','statusFilter'].forEach(id=>{
        document.getElementById(id)?.addEventListener('change', ()=>{ renderActiveChips(); });
      });
      renderActiveChips();
    </script>
