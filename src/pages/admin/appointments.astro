    <!-- Add Appointment Modal -->
    <div class="modal" id="addModal">
      <div class="modal-content">
        <div class="modal-header">
          <h3>Add New Appointment</h3>
          <button class="close-btn" id="closeModal">&times;</button>
        </div>
        <form id="addForm">
          <div class="form-group">
            <label>Name *</label>
            <input class="input" name="name" required />
          </div>
          <div class="form-group">
            <label>Email *</label>
            <input class="input" type="email" name="email" required />
          </div>
          <div class="form-group">
            <label>Phone *</label>
            <input class="input" name="phone" required />
          </div>
          <div class="form-group">
            <label>Service *</label>
            <select class="select" name="service" required>
              <option value="">Choose your service...</option>
              <option value="🔮 Astrology">🔮 Astrology</option>
              <option value="💎 Gemstone Consultation">💎 Gemstone Consultation</option>
              <option value="✋ Palmistry">✋ Palmistry</option>
              <option value="🔢 Numerology">🔢 Numerology</option>
              <option value="💼 Career & Finance">💼 Career & Finance</option>
              <option value="💕 Matchmaking">💕 Matchmaking</option>
              <option value="📚 Study / Education">📚 Study / Education</option>
              <option value="🏢 Corporate Consultation">🏢 Corporate Consultation</option>
              <option value="✨ Other Reason">✨ Other Reason</option>
            </select>
          </div>
          <div class="form-group">
            <label>Date *</label>
            <input class="input" type="date" name="date" required />
          </div>
          <div class="form-group">
            <label>Time *</label>
            <input class="input" type="time" name="time" required />
          </div>
          <div class="form-group">
            <label>Consultation Method *</label>
            <select class="select" name="consultation_method" required>
              <option value="">Select method</option>
              <option>In-Person</option>
              <option>Video Call</option>
              <option>Phone Call</option>
