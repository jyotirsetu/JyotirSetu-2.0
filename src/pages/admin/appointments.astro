---
export const prerender = false;
import Favicons from '~/components/Favicons.astro';
import AdminNavbar from '~/components/AdminNavbar.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Appointments – Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@latest/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="/admin.css?v=20251129" />
    <Favicons />
    <script src="/js/admin-notify.js" defer></script>

    <style>
      .modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(2, 6, 23, 0.6);
        z-index: 1000;
        align-items: center;
        justify-content: center;
      }
      .modal.active {
        display: flex;
      }
      .modal-content {
        background: #0f172a;
        padding: 28px;
        border-radius: 16px;
        max-width: 640px;
        width: 90%;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 30px 80px rgba(15, 23, 42, 0.8);
        border: 1px solid rgba(148, 163, 184, 0.2);
      }
      .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        border-bottom: 1px solid rgba(148, 163, 184, 0.2);
        padding-bottom: 16px;
      }
      .modal-header h3 {
        margin: 0;
        font-size: 20px;
        font-weight: 700;
        color: #e2e8f0;
      }
      .close-btn {
        background: none;
        border: none;
        font-size: 28px;
        cursor: pointer;
        padding: 0;
        width: 32px;
        height: 32px;
        color: #94a3b8;
        line-height: 1;
      }
      .close-btn:hover {
        color: #e2e8f0;
      }
      .form-group {
        margin-bottom: 20px;
      }
      .form-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        font-size: 14px;
        color: #94a3b8;
      }
      .form-group .input,
      .form-group .select {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid rgba(148, 163, 184, 0.25);
        border-radius: 8px;
        background: #0b1220;
        color: #e5e7eb;
        font-size: 14px;
      }
      .form-group .input:focus,
      .form-group .select:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.25);
      }
      .form-group .input::placeholder {
        color: #64748b;
      }
      .form-group textarea.input {
        resize: vertical;
        min-height: 80px;
        font-family: inherit;
      }
      .pagination {
        display: flex;
        gap: 8px;
        align-items: center;
        justify-content: center;
        margin: 20px 0;
      }
      .pagination button {
        padding: 8px 12px;
        border: 1px solid #d1d5db;
        background: #ffffff;
        color: #374151;
        cursor: pointer;
        border-radius: 6px;
        font-size: 14px;
      }
      .pagination button:hover:not(:disabled) {
        background: #f3f4f6;
        border-color: #9ca3af;
      }
      .pagination button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }
      .pagination button.active {
        background: #667eea;
        color: #ffffff;
        border-color: #667eea;
      }
      .pagination span {
        margin-left: 12px;
        color: #6b7280;
        font-size: 14px;
      }
      .source-tag {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
      }
      .source-tag.manual {
        background: #fef3c7;
        color: #92400e;
      }
      .source-tag.system {
        background: #dbeafe;
        color: #1e40af;
      }
      /* Loading overlay */
      #loadingOverlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(2, 6, 23, 0.6);
        backdrop-filter: saturate(120%) blur(2px);
        z-index: 999;
        align-items: center;
        justify-content: center;
      }
      #loadingOverlay.active {
        display: flex;
      }
      .spinner {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: 3px solid #3b82f6;
        border-top-color: transparent;
        animation: spin 0.9s linear infinite;
      }
      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }
      .spinner-label {
        margin-top: 10px;
        color: #cbd5e1;
        font-size: 14px;
      }
      /* Skeleton rows */
      .skeleton-row { display:flex; gap:12px; align-items:center; padding:10px 12px; }
      .skeleton-box { background: linear-gradient(90deg, #1f2a44 25%, #243652 50%, #1f2a44 75%); background-size:200% 100%; animation: shimmer 1.2s infinite; border-radius:8px; }
      .skeleton-box.sm { width:80px; height:14px; }
      .skeleton-box.md { width:160px; height:14px; }
      .skeleton-box.lg { width:220px; height:14px; }
      @keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
    </style>
  </head>
  <body class="hold-transition sidebar-mini">
    <button class="sidebar-toggle" aria-label="Open Admin Menu" id="sidebarToggle">☰</button>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
    <script is:inline>
      (function () {
        try {
          if (!('render' in window)) {
            window.__realRender = window.__realRender || function(){};
            window.render = function(rows){ try { window.__realRender(rows); } catch { /* ignore */ } };
          }
        } catch { /* ignore */ }
        function applyTheme(theme) {
          let t = theme;
          if (t === 'auto') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.body.classList.toggle('dark-mode', t === 'dark');
        }
        let theme = 'dark';
        let collapsed = false;
        try {
          const stored = localStorage.getItem('adminSettings');
          if (stored) {
            const s = JSON.parse(stored);
            if (s && typeof s === 'object') {
              if (s.theme) theme = s.theme;
              if (s.sidebarCollapsed != null) collapsed = !!s.sidebarCollapsed;
            }
          }
        } catch (e) {
          console.error('Error loading admin settings:', e);
        }
        applyTheme(theme);
        document.body.classList.toggle('sidebar-collapse', collapsed);
        try {
          Promise.all([
            fetch('/api/admin/preferences?key=theme', { credentials: 'include' }).then(function (r) {
              return r.json();
            }),
            fetch('/api/admin/preferences?key=sidebarCollapsed', { credentials: 'include' }).then(function (r) {
              return r.json();
            }),
          ])
            .then(function (rs) {
              const tr = rs[0],
                sr = rs[1];
              if (tr && tr.ok && typeof tr.value === 'string') applyTheme(tr.value);
              if (sr && sr.ok && sr.value != null) document.body.classList.toggle('sidebar-collapse', sr.value === '1');
            })
            .catch(function (err) {
              console.error('Error syncing preferences:', err);
            });
        } catch (e) {
          console.error('Error syncing preferences:', e);
        }
      })();
    </script>
    <div class="wrapper">
      <AdminNavbar />
      <!-- legacy navbar removed -->
      <!--
      <nav class="main-header navbar navbar-expand navbar-dark">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button" aria-label="Toggle sidebar"
              ><i class="fas fa-bars"></i></a
            >
          </li>
          <li class="nav-item"><a href="/admin/dashboard" class="nav-link">Dashboard</a></li>
        </ul>
        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
            <button class="btn btn-sm btn-outline-secondary" id="toggleSidebarDesktop">Hide sidebar</button>
          </li>
          <li class="nav-item"><a href="/api/admin/logout" class="nav-link">Logout</a></li>
        </ul>
      </nav>
      -->
