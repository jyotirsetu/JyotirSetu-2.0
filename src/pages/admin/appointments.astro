                .replaceAll('{time}', params.time || '')
                .replaceAll('{method}', params.method || '')
                .replaceAll('{appointment_id}', params.appointment_id || params.id || '');
              const text = base.replace(/\r?\n/g, '\n').normalize('NFC');
              const link = `https://api.whatsapp.com/send?phone=${encodeURIComponent(formatWaPhone(params.phone))}&text=${encodeURIComponent(text)}`;
              
              fetch('/api/admin/activity', {
