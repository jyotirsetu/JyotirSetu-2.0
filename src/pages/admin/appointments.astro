            if (!href) return;
            const url = new URL(href, location.origin);
            const params = Object.fromEntries(url.searchParams.entries());
            
            try {
              const res = await fetch('/api/admin/templates?type=whatsapp', { credentials: 'include' });
              const tpl = await res.json();
              const m = (tpl.data || []).find((x) => x.key === params.status);
              const base = (m?.text || `Hello {name}, your appointment for {service} is {status}.`)
                .replaceAll('{name}', params.name || '')
                .replaceAll('{service}', params.service || '')
