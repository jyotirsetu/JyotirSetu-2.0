                >
              </li>
              <li class="nav-item">
                <a href="/admin/settings" class="nav-link"><i class="nav-icon fas fa-gear"></i><p>Settings</p></a>
              </li>
            </ul>
          </nav>
        </div>
      </aside>
      <div class="content-wrapper">
        <section class="content-header">
          <div class="container-fluid">
            <div class="row mb-2">
              <div class="col-sm-6"><h1>Appointments</h1></div>
              <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                  <li class="breadcrumb-item"><a href="/admin/dashboard">Home</a></li>
                  <li class="breadcrumb-item active">Appointments</li>
                </ol>
              </div>
            </div>
          </div>
        </section>
        <section class="content">
          <div class="container-fluid">
            <div class="toolbar toolbar-card">
              <button class="btn btn-primary" id="addAppointmentBtn">+ Add Appointment</button>
              <button class="btn btn-sm btn-info" id="columnsBtn">☰ Columns</button>
              <button class="btn btn-sm btn-success" id="exportBtn">📥 Export CSV</button>
              <button class="btn btn-sm btn-success" id="waUpcomingBtn">WA Reminders</button>
              <button class="btn btn-sm btn-warning" id="waFollowupsBtn">WA Follow-ups</button>
              <a class="btn btn-sm btn-secondary" href="/admin/templates/payment">Payment Templates</a>
              <span class="pill">Manage and contact clients</span>
              
            </div>
            <div class="toolbar toolbar-card">
              <input class="input" id="search" placeholder="Search name, email, phone" style="width:220px" />
              <select class="select" id="serviceFilter">
                <option value="">All services</option>
              </select>
              <select class="select" id="sourceFilter">
                <option value="">All sources</option>
                <option value="system">System</option>
                <option value="manual">Manual</option>
              </select>
              <select class="select" id="statusFilter">
                <option value="">All status</option>
                <option>pending</option>
                <option>confirmed</option>
                <option>rescheduled</option>
                <option>cancelled</option>
                <option>scheduled</option>
                <option>completed</option>
              </select>
              <!-- Moved view controls alongside All status (row 1) -->
              <input class="input" id="viewName" placeholder="View name" style="width:140px" />
              <button class="btn-sm" id="saveViewBtn" style="background:#10b981; color:#fff; border:none"
                >Save View</button
              >
              <button class="btn-sm" id="deleteViewBtn" style="background:#ef4444; color:#fff; border:none"
                >Delete View</button
              >
              <button class="btn-sm" id="refreshBtn" style="background:#3b82f6; color:#fff; border:none">Refresh</button
              >

              <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap">
                <span class="muted" style="color:#6b7280">Date range:</span>
                <input class="input" type="date" id="fromDate" placeholder="From" />
                <input class="input" type="date" id="toDate" placeholder="To" />
                <button
                  class="btn-sm"
                  id="presetToday"
                  style="background:#f3f4f6; color:#374151; border:1px solid #d1d5db">Today</button
                >
                <button class="btn-sm" id="preset7" style="background:#f3f4f6; color:#374151; border:1px solid #d1d5db"
