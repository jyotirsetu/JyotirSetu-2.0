      function applyFilters(all) {
        const qEl = document.getElementById('search');
        const sEl = document.getElementById('serviceFilter');
        const srcEl = document.getElementById('sourceFilter');
        const stEl = document.getElementById('statusFilter');
        const q = (qEl?.value || '').toLowerCase();
        const s = sEl?.value || '';
        const src = srcEl?.value || '';
        const st = (stEl?.value || '').toLowerCase();
        return all.filter(
          (r) =>
            (!q || (r.name + ' ' + r.email + ' ' + r.phone).toLowerCase().includes(q)) &&
            (!s || r.service === s) &&
            (!src || (r.source || 'system') === src) &&
            (!st || (r.status || 'pending').toLowerCase() === st)
        );
      }

      async function loadPage(page) {
        currentPage = page;
        showLoading(true);
        try {
          allData = await fetchData(page);
          const filtered = applyFilters(allData);
          showLoading(false);
          render(filtered);
          try { if(typeof window.render === 'function') window.render(filtered); } catch (e) { console.debug(e); }
          requestAnimationFrame(function(){
            try { render(filtered); } catch (e) { console.debug(e); }
          });
          renderPagination();
          if ((filtered?.length || 0) === 0 && (paginationData?.total || 0) > 0) {
            try {
              await new Promise(function (r) { setTimeout(r, 300); });
              const again = await fetchData(page);
              const filtered2 = applyFilters(again);
              if (filtered2.length) {
                render(filtered2);
                try { if(typeof window.render === 'function') window.render(filtered2); } catch (e) { console.debug(e); }
                renderPagination();
              }
            } catch (e) { console.debug(e); }
          }
        } catch (e) {
          console.error('loadPage error', e);
          const wrap = document.getElementById('tableWrap');
          if (wrap) wrap.innerHTML = '<p class="muted">Unable to render appointments at the moment.</p>';
        }
        // ensure loading overlay stays off
        showLoading(false);
      }
      // Expose for other script blocks on the page
      window.loadPage = loadPage;
      window.AppointmentsRender = render;

