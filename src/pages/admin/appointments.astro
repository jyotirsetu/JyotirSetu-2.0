    <!-- Export Columns Modal -->
    <div class="modal" id="columnsModal">
      <div class="modal-content">
        <div class="modal-header">
          <h3>Choose Export Columns</h3>
          <button class="close-btn" id="columnsClose">&times;</button>
        </div>
        <div id="columnsList"></div>
        <div style="display:flex; gap:8px; justify-content:flex-end; margin-top:16px">
          <button
            class="btn"
            id="columnsSave"
            style="background:#667eea; color:white; border:none; padding:8px 16px; border-radius:6px">Save</button
          >
        </div>
      </div>
    </div>

    <script is:inline>
      // Global Error Handler - Removed
      // Debug logging - Removed
      let currentPage = 1;
      let paginationData = { page: 1, totalPages: 1, total: 0 };
      let statusCounts = {};
      let allData = [];
      let currentNotesEntityId = null;
      let currentNotesEntityType = 'appointment';

      function getCsrfToken() {
        const match = document.cookie.match(/csrf_token=([^;]+)/);
        return match ? decodeURIComponent(match[1]) : '';
      }

      function formatWaPhone(input) {
        const digits = String(input || '').replace(/\D/g, '');
        if (digits.startsWith('91')) return digits;
        if (digits.length === 10) return '91' + digits;
        return digits;
      }

      async function fetchData(page = 1) {
        const fromEl = document.getElementById('fromDate');
        const toEl = document.getElementById('toDate');
        const searchEl = document.getElementById('search');
        const params = new URLSearchParams({ page: String(page), limit: '20' }); // Increased limit for better visibility
        if (fromEl?.value) params.set('from', fromEl.value);
        if (toEl?.value) params.set('to', toEl.value);
        if (searchEl?.value) params.set('q', searchEl.value);
        try {
          const res = await fetch(`/api/admin/appointments?${params.toString()}`, {
            credentials: 'include',
            keepalive: false,
            cache: 'no-store',
          });
          if (!res.ok) throw new Error(`HTTP error ${res.status}`);
          const json = await res.json();
          paginationData = json.pagination || { page: 1, totalPages: 1, total: 0 };
          statusCounts = json.statusCounts || {};
          return Array.isArray(json?.data) ? json.data : [];
        } catch (e1) {
          const msg1 = e1 instanceof Error ? e1.message : String(e1);
          console.error('fetchData error:', msg1);
          if (
            msg1.includes('ERR_ABORTED') ||
            msg1.includes('The user aborted a request') ||
            msg1.includes('AbortError') ||
            msg1.includes('Failed to fetch')
          ) {
            await new Promise(function (r) { setTimeout(r, 250); });
            try {
              const res2 = await fetch(`/api/admin/appointments?${params.toString()}`, {
                credentials: 'include',
                keepalive: false,
                cache: 'no-store',
              });
              if (!res2.ok) throw new Error(`Retry HTTP error ${res2.status}`);
              const json2 = await res2.json();
              paginationData = json2.pagination || { page: 1, totalPages: 1, total: 0 };
              statusCounts = json2.statusCounts || {};
              return Array.isArray(json2?.data) ? json2.data : [];
            } catch (e2) {
              console.debug('appointments fetch retry error', e2);
            }
          } else {
            console.debug('appointments fetch error', e1);
            window.AdminNotify?.error?.('Failed to load appointments', msg1);
            const wrap = document.getElementById('tableWrap');
            if (wrap) wrap.innerHTML = `<div class="alert alert-danger">Failed to load appointments: ${msg1}</div>`;
          }
          return allData || [];
        }
      }

      function renderPagination() {
        const pagEl = document.getElementById('pagination');
        if (!pagEl) return;
        if (paginationData.totalPages <= 1) {
          pagEl.innerHTML = `<div style="padding:10px;text-align:center;color:#6b7280;font-size:14px">Showing all ${paginationData.total} records</div>`;
          return;
        }
        let html = '<div class="pagination">';
        html += `<button ${currentPage === 1 ? 'disabled' : ''} id="prevPage">‹ Prev</button>`;
        for (let i = 1; i <= paginationData.totalPages; i++) {
          if (i === 1 || i === paginationData.totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) {
            html += `<button class="${i === currentPage ? 'active' : ''}" data-page="${i}">${i}</button>`;
          } else if (i === currentPage - 3 || i === currentPage + 3) {
            html += `<span>...</span>`;
          }
        }
        html += `<button ${currentPage === paginationData.totalPages ? 'disabled' : ''} id="nextPage">Next ›</button>`;
        html += `<span style="margin-left:12px; color:#666;">Page ${currentPage} of ${paginationData.totalPages} (${paginationData.total} total)</span>`;
        html += '</div>';
        pagEl.innerHTML = html;

        document.getElementById('prevPage')?.addEventListener('click', () => {
          if (currentPage > 1) loadPage(currentPage - 1);
        });
        document.getElementById('nextPage')?.addEventListener('click', () => {
          if (currentPage < paginationData.totalPages) loadPage(currentPage + 1);
        });
        document.querySelectorAll('[data-page]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const p = btn.getAttribute('data-page');
            if (p) loadPage(parseInt(p));
          });
        });
      }

      const STATUS_BADGE = {
        pending: 'badge text-bg-warning',
        confirmed: 'badge text-bg-primary',
        rescheduled: 'badge text-bg-info',
        cancelled: 'badge text-bg-danger',
        scheduled: 'badge text-bg-info',
        completed: 'badge text-bg-success',
      };
      function statusBadgeClass(s) {
        return STATUS_BADGE[(s || 'pending').toLowerCase()] || 'badge badge-secondary';
      }

      function renderStatusCell(r) {
        const s = (r.status || 'pending').toLowerCase();
        return `<span class="${statusBadgeClass(s)}">${s}</span> <button class="btn btn-sm btn-outline-secondary statusEdit" data-id="${r.id}" title="Edit"><i class="fas fa-pen"></i></button>`;
      }

      function paymentBadgeClass(s) {
        const v = (s || 'unpaid').toLowerCase();
        if (v === 'paid') return 'badge badge-success';
        if (v === 'partial') return 'badge badge-warning';
        return 'badge badge-danger';
      }
      function renderPaymentCell(r) {
        const p = (r.payment_status || 'unpaid').toLowerCase();
        return `<span class="${paymentBadgeClass(p)} payBadge" data-id="${r.id}" title="Edit payment">${p}</span> <button class="btn btn-sm btn-outline-secondary payEdit" data-id="${r.id}" title="Edit"><i class="fas fa-pen"></i></button>`;
      }

      function render(rows) {
        const wrap = document.getElementById('tableWrap');
        if (!wrap) return;
        try { console.log('Render invoked with rows:', Array.isArray(rows) ? rows.length : 0); } catch (e) { console.debug(e); }
        try {
          const count = Array.isArray(rows) ? rows.length : 0;
          if (!count) {
            wrap.innerHTML = '<p class="muted">No appointments found.</p>';
          }
        } catch (e) { console.debug(e); }
        
        const uniqueServices = Array.from(new Set(rows.map((r) => r.service))).filter(Boolean);
        const serviceFilter = document.getElementById('serviceFilter');
        if (serviceFilter && uniqueServices.length > 0) {
           // Only update if we have new services, but maybe better to not overwrite if user selected one?
           // The original code overwrote it. Let's keep original behavior but be careful.
           // Actually original code re-renders options.
           const currentOptions = new Set(Array.from(serviceFilter.options).map(o => o.value));
           uniqueServices.forEach(s => {
             if (!currentOptions.has(s)) {
                const opt = document.createElement('option');
                opt.value = s;
                opt.textContent = s;
                serviceFilter.appendChild(opt);
             }
           });
        }
        
        let tableHtml = '';
        try {
          tableHtml = !rows.length ? '<p class="muted">No appointments found.</p>' : [
          `<table class="table table-striped"><thead><tr>
          <th>Appt ID</th><th>Name</th><th>Contact</th><th>Service</th><th>Date/Time</th><th>Method</th><th>Status</th><th>Payment</th><th>Source</th><th>Created</th><th>Actions</th>
        </tr></thead><tbody>`,
          ...rows.map(
            (r) => {
              const clientLink = r.phone ? `/admin/client360?phone=${encodeURIComponent(r.phone)}` : `/admin/client360?email=${encodeURIComponent(r.email)}`;
              return `<tr>
            <td>${r.customer_appointment_id || ''}</td>
            <td><a href="${clientLink}" class="text-decoration-none">${r.name}</a></td>
            <td>
              <div><a href="${clientLink}" class="text-decoration-none">${r.email}</a></div>
              <div class="muted">${r.phone}</div>
            </td>
            <td><span class="badge text-bg-info">${r.service}</span></td>
            <td>${r.date} ${r.time}</td>
            <td>${r.consultation_method}</td>
            <td>${renderStatusCell(r)}</td>
            <td>${renderPaymentCell(r)}</td>
            <td><span class="source-tag ${(String(r.source||'system').toLowerCase()==='manual')?'manual':'system'}">${r.source || 'system'}</span></td>
            <td class="muted">${new Date(r.created_at).toLocaleString()}</td>
            <td class="actions">
              <a class="btn-sm" href="/admin/whatsapp?id=${encodeURIComponent(r.id)}&name=${encodeURIComponent(r.name)}&phone=${encodeURIComponent(r.phone)}&service=${encodeURIComponent(r.service)}&status=${encodeURIComponent(r.status || 'pending')}&date=${encodeURIComponent(r.date)}&time=${encodeURIComponent(r.time)}&method=${encodeURIComponent(r.consultation_method)}&appointment_id=${encodeURIComponent(r.customer_appointment_id || r.id)}" target="_blank">WhatsApp</a>
              <a class="btn-sm" href="#" data-email-appt-id="${r.id}">Appt Email</a>
              <a class="btn-sm" href="#" data-email-pay-id="${r.id}">Payment Email</a>
              <a class="btn-sm" href="#" data-edit-id="${r.id}" style="background:#3b82f6;color:#fff;border:none">Edit</a>
              <a class="btn-sm" href="#" data-delete-id="${r.id}" style="background:#ef4444;color:#fff;border:none">Delete</a>
              <a class="btn-sm" href="#" data-notes-id="${r.id}" style="color:#f59e0b">📝 Notes</a>
            </td>
          </tr>`
          }),
          '</tbody></table>',
        ].join('');
        } catch (err) {
          console.error('Render error:', err);
          wrap.innerHTML = '<p class="muted">Unable to render rows.</p>';
          return;
        }
        
        if (wrap) {
          wrap.innerHTML = tableHtml;
          try { console.log('Render completed: DOM updated'); } catch (e) { console.debug(e); }
        }
        
        const statsEl = document.getElementById('statsCards');
        if (statsEl) {
          const total = paginationData.total;
          const pending = statusCounts['pending'] || 0;
          const confirmed = statusCounts['confirmed'] || 0;
          const completed = statusCounts['completed'] || 0;
          const cancelled = statusCounts['cancelled'] || 0;
          
          // Payment stats from current page (legacy behavior)
          const paid = rows.filter((r) => String(r.payment_status || '').toLowerCase() === 'paid').length;
          const partial = rows.filter((r) => String(r.payment_status || '').toLowerCase() === 'partial').length;
          const unpaid = rows.filter((r) => String(r.payment_status || '').toLowerCase() === 'unpaid').length;

          statsEl.innerHTML = `
            <div style="display:flex; gap:12px; flex-wrap:nowrap; overflow-x:auto; padding:8px 0">
              <div style="flex:0 0 160px"><div class="small-box bg-info"><div class="inner"><h3>${total}</h3><p>Total</p></div><div class="icon"><i class="fas fa-calendar-check"></i></div></div></div>
              <div style="flex:0 0 160px"><div class="small-box bg-warning"><div class="inner"><h3>${pending}</h3><p>Pending</p></div><div class="icon"><i class="fas fa-hourglass-half"></i></div></div></div>
              <div style="flex:0 0 160px"><div class="small-box bg-primary"><div class="inner"><h3>${confirmed}</h3><p>Confirmed</p></div><div class="icon"><i class="fas fa-check"></i></div></div></div>
              <div style="flex:0 0 160px"><div class="small-box bg-success"><div class="inner"><h3>${completed}</h3><p>Completed</p></div><div class="icon"><i class="fas fa-check-double"></i></div></div></div>
              <div style="flex:0 0 160px"><div class="small-box bg-danger"><div class="inner"><h3>${cancelled}</h3><p>Cancelled</p></div><div class="icon"><i class="fas fa-times"></i></div></div></div>
              <div style="flex:0 0 160px"><div class="small-box bg-primary"><div class="inner"><h3>${paid}</h3><p>Paid</p></div><div class="icon"><i class="fas fa-indian-rupee-sign"></i></div></div></div>
              <div style="flex:0 0 160px"><div class="small-box bg-warning"><div class="inner"><h3>${partial}</h3><p>Partial</p></div><div class="icon"><i class="fas fa-chart-line"></i></div></div></div>
              <div style="flex:0 0 160px"><div class="small-box bg-secondary"><div class="inner"><h3>${unpaid}</h3><p>Unpaid</p></div><div class="icon"><i class="fas fa-wallet"></i></div></div></div>
            </div>`;
        }
      }
      try { window.render = render; window.__realRender = render; } catch { /* ignore */ }

      // Unified Event Delegation for Table Actions
  document.addEventListener('click', async (e) => {
    const target = e.target instanceof Element ? e.target : null;
    if (!target) return;
        
        // --- Status Edit ---
        const statusEditBtn = target.closest('.statusEdit');
        if (statusEditBtn) {
          e.preventDefault();
          const id = statusEditBtn.getAttribute('data-id') || '';
          const cell = statusEditBtn.closest('td');
          if (!cell) return;
          const current = (statusEditBtn.previousElementSibling?.textContent || 'pending').trim();
          cell.innerHTML = `
            <div style="display:flex; gap:6px; align-items:center">
              <select data-id="${id}" class="form-select form-select-sm statusSel">
                ${['pending', 'confirmed', 'rescheduled', 'cancelled', 'scheduled', 'completed'].map((s) => `<option ${current === s ? 'selected' : ''}>${s}</option>`).join('')}
              </select>
              <button class="btn-sm statusSave" data-id="${id}">Save</button>
              <button class="btn-sm statusCancel" data-id="${id}">Cancel</button>
            </div>`;
          return;
        }

        const statusSaveBtn = target.closest('.statusSave');
        if (statusSaveBtn) {
          e.preventDefault();
          const id = statusSaveBtn.getAttribute('data-id');
          const cell = statusSaveBtn.closest('td');
          if (!cell || !id) return;
          const sel = cell.querySelector('.statusSel');
          const status = sel?.value || 'pending';
          try {
            await fetch('/api/admin/appointments', {
              method: 'PUT',
              credentials: 'include',
              headers: { 
                'Content-Type': 'application/json',
                'x-csrf-token': getCsrfToken()
              },
              body: JSON.stringify({ id, status }),
            });
            loadPage(currentPage);
          } catch(err) {
             console.error('Failed to update status', err);
             window.AdminNotify?.error?.('Update failed');
          }
          return;
        }

        const statusCancelBtn = target.closest('.statusCancel');
        if (statusCancelBtn) {
          e.preventDefault();
          const id = statusCancelBtn.getAttribute('data-id');
          const cell = statusCancelBtn.closest('td');
          if (!cell) return;
          const sel = cell.querySelector('.statusSel');
          const originalOption = sel ? Array.from(sel.options).find(o => o.defaultSelected) : null;
          const status = originalOption ? originalOption.value : (sel?.value || 'pending');
          const fakeRow = { id, status };
          cell.innerHTML = renderStatusCell(fakeRow);
          return;
        }

        // --- Notes ---
        const notesBtn = target.closest('[data-notes-id]');
        if (notesBtn) {
          e.preventDefault();
          const id = notesBtn.getAttribute('data-notes-id') || '';
          console.log('Opening notes for ID:', id);
          if (!id) return;
          currentNotesEntityId = id;
          currentNotesEntityType = 'appointment';
          document.getElementById('notesModal')?.classList.add('active');
          loadNotes(id, 'appointment');
          return;
        }

        // --- Payment Edit ---
        const payEditBtn = target.closest('.payEdit') || target.closest('.payBadge');
        if (payEditBtn) {
          e.preventDefault();
          const id = payEditBtn.getAttribute('data-id') || '';
          const row = allData.find(r => r.id === id);
          const current = (payEditBtn.previousElementSibling?.textContent || 'unpaid').trim();
          const apIdEl = document.getElementById('paymentApptId'); if (apIdEl) apIdEl.value = id;
          const amtEl = document.getElementById('paymentAmount'); if (amtEl) amtEl.value = '';
          const modeEl = document.getElementById('paymentMode'); if (modeEl) modeEl.value = 'cash';
          const refEl = document.getElementById('paymentRef'); if (refEl) refEl.value = '';
          const noteEl = document.getElementById('paymentNote'); if (noteEl) noteEl.value = 'Recorded from appointment page';
          const statusEl = document.getElementById('paymentStatusSel'); if (statusEl) statusEl.value = current;
          const errEl = document.getElementById('paymentError'); if (errEl) { errEl.style.display='none'; errEl.textContent=''; }
          const modal = document.getElementById('paymentModal');
          if (modal && row) {
             modal.dataset.email = row.email || '';
             modal.dataset.name = row.name || '';
             modal.dataset.phone = row.phone || '';
          }
          modal?.classList.add('active');
          modal?.setAttribute('style','position:fixed;inset:0;display:block');
          return;
        }

        const paySaveBtn = target.closest('.paySave');
        if (paySaveBtn) {
          e.preventDefault();
          const id = paySaveBtn.getAttribute('data-id');
          const cell = paySaveBtn.closest('td');
          if (!cell || !id) return;
          const sel = cell.querySelector('.paySel');
