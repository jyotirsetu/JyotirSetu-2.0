---
export const prerender = false;
import Favicons from '~/components/Favicons.astro';
import MobilePageSelect from '~/components/MobilePageSelect.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard – JyotirSetu</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6/css/all.min.css" />
    <link rel="stylesheet" href="/admin.css?v=20251129" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <Favicons />
    <style>
      :root { --bg-body:#f8fafc; --bg-body-rgb:248,250,252; --bg-card:#ffffff; --bg-sidebar:#ffffff; --text-main:#0f172a; --text-muted:#64748b; --border-color:#e2e8f0; --primary:#6366f1; --primary-rgb:99,102,241; --primary-glow:rgba(99,102,241,0.15); --accent-1:#8b5cf6; --accent-2:#ec4899; --accent-3:#10b981; --accent-4:#f59e0b; --shadow-sm:0 1px 2px 0 rgb(0 0 0 / 0.05); --shadow-md:0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1); --shadow-lg:0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1); --radius-lg:16px; --radius-md:12px; --sidebar-width:260px; --header-height:70px }
      body.dark-mode { --bg-body:#0f172a; --bg-body-rgb:15,23,42; --bg-card:#1e293b; --bg-sidebar:#1e293b; --text-main:#f1f5f9; --text-muted:#94a3b8; --border-color:#334155; --primary:#818cf8; --primary-rgb:129,140,248; --primary-glow:rgba(129,140,248,0.15) }
      *{box-sizing:border-box} body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;background-color:var(--bg-body);color:var(--text-main);transition:background-color .3s ease,color .3s ease}
      .app-layout{display:grid;grid-template-columns:var(--sidebar-width) 1fr;grid-template-rows:var(--header-height) 1fr;min-height:100vh}
      .sidebar{grid-row:1/-1;background-color:var(--bg-sidebar);border-right:1px solid var(--border-color);padding:20px;display:flex;flex-direction:column;z-index:50;transition:transform .3s ease}
      .brand{display:flex;align-items:center;gap:12px;padding:0 12px 24px;border-bottom:1px solid var(--border-color);margin-bottom:24px;text-decoration:none;color:var(--text-main)} .brand img{width:100%;height:auto;border-radius:8px;object-fit:contain;display:block}
      .nav-group{margin-bottom:24px} .nav-label{font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--text-muted);margin-bottom:12px;padding-left:12px;font-weight:600}
      .nav-item{display:flex;align-items:center;gap:12px;padding:10px 12px;color:var(--text-muted);text-decoration:none;border-radius:var(--radius-md);font-size:14px;font-weight:500;transition:all .2s ease;margin-bottom:4px} .nav-item:hover{background-color:var(--bg-body);color:var(--primary);transform:translateX(4px)} .nav-item.active{background-color:var(--primary-glow);color:var(--primary)} .nav-item i{width:20px;text-align:center}
      .header{grid-column:2;display:flex;align-items:center;justify-content:space-between;padding:0 32px;background:var(--bg-sidebar);border-bottom:1px solid var(--border-color);position:sticky;top:0;z-index:40} .page-title{font-size:20px;font-weight:600;color:var(--text-main)} .header-actions{display:flex;align-items:center;gap:16px}
      .icon-btn{background:none;border:none;color:var(--text-muted);font-size:18px;cursor:pointer;padding:8px;border-radius:50%;transition:all .2s} .icon-btn:hover{background-color:var(--bg-body);color:var(--text-main)}
      .header-search{position:relative;flex:1;max-width:400px;margin:0 24px}
      .header-search input{width:100%;padding:8px 16px 8px 40px;border-radius:999px;border:1px solid var(--border-color);background:var(--bg-body);color:var(--text-main);font-size:14px;transition:all .2s}
      .header-search input:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 2px var(--primary-glow)}
      .header-search i{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--text-muted);font-size:14px}
      .search-results{position:absolute;top:100%;left:0;right:0;margin-top:8px;background:var(--bg-card);border:1px solid var(--border-color);border-radius:12px;box-shadow:var(--shadow-lg);z-index:1001;max-height:400px;overflow-y:auto;display:none}
      .search-results.active{display:block;animation:fadeInUp .2s ease-out}
      @media (max-width:768px){ .search-results{position:absolute;top:100%;left:0;right:0;width:auto;margin-top:4px} }
      .search-item{padding:12px 16px;display:flex;align-items:center;gap:12px;text-decoration:none;color:var(--text-main);border-bottom:1px solid var(--border-color);transition:background .2s}
      .search-item:last-child{border-bottom:none}
      .search-item:hover{background:var(--bg-body)}
      .search-item .icon{width:36px;height:36px;border-radius:50%;background:var(--bg-body);display:flex;align-items:center;justify-content:center;color:var(--text-muted);font-size:14px;flex-shrink:0}
      .search-item.client .icon{background:var(--primary-glow);color:var(--primary);font-weight:600}
      .search-item .info{flex:1;min-width:0}
      .search-item .info div:first-child{font-weight:600;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
      .search-item .info div:last-child{font-size:12px;color:var(--text-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px}
      .search-item .avatar {width:36px;height:36px;border-radius:50%;background:var(--primary-glow);color:var(--primary);display:flex;align-items:center;justify-content:center;font-weight:600;font-size:13px;flex-shrink:0;text-transform:uppercase;border:1px solid rgba(var(--primary-rgb),0.2)}
      .search-item .meta-row {display:flex;align-items:center;gap:6px;margin-top:2px;font-size:11px;color:var(--text-muted)}
      .search-item .status-badge {font-size:10px;padding:1px 6px;border-radius:99px;background:var(--bg-body);border:1px solid var(--border-color);text-transform:uppercase;font-weight:600;letter-spacing:0.02em}
      .search-item.selected, .search-item:focus {background:var(--bg-body);border-left:3px solid var(--primary);padding-left:13px;outline:none}
      .search-empty {padding:32px 16px;text-align:center;color:var(--text-muted)}
      .search-empty i {font-size:24px;margin-bottom:8px;opacity:0.5;display:block}
      .search-cta {display:inline-block;margin-top:12px;padding:6px 12px;background:var(--primary);color:white;border-radius:6px;text-decoration:none;font-size:12px;font-weight:500;transition:opacity .2s} .search-cta:hover{opacity:0.9}
      .search-loader {padding:20px;text-align:center;color:var(--text-muted);font-size:12px;display:flex;align-items:center;justify-content:center;gap:8px}
      .search-section-header{padding:8px 16px;background:var(--bg-body);color:var(--text-muted);font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;border-bottom:1px solid var(--border-color)}
      .notif-bell{position:relative}
      .notif-count{position:absolute;top:0;right:0;transform:translate(40%,-40%);background:#ef4444;color:#fff;border-radius:999px;padding:2px 6px;font-size:10px;font-weight:700;min-width:16px;text-align:center}
      .notif-panel{position:absolute;top:42px;right:0;width:360px;background:rgba(255,255,255,0.85);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid var(--border-color);border-radius:16px;box-shadow:0 20px 25px -5px rgba(0,0,0,0.1),0 10px 10px -5px rgba(0,0,0,0.04);display:none;overflow:hidden;z-index:100}
      body.dark-mode .notif-panel{background:rgba(30,41,59,0.85)}
      .notif-panel.active{display:block;animation:fadeInUp .2s ease-out}
      .notif-toolbar{display:flex;gap:8px;align-items:center;justify-content:space-between;padding:12px 16px;background:rgba(var(--bg-body-rgb),0.5);border-bottom:1px solid var(--border-color)}
      .notif-toolbar .actions{display:flex;gap:8px}
      .notif-toolbar button{background:transparent;border:1px solid var(--border-color);color:var(--text-muted);font-size:11px;padding:4px 8px;border-radius:6px;cursor:pointer;transition:all .2s;font-weight:500}
      .notif-toolbar button:hover{background:var(--primary);color:white;border-color:var(--primary)}
      .notif-list{max-height:360px;overflow-y:auto;overscroll-behavior:contain}
      .notif-date{font-size:11px;font-weight:600;color:var(--text-muted);padding:8px 16px;background:rgba(var(--bg-body-rgb),0.3);text-transform:uppercase;letter-spacing:0.05em}
      .notif-item{display:flex;gap:12px;padding:12px 16px;border-bottom:1px solid var(--border-color);align-items:flex-start;transition:all .2s;cursor:pointer;position:relative}
      .notif-item:hover{background:rgba(var(--primary-rgb),0.05)}
      .notif-item.unread{background:linear-gradient(to right,rgba(99,102,241,0.08),transparent);border-left:3px solid var(--primary)}
      .notif-item:last-child{border-bottom:none}
      .notif-item .icon-box{width:32px;height:32px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0}
      .notif-item.type-appointment .icon-box{background:rgba(16,185,129,0.1);color:#10b981}
      .notif-item.type-quote .icon-box{background:rgba(245,158,11,0.1);color:#f59e0b}
      .notif-item.type-contact .icon-box{background:rgba(236,72,153,0.1);color:#ec4899}
      .notif-item .content{flex:1;min-width:0}
      .notif-item .title{font-weight:600;font-size:13px;color:var(--text-main);margin-bottom:2px}
      .notif-item .meta{font-size:12px;color:var(--text-muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
      .notif-item .time{font-size:11px;color:var(--text-muted);margin-top:4px;display:flex;align-items:center;gap:4px}

      .main-content{grid-column:2;padding:32px;overflow-y:auto;max-width:1320px;margin:0 auto}
      .dashboard-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:24px;margin-bottom:32px}
      .card-modern{background:var(--bg-card);border:1px solid var(--border-color);border-radius:var(--radius-lg);padding:24px;box-shadow:var(--shadow-sm);transition:all .3s cubic-bezier(.4,0,.2,1);position:relative;overflow:hidden;display:flex;flex-direction:column} .card-modern:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg);border-color:var(--primary)}
      .stat-icon-wrapper{width:48px;height:48px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:20px;margin-bottom:16px;background:var(--bg-body)} .stat-value{font-size:32px;font-weight:700;color:var(--text-main);line-height:1.1;margin-bottom:4px;letter-spacing:-1px} .stat-label{font-size:14px;color:var(--text-muted);font-weight:500}
      .stat-trend{display:flex;align-items:center;gap:4px;font-size:12px;font-weight:600;margin-top:12px;padding:4px 8px;border-radius:20px;width:fit-content} .trend-up{background:rgba(16,185,129,.1);color:var(--accent-3)} .trend-down{background:rgba(239,68,68,.1);color:#ef4444} .trend-neutral{background:var(--bg-body);color:var(--text-muted)}
      .chart-section{grid-column:span 3;background:var(--bg-card);border-radius:var(--radius-lg);border:1px solid var(--border-color);padding:24px;box-shadow:var(--shadow-sm);min-height:400px}
      .analytics-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px;margin-top:16px}
      .analytics-card{border:1px solid var(--border-color);border-radius:12px;padding:16px;background:var(--bg-body)}
      .analytics-card h4{margin:0 0 10px;font-size:14px;color:var(--text-main)}
      .progress{height:8px;background:var(--border-color);border-radius:6px;overflow:hidden}
      .progress > div{height:8px;background:var(--primary)}
      .chip{display:inline-block;margin:4px 6px 0 0;padding:6px 10px;border-radius:999px;border:1px solid var(--border-color);background:var(--bg-card);font-size:12px;color:var(--text-main)}
      .activity-section{grid-column:span 1;align-self:stretch;height:100%;background:var(--bg-card);border-radius:var(--radius-lg);border:1px solid var(--border-color);padding:24px;box-shadow:var(--shadow-sm);display:flex;flex-direction:column}
      .section-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px} .section-title{font-size:16px;font-weight:600;color:var(--text-main)}
      .activity-list{display:flex;flex-direction:column;gap:20px;flex:1;overflow-y:auto;min-height:0} .activity-item{display:flex;gap:16px;position:relative} .activity-item:not(:last-child)::before{content:'';position:absolute;left:20px;top:40px;bottom:-20px;width:2px;background:var(--border-color);opacity:.5}
      .activity-icon{width:40px;height:40px;border-radius:50%;background:var(--bg-body);border:1px solid var(--border-color);display:flex;align-items:center;justify-content:center;flex-shrink:0;z-index:1;font-size:16px} .activity-content{flex:1} .activity-text{font-size:14px;color:var(--text-main);font-weight:500;margin-bottom:2px} .activity-meta{font-size:12px;color:var(--text-muted)}
      .quick-actions-grid{grid-column:span 4;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px} .action-card{background:var(--bg-card);border:1px solid var(--border-color);border-radius:var(--radius-md);padding:20px;display:flex;align-items:center;gap:16px;text-decoration:none;color:var(--text-main);transition:all .2s} .action-card:hover{border-color:var(--primary);transform:translateY(-2px);box-shadow:var(--shadow-md)} .action-icon{width:40px;height:40px;border-radius:10px;background:var(--primary-glow);color:var(--primary);display:flex;align-items:center;justify-content:center;font-size:18px} .action-info div:first-child{font-weight:600;font-size:14px;margin-bottom:2px} .action-info div:last-child{font-size:12px;color:var(--text-muted)}
      @keyframes fadeInUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}} .animate-enter{animation:fadeInUp .5s ease-out forwards;opacity:0} .delay-1{animation-delay:.1s} .delay-2{animation-delay:.2s} .delay-3{animation-delay:.3s} .delay-4{animation-delay:.4s}
      @media (min-width:769px){#adminSidebar{position:static;left:auto;top:auto;height:auto}}
      @media (max-width:1024px){.dashboard-grid{grid-template-columns:repeat(2,1fr)} .chart-section{grid-column:span 2} .activity-section{grid-column:span 2}} 
      @media (max-width:768px){
        .app-layout{grid-template-columns:1fr;grid-template-rows:auto 1fr}
        .sidebar{position:fixed;left:-100%;height:100vh;width:280px;box-shadow:20px 0 50px rgba(0,0,0,.2);z-index:9000}
        .sidebar.active{left:0}
        .header{padding:12px 16px;flex-wrap:wrap;height:auto;gap:12px;position:relative;z-index:8000}
        .header > div:first-child{order:1;flex:1;min-width:0;justify-content:flex-start;flex-wrap:wrap} /* Title wrapper */
        .header-actions{width:auto;justify-content:flex-end;order:2;flex-shrink:0}
        .header-search{order:3;width:100%;max-width:none;margin:8px 0 0;z-index:8001;position:relative}
        .search-results{z-index:8002}
        .main-content{padding:16px;overflow-x:hidden}
        .dashboard-grid{display:flex;flex-direction:column;gap:16px}
        .chart-section,.activity-section,.quick-actions-grid{width:100%;grid-column:auto}
        .chart-section canvas{max-width:100%}
        .page-title{font-size:18px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
        #systemStatusCallout{display:none!important}
      }
    </style>
  </head>
  <body>
    <div class="app-layout">
      
      <aside class="sidebar" id="adminSidebar">
        <a href="/admin/dashboard" class="brand">
          <img src="https://images.unsplash.com/vector-1763306579596-25a002c977df?w=260&fit=max&auto=format" alt="Logo" />
        </a>
        <nav style="flex:1;overflow-y:auto">
          <div class="nav-group">
            <div class="nav-label">Overview</div>
            <a href="/admin/dashboard" class="nav-item active"><i class="fas fa-gauge"></i> Dashboard</a>
            <a href="/admin/client360" class="nav-item"><i class="fas fa-user-circle"></i> Client 360°</a>
          </div>
          <div class="nav-group">
            <div class="nav-label">CRM & Sales</div>
            <a href="/admin/leads" class="nav-item"><i class="fas fa-route"></i> Leads</a>
            <a href="/admin/appointments" class="nav-item"><i class="fas fa-calendar-check"></i> Appointments</a>
            <a href="/admin/contacts" class="nav-item"><i class="fas fa-comments"></i> Contacts</a>
            <a href="/admin/quotes" class="nav-item"><i class="fas fa-file-invoice"></i> Quotations</a>
          </div>
          <div class="nav-group">
            <div class="nav-label">Operations</div>
            <a href="/admin/calendar" class="nav-item"><i class="fas fa-calendar"></i> Calendar</a>
            <a href="/admin/after-service" class="nav-item"><i class="fas fa-handshake"></i> After Service</a>
            <a href="/admin/remedies" class="nav-item" data-astro-reload><i class="fas fa-prescription-bottle-alt"></i> Remedies</a>
          </div>
          <div class="nav-group">
            <div class="nav-label">Marketing</div>
            <a href="/admin/newsletter" class="nav-item"><i class="fas fa-envelope-open-text"></i> Newsletter</a>
            <a href="/admin/tools/follow-hub/insights" class="nav-item"><i class="fas fa-toolbox"></i> Follow Hub</a>
          </div>
          <div class="nav-group">
            <div class="nav-label">Templates</div>
            <a href="/admin/templates/email" class="nav-item"><i class="fas fa-envelope"></i> Email Templates</a>
            <a href="/admin/templates/payment" class="nav-item"><i class="fas fa-file-invoice-dollar"></i> Payment Templates</a>
            <a href="/admin/templates/whatsapp" class="nav-item"><i class="fab fa-whatsapp"></i> WhatsApp Templates</a>
          </div>
          <div class="nav-group">
            <div class="nav-label">System</div>
            <a href="/admin/settings" class="nav-item"><i class="fas fa-gear"></i> Settings</a>
            <a href="/api/admin/logout" class="nav-item" style="color:#ef4444"><i class="fas fa-sign-out-alt"></i> Logout</a>
          </div>
        </nav>
      </aside>
      <main>
        <header class="header">
          <div style="display:flex;align-items:center;gap:16px">
            <MobilePageSelect />
            <h1 class="page-title">Dashboard</h1>
          </div>
          <div class="header-search">
            <i class="fas fa-search"></i>
            <input type="text" id="globalSearch" placeholder="Search client profiles..." autocomplete="off" />
            <div id="searchResults" class="search-results"></div>
          </div>
          <div class="header-actions">
            <div id="systemStatusCallout" style="font-size:12px;padding:4px 10px;border-radius:999px;background:var(--primary-glow);display:flex;align-items:center;gap:8px;border:1px solid var(--border-color)">
              <img id="systemStatusIcon" src="" alt="" style="height:18px;width:18px;display:none;object-fit:contain" />
              <span id="systemStatusText" style="opacity:0.8">System Check...</span>
            </div>
            <div class="notif-bell">
              <button class="icon-btn" id="notifBtn" aria-label="Notifications"><i class="fas fa-bell"></i></button>
              <span id="notifCount" class="notif-count" style="display:none">0</span>
              <div id="notifPanel" class="notif-panel"></div>
            </div>
            <button class="icon-btn" id="toggleTheme"><i class="fas fa-moon"></i></button>
            <div style="width:32px;height:32px;background:var(--primary);border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-weight:600;font-size:14px">A</div>
          </div>
        </header>
        <div class="main-content">
          <div style="margin-bottom:32px" class="animate-enter"><h2 style="margin:0;font-size:24px;font-weight:700">Welcome back, Admin 👋</h2><p style="margin:4px 0 0;color:var(--text-muted)">Here's what's happening with your business today.</p></div>
          <div class="dashboard-grid">
            <div class="card-modern animate-enter delay-1"><div class="stat-icon-wrapper" style="color:var(--accent-1);background:rgba(139,92,246,.1)"><i class="fas fa-calendar-check"></i></div><div class="stat-value" id="stat-appointments">—</div><div class="stat-label">Total Appointments</div><div class="stat-trend trend-up"><i class="fas fa-arrow-up"></i><span>View All</span></div></div>
            <div class="card-modern animate-enter delay-1"><div class="stat-icon-wrapper" style="color:var(--accent-2);background:rgba(236,72,153,.1)"><i class="fas fa-comments"></i></div><div class="stat-value" id="stat-contacts">—</div><div class="stat-label">New Contacts</div><div class="stat-trend trend-up"><i class="fas fa-arrow-up"></i><span>Check Inbox</span></div></div>
            <div class="card-modern animate-enter delay-2"><div class="stat-icon-wrapper" style="color:var(--accent-3);background:rgba(16,185,129,.1)"><i class="fas fa-indian-rupee-sign"></i></div><div class="stat-value" id="stat-quotes-amount">—</div><div class="stat-label">Pipeline Value</div><div class="stat-trend trend-neutral"><span id="stat-quotes">— Quotes</span></div></div>
            <div class="card-modern animate-enter delay-2"><div class="stat-icon-wrapper" style="color:var(--accent-4);background:rgba(245,158,11,.1)"><i class="fas fa-hourglass-half"></i></div><div class="stat-value" id="stat-pending">—</div><div class="stat-label">Pending Action</div><div class="stat-trend trend-down"><i class="fas fa-exclamation-circle"></i><span>Requires Attention</span></div></div>
            <div class="quick-actions-grid animate-enter delay-3" style="grid-column:span 4;margin-bottom:8px">
              <a href="/admin/appointments" class="action-card"><div class="action-icon"><i class="fas fa-plus"></i></div><div class="action-info"><div>New Appointment</div><div>Schedule a visit</div></div></a>
              <a href="/admin/quotes" class="action-card"><div class="action-icon" style="background:rgba(16,185,129,.1);color:var(--accent-3)"><i class="fas fa-file-invoice"></i></div><div class="action-info"><div>Create Quote</div><div>Send proposal</div></div></a>
