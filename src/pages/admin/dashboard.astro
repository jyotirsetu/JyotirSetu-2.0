    <script is:inline>
      (function () {
        const controllers = new Set();
        let updatesInterval = null;
        function silentFetchJson(url, opts, fallback) {
          try {
            const c = new AbortController();
            controllers.add(c);
            const options = Object.assign(
              { cache: 'no-store', credentials: 'include', keepalive: true, signal: c.signal },
              opts || {}
            );
            return fetch(url, options)
              .then(function (r) {
                return r.ok ? r.json() : fallback;
              })
              .catch(function () {
                return fallback;
              })
              .finally(function () {
                controllers.delete(c);
              });
          } catch {
            return Promise.resolve(fallback);
          }
        }
        function abortAll() {
          controllers.forEach(function (c) {
            try {
              c.abort();
            } catch (e) {
              void e;
            }
          });
          controllers.clear();
        }
        window.addEventListener('beforeunload', function () {
          if (updatesInterval) clearInterval(updatesInterval);
          abortAll();
        });
        document.addEventListener('visibilitychange', function () {
          if (document.visibilityState === 'hidden') {
            if (updatesInterval) clearInterval(updatesInterval);
            abortAll();
          }
        });

        async function loadStats() {
          try {
            const [a, c, n, q] = await Promise.all([
              silentFetchJson('/api/admin/appointments?page=1&limit=1000', null, { data: [] }),
              silentFetchJson('/api/admin/contacts', null, { data: [] }),
              silentFetchJson('/api/admin/newsletter?page=1&limit=1', null, { pagination: { total: 0 } }),
              silentFetchJson('/api/admin/quotes?stats=1', null, { totals: { count: 0, amount: 0 } }),
            ]);
            const appts = a.data || [];
            const apptEl = document.getElementById('stat-appointments');
            if (apptEl) apptEl.textContent = String(appts.length);
            const contactsEl = document.getElementById('stat-contacts');
            if (contactsEl) contactsEl.textContent = String((c.data || []).length);
            const newsletterEl = document.getElementById('stat-newsletter');
            const totalNewsletter = n?.pagination?.total ?? (n?.data || []).length ?? 0;
            if (newsletterEl) newsletterEl.textContent = String(totalNewsletter);
            const now = Date.now();
            const last24 = appts.filter((x) => {
              const t = new Date(x.created_at).getTime();
              return !isNaN(t) && now - t <= 24 * 60 * 60 * 1000;
            }).length;
            const pending = appts.filter((x) => String(x.status || '').toLowerCase() === 'pending').length;
            const last24El = document.getElementById('stat-24h');
            if (last24El) last24El.textContent = String(last24);
            const pendingEl = document.getElementById('stat-pending');
            if (pendingEl) pendingEl.textContent = String(pending);
            const qTotals = (q && q.totals) || { count: 0, amount: 0 };
            const qEl = document.getElementById('stat-quotes');
            if (qEl) qEl.textContent = String(qTotals.count || 0);
            const qaEl = document.getElementById('stat-quotes-amount');
            function fmtFull(n) { return '₹' + Number(n || 0).toFixed(2); }
            function fmtCompact(n) {
              const num = Number(n || 0);
              const abs = Math.abs(num);
              let value = num;
              let suffix = '';
              if (abs >= 1e7) { value = num / 1e7; suffix = ' Cr'; }
              else if (abs >= 1e5) { value = num / 1e5; suffix = ' L'; }
              else if (abs >= 1e3) { value = num / 1e3; suffix = ' k'; }
              const decimals = Math.abs(value) < 10 ? 1 : 0;
              return '₹' + value.toFixed(decimals) + suffix;
            }
            if (qaEl) {
              const compact = window.innerWidth <= 576;
              const txt = compact ? fmtCompact(qTotals.amount || 0) : fmtFull(qTotals.amount || 0);
              qaEl.textContent = txt;
              qaEl.setAttribute('title', fmtFull(qTotals.amount || 0));
            }
          } catch (e) {
            console.warn('Failed to load stats', e);
          }
        }
        loadStats();
        try {
          window.addEventListener('resize', function () {
            loadStats();
          });
        } catch (err) { void err; }
        try {
          window.addEventListener('storage', function (e) {
            try {
              if (e && e.key === 'quotesStatsUpdated') {
                loadStats();
              }
            } catch (err) {
              void err;
            }
          });
        } catch (e) {
          void e;
        }
        async function loadDbHealth() {
          try {
            const res = await fetch('/api/db-health', { headers: { Accept: 'application/json' }, cache: 'no-store' });
            const j = await res.json();
            const box = document.getElementById('systemStatusCallout');
            const txt = document.getElementById('systemStatusText');
            if (!box || !txt) return;
            if (j && j.ok) {
              box.classList.remove('callout-danger', 'callout-warning');
              box.classList.add('callout-success');
              txt.textContent = 'Database connected (' + (j.urlHostMasked || '') + ')';
            } else {
              box.classList.remove('callout-success');
              box.classList.add('callout-warning');
              const stage = (j && j.stage) || 'unknown';
              const details = [];
              if (j && j.hasUrl === false) details.push('missing TURSO_DATABASE_URL');
              if (j && j.hasToken === false) details.push('missing TURSO_AUTH_TOKEN');
              if (stage === 'query' && j && j.error) {
                details.push(String(j.error));
              }
              txt.textContent = 'Database not connected' + (details.length ? ': ' + details.join(', ') : '');
            }
          } catch {
            const box = document.getElementById('systemStatusCallout');
            const txt = document.getElementById('systemStatusText');
            if (box && txt) {
              box.classList.remove('callout-success');
              box.classList.add('callout-danger');
              txt.textContent = 'Database check failed';
            }
          }
        }
        loadDbHealth();

        function formatIndiaTime(ts) {
          try {
            let d;
            if (typeof ts === 'string') {
              const s = ts.trim();
              // Normalize SQLite UTC string (no timezone) to proper UTC
              if (/^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}(\.\d+)?$/.test(s)) {
                d = new Date(s.replace(' ', 'T') + 'Z');
              } else {
                d = new Date(s);
              }
            } else {
              d = new Date(ts);
            }
            return d.toLocaleString('en-IN', {
              timeZone: 'Asia/Kolkata',
              year: 'numeric',
              month: 'short',
              day: '2-digit',
              hour: '2-digit',
              minute: '2-digit',
              hour12: true,
            });
          } catch {
            return String(ts || '');
          }
        }
        async function loadRecentActivity() {
          try {
            const json = await silentFetchJson('/api/admin/activity-log?limit=10', null, { data: [] });
            const logs = json.data || [];
            const list = document.getElementById('recentActivityList');
            if (!list) return;
            if (!logs.length) {
              list.innerHTML =
                '<div class="activity-item"><div class="activity-left"><div class="activity-title">No recent activity</div></div></div>';
              return;
            }
            const iconForAction = (a) =>
              ({
                appointment_created: '📅',
                status_updated: '🔄',
                email_sent: '📧',
                contact_created: '💬',
                note_created: '📝',
                note_deleted: '🗑️',
                contact_deleted: '🗑️',
              })[String(a || '').toLowerCase()] || '⚡';
            list.innerHTML = logs
              .slice(0, 6)
              .map((l) => {
                const actionText = String(l.action || '')
                  .replace(/_/g, ' ')
                  .replace(/\b\w/g, (c) => c.toUpperCase());
                const when = formatIndiaTime(l.created_at);
                const nameOrEmail =
                  l.appointment_name || l.contact_name || l.appointment_email || l.contact_email || '';
                const subtitle = `${String(l.entity_type || '').toLowerCase()}${nameOrEmail ? ` – ${nameOrEmail}` : ''}`;
                const details = l.details || '';
                const icon = iconForAction(l.action);
                return `<div class="activity-item" style="gap:12px">
              <div style="font-size:18px;line-height:1.2">${icon}</div>
              <div class="activity-left">
                <div class="activity-title">${actionText}</div>
                ${subtitle ? `<div class="activity-details">${subtitle}</div>` : ''}
                ${details ? `<div class="activity-details">${details}</div>` : ''}
              </div>
              <div class="activity-time">${when}</div>
            </div>`;
              })
              .join('');
          } catch {
            const list = document.getElementById('recentActivityList');
            if (list)
              list.innerHTML =
                '<div class="activity-item"><div class="activity-left"><div class="activity-title">Failed to load activity</div></div></div>';
          }
        }
        loadRecentActivity();
        

        // Initialize notifications
        if (typeof window !== 'undefined' && 'Notification' in window) {
          if (Notification.permission === 'default') {
            Notification.requestPermission();
          }

          let lastApptsCount = 0;
          let lastContactsCount = 0;

          async function checkForUpdates() {
            try {
              const settings = JSON.parse(localStorage.getItem('adminSettings') || '{}');
              if (settings.browserNotifications === false) return;
              if (document.visibilityState !== 'visible') return;
              if (Notification.permission !== 'granted') return;

              const [apptsRes, contactsRes] = await Promise.all([
                silentFetchJson('/api/admin/appointments?page=1&limit=1', null, { pagination: { total: 0 } }),
                silentFetchJson('/api/admin/contacts?page=1&limit=1', null, { pagination: { total: 0 } }),
              ]);

              const apptsCount = apptsRes.pagination?.total || 0;
              const contactsCount = contactsRes.pagination?.total || 0;

              if (lastApptsCount > 0 && apptsCount > lastApptsCount && settings.notifyNewAppointment !== false) {
                new Notification('New Appointment!', {
                  body: `You have ${apptsCount - lastApptsCount} new appointment(s)`,
                  icon: '/favicon.ico',
                  tag: 'new-appointment',
                });
              }

              if (lastContactsCount > 0 && contactsCount > lastContactsCount && settings.notifyNewContact !== false) {
                new Notification('New Contact Message!', {
                  body: `You have ${contactsCount - lastContactsCount} new contact message(s)`,
                  icon: '/favicon.ico',
                  tag: 'new-contact',
                });
              }

              lastApptsCount = apptsCount;
              lastContactsCount = contactsCount;
            } catch (e) {
              console.error('Notification check failed:', e);
            }
          }

          // Initial check after 5 seconds
          setTimeout(() => {
            checkForUpdates();
            updatesInterval = setInterval(checkForUpdates, 30000);
          }, 5000);
        }

        // Mobile drawer with animated hamburger
        const sidebar = document.getElementById('adminSidebar');
        const backdrop = document.getElementById('sidebarBackdrop');
        const toggleBtn = document.getElementById('sidebarToggle');
        let isOpen = false;

        function openSidebar() {
          sidebar?.classList.add('active');
          backdrop?.classList.add('active');
          toggleBtn?.classList.add('active');
          if (toggleBtn) toggleBtn.innerHTML = '✕';
          isOpen = true;
        }

        function closeSidebar() {
          sidebar?.classList.remove('active');
          backdrop?.classList.remove('active');
          toggleBtn?.classList.remove('active');
          if (toggleBtn) toggleBtn.innerHTML = '☰';
          isOpen = false;
        }

        toggleBtn?.addEventListener('click', () => {
          if (isOpen) closeSidebar();
          else openSidebar();
        });

        backdrop?.addEventListener('click', closeSidebar);
        sidebar?.querySelectorAll('a').forEach((a) => {
          a.addEventListener('click', () => {
            if (window.innerWidth <= 900) closeSidebar();
          });
        });

        // Close on escape key
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && isOpen) closeSidebar();
        });
        const btn = document.getElementById('toggleSidebarDesktop');
        function sync() {
          if (!btn) return;
          const c = document.body.classList.contains('sidebar-collapse');
          btn.textContent = c ? 'Show sidebar' : 'Hide sidebar';
        }
        async function toggle() {
          const c = document.body.classList.toggle('sidebar-collapse');
          sync();
          try {
            await fetch('/api/admin/preferences', {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ key: 'sidebarCollapsed', value: c ? '1' : '0' }),
            });
          } catch (e) {
            console.error('Error saving sidebarCollapsed:', e);
          }
        }
        btn?.addEventListener('click', toggle);
        sync();
      })();
    </script>
  </body><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/admin-lte@latest/dist/js/adminlte.min.js" defer></script>
  <script is:inline>
    (function(){
          async function loadAnalytics(){
            try {
              const res = await fetch('/api/admin/analytics?days=30', { credentials: 'include' });
              const j = await res.json();
              const el = document.getElementById('analyticsSummary');
              if (!el) return;
              if (!res.ok || !j || j.ok===false) { el.textContent = 'Analytics unavailable'; return; }
              var funnel = Array.isArray(j.funnel) ? j.funnel : [];
              var leads = Array.isArray(j.leads) ? j.leads : [];
              var ltv = j.ltv || {};
              var sla = j.sla || {};
              var staffPerf = Array.isArray(j.staff_performance) ? j.staff_performance : [];
              var docStats = j.document_stats || {};
              var trends = Array.isArray(j.appointment_trends) ? j.appointment_trends : [];
              
              var funnelStr = funnel.map(function(x){ return String(x.status||'')+': '+String(x.count||0); }).join(' • ');
              var leadsStr = leads.map(function(x){ return String(x.stage||'')+': '+String(x.count||0); }).join(' • ');
              var top = Object.entries(ltv).sort(function(a,b){ return Number(b[1])-Number(a[1]); }).slice(0,3);
              var ltvStr = top.map(function(p){ return String(p[0])+': ₹'+Number(p[1]).toFixed(0); }).join(' • ');
              
              // Enhanced analytics display
              var html = '<div class="analytics-grid">';
              html += '<div class="analytics-section"><strong>Funnel</strong>: '+(funnelStr||'—')+'</div>';
              html += '<div class="analytics-section"><strong>Leads</strong>: '+(leadsStr||'—')+'</div>';
              html += '<div class="analytics-section"><strong>Top LTV</strong>: '+(ltvStr||'—')+'</div>';
              html += '<div class="analytics-section"><strong>SLA</strong>: '+String(sla.total_breaches||0)+' breaches, '+String(sla.fulfillment_overdue||0)+' overdue</div>';
              
              if (staffPerf.length > 0) {
                var staffStr = staffPerf.slice(0,3).map(function(s){ return s.staff_name+': '+s.appointment_count+' appts ('+s.completion_rate+'%)'; }).join(' • ');
                html += '<div class="analytics-section"><strong>Staff Performance</strong>: '+(staffStr||'—')+'</div>';
              }
              
              if (docStats.total_documents > 0) {
                html += '<div class="analytics-section"><strong>Documents</strong>: '+String(docStats.total_documents||0)+' total, '+String(docStats.shared_documents||0)+' shared</div>';
              }
              
              if (trends.length > 0) {
                var recentTrends = trends.slice(0,7).reverse();
                var trendStr = recentTrends.map(function(t){ return t.date.split('-').slice(1).join('/')+': '+String(t.total||0); }).join(' • ');
                html += '<div class="analytics-section"><strong>Recent Activity</strong>: '+(trendStr||'—')+'</div>';
              }
              
              html += '</div>';
              el.innerHTML = html;
            } catch { var el = document.getElementById('analyticsSummary'); if (el) el.textContent = 'Analytics unavailable'; }
          }
      try { loadAnalytics(); } catch {}
    })();
  </script>
