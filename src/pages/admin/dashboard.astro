        loadRecentActivity();
        if(typeof window!=='undefined'&&'Notification' in window){ if(Notification.permission==='default'){ Notification.requestPermission(); } let lastApptsCount=0; let lastContactsCount=0; async function checkForUpdates(){ try{ const settings=JSON.parse(localStorage.getItem('adminSettings')||'{}'); if(settings.browserNotifications===false) return; if(document.visibilityState!=='visible') return; if(Notification.permission!=='granted') return; const [apptsRes,contactsRes]=await Promise.all([ silentFetchJson('/api/admin/appointments?page=1&limit=1',null,{pagination:{total:0}}), silentFetchJson('/api/admin/contacts?page=1&limit=1',null,{pagination:{total:0}}) ]); const apptsCount=apptsRes.pagination?.total||0; const contactsCount=contactsRes.pagination?.total||0; if(lastApptsCount>0&&apptsCount>lastApptsCount&&settings.notifyNewAppointment!==false){ new Notification('New Appointment!',{ body:'You have '+(apptsCount-lastApptsCount)+' new appointment(s)', icon:'/favicon.ico', tag:'new-appointment' }); } if(lastContactsCount>0&&contactsCount>lastContactsCount&&settings.notifyNewContact!==false){ new Notification('New Contact Message!',{ body:'You have '+(contactsCount-lastContactsCount)+' new contact message(s)', icon:'/favicon.ico', tag:'new-contact' }); } lastApptsCount=apptsCount; lastContactsCount=contactsCount; }catch{ void 0; } } setTimeout(function(){ checkForUpdates(); updatesInterval=setInterval(checkForUpdates,30000); },5000); }
        async function loadChart(){ try{ const res=await fetch('/api/admin/analytics?days=30'); const data=await res.json(); const trends=(data.appointment_trends||[]).reverse(); const ctx=document.getElementById('appointment-trends-chart'); if(ctx&&trends.length){ const isDark=document.body.classList.contains('dark-mode'); const color=isDark?'#818cf8':'#6366f1'; new Chart(ctx,{ type:'line', data:{ labels:trends.map(t=>new Date(t.date).toLocaleDateString('en-IN',{day:'numeric',month:'short'})), datasets:[{ label:'Appointments', data:trends.map(t=>t.total), borderColor:color, backgroundColor:(context)=>{ const c=context.chart.ctx; const g=c.createLinearGradient(0,0,0,300); g.addColorStop(0, isDark?'rgba(129,140,248,.4)':'rgba(99,102,241,.4)'); g.addColorStop(1,'rgba(0,0,0,0)'); return g; }, fill:true, tension:.4, pointRadius:0, pointHoverRadius:6 }] }, options:{ responsive:true, maintainAspectRatio:false, plugins:{ legend:{display:false} }, scales:{ x:{ grid:{display:false}, ticks:{ color:isDark?'#94a3b8':'#64748b' } }, y:{ grid:{ color:isDark?'#334155':'#e2e8f0', borderDash:[4,4] }, ticks:{ color:isDark?'#94a3b8':'#64748b' } } } } }); }
          const sumEl=document.getElementById('analyticsSummary'); if(sumEl&&data.funnel){ const funnelStr=(data.funnel||[]).map((f)=>`${f.status}: ${f.count}`).join(' • '); sumEl.innerHTML=`<strong>Pipeline:</strong> ${funnelStr}`; }
          const grid=document.getElementById('analyticsGrid');
          if(grid){
            let html='';
            const services=Array.isArray(data.services)?data.services:[];
            if(services.length){
              html+=`<div class="analytics-card"><h4>Service Distribution</h4>${services.map(s=>`<div style="margin-bottom:8px"><div style="display:flex;justify-content:space-between;font-size:12px"><span>${s.name}</span><span>${s.count} (${s.percentage}%)</span></div><div class="progress"><div style="width:${s.percentage}%"></div></div></div>`).join('')}</div>`;
            }
            const funnelArr=Array.isArray(data.funnel)?data.funnel:[];
            if(funnelArr.length){
              html+=`<div class="analytics-card"><h4>Funnel</h4>${funnelArr.map(x=>`<span class="chip">${x.status}: ${x.count}</span>`).join('')}</div>`;
            }
            const leads=Array.isArray(data.leads)?data.leads:[];
            if(leads.length){
              html+=`<div class="analytics-card"><h4>Leads</h4>${leads.map(x=>`<span class="chip">${String(x.stage||'')}: ${String(x.count||0)}</span>`).join('')}</div>`;
            }
            const top=Array.isArray(data.top_ltv)?data.top_ltv:[];
            const ltvList=top.length? top.slice(0,5) : Object.entries(data.ltv||{}).slice(0,5).map(([id,total])=>({id,name:id,total:Number(total)}));
            if(ltvList.length){
              html+=`<div class="analytics-card"><h4>Top LTV</h4><ul style="margin:0;padding:0;list-style:none">${ltvList.map(t=>`<li>${String(t.name|| t.id)}: ₹${Number(t.total||0).toFixed(0)}</li>`).join('')}</ul></div>`;
            }
            const sla=data.sla||{};
            html+=`<div class="analytics-card"><h4>SLA</h4><div class="chip">Breaches: ${String(sla.total_breaches||0)}</div><div class="chip">Overdue: ${String(sla.fulfillment_overdue||0)}</div></div>`;
            const staff=Array.isArray(data.staff_performance)?data.staff_performance:[];
            if(staff.length){
              html+=`<div class="analytics-card"><h4>Staff Performance</h4>${staff.slice(0,3).map(s=>`<div class="chip">${s.staff_name}: ${s.appointment_count} (${s.completion_rate}%)</div>`).join('')}</div>`;
            }
            const docs=data.document_stats||{};
            if(Number(docs.total_documents||0)>0){
              html+=`<div class="analytics-card"><h4>Documents</h4><div class="chip">Total: ${String(docs.total_documents||0)}</div><div class="chip">Shared: ${String(docs.shared_documents||0)}</div></div>`;
            }
            grid.innerHTML=html || `<div class="analytics-card"><h4>Analytics</h4><div class="chip">No data</div></div>`;
          }
        }catch{ void 0; }
        }
        try{ loadChart(); }catch{ void 0; }

        document.getElementById('toggleTheme')?.addEventListener('click', function(){ const isDark=document.body.classList.toggle('dark-mode'); try{ const s=JSON.parse(localStorage.getItem('adminSettings')||'{}'); s.theme=isDark?'dark':'light'; localStorage.setItem('adminSettings', JSON.stringify(s)); }catch{ void 0; } });
      })();
    </script>
  </body>
</html>
