---
import Favicons from '~/components/Favicons.astro';
import MobilePageSelect from '~/components/MobilePageSelect.astro';

interface StaffMember {
  id: string;
  name: string;
  email?: string | null;
  phone?: string | null;
  role: string;
  created_at: string;
  updated_at: string;
}

let staffList: StaffMember[] = [];
let error: string | null = null;

try {
  const response = await fetch(new URL('/api/admin/staff', Astro.url.origin).toString(), {
    headers: { Cookie: Astro.request.headers.get('Cookie') || '' },
  });
  if (response.ok) {
    const result = await response.json();
    if (result.ok && result.data) {
      staffList = result.data;
    }
  }
} catch (e) {
  console.error('Failed to load staff', e);
  error = 'Failed to load staff data';
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Staff – Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@latest/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="/admin.css?v=20251129" />
    <Favicons />
  </head>
  <body class="hold-transition sidebar-mini">
    <script is:inline>
      /* @ts-nocheck */
      (function () {
        function applyTheme(theme) {
          let t = theme;
          if (t === 'auto') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.body.classList.toggle('dark-mode', t === 'dark');
        }
        let theme = 'dark';
        let collapsed = false;
        try {
          const stored = localStorage.getItem('adminSettings');
          if (stored) {
            const s = JSON.parse(stored);
            if (s && typeof s === 'object') {
              if (s.theme) theme = s.theme;
              if (s.sidebarCollapsed != null) collapsed = !!s.sidebarCollapsed;
            }
          }
        } catch (e) {
          console.error('Error loading admin settings:', e);
        }
        applyTheme(theme);
        document.body.classList.toggle('sidebar-collapse', collapsed);
        try {
          Promise.all([
            fetch('/api/admin/preferences?key=theme').then(function (r) {
              return r.json();
            }),
            fetch('/api/admin/preferences?key=sidebarCollapsed').then(function (r) {
              return r.json();
            }),
          ])
            .then(function (rs) {
              const tr = rs[0],
                sr = rs[1];
              if (tr && tr.ok && typeof tr.value === 'string') applyTheme(tr.value);
              if (sr && sr.ok && sr.value != null) document.body.classList.toggle('sidebar-collapse', sr.value === '1');
            })
            .catch(function (err) {
              console.error('Error syncing preferences:', err);
            });
        } catch (e) {
          console.error('Error syncing preferences:', e);
        }
      })();
    </script>
    <div class="wrapper">
      <nav class="main-header navbar navbar-expand navbar-dark">
        <ul class="navbar-nav">
          <li class="nav-item">
            <MobilePageSelect />
          </li>
          <li class="nav-item"><a href="/admin/dashboard" class="nav-link">Dashboard</a></li>
        </ul>
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a href="/api/admin/logout" class="nav-link">Logout</a></li>
        </ul>
      </nav>
      <aside class="main-sidebar sidebar-dark-primary elevation-4" id="adminSidebar">
        <a href="/admin/dashboard" class="brand-link" style="display:flex;align-items:center;gap:8px">
          <img
            src="https://images.unsplash.com/vector-1763306579596-25a002c977df?q=80&w=1979&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
            alt="Brand"
            style="height:40px;width:auto;border-radius:0;box-shadow:0 2px 6px rgba(0,0,0,0.25)"
          />
        </a>
        <div class="sidebar">
          <nav class="mt-2">
            <ul class="nav nav-pills nav-sidebar flex-column" role="menu" data-accordion="false" data-widget="treeview">
              <li class="nav-item">
                <a href="/admin/dashboard" class="nav-link"><i class="nav-icon fas fa-gauge"></i><p>Dashboard</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/leads" class="nav-link"><i class="nav-icon fas fa-route"></i><p>Leads</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/appointments" class="nav-link"><i class="nav-icon fas fa-calendar-check"></i><p>Appointments</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/contacts" class="nav-link"><i class="nav-icon fas fa-comments"></i><p>Contacts</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/newsletter" class="nav-link"><i class="nav-icon fas fa-envelope-open-text"></i><p>Newsletter</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/calendar" class="nav-link"><i class="nav-icon fas fa-calendar"></i><p>Calendar</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/quotes" class="nav-link"><i class="nav-icon fas fa-file-invoice"></i><p>Quotations</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/after-service" class="nav-link"><i class="nav-icon fas fa-handshake"></i><p>After Service</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/remedies" class="nav-link"><i class="nav-icon fas fa-prescription-bottle-alt"></i><p>Remedies</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/activity-log" class="nav-link"><i class="nav-icon fas fa-list"></i><p>Activity Log</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/templates/email" class="nav-link"><i class="nav-icon fas fa-file-alt"></i><p>Email Templates</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/templates/payment" class="nav-link"><i class="nav-icon fas fa-file-invoice-dollar"></i><p>Payment Templates</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/client360" class="nav-link"><i class="nav-icon fas fa-user-circle"></i><p>Client 360°</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/users" class="nav-link"><i class="nav-icon fas fa-users-cog"></i><p>Users</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/tools/follow-hub/insights" class="nav-link"><i class="nav-icon fas fa-toolbox"></i><p>Follow Hub – Insights</p></a>
              </li>
              <li class="nav-item">
                <a href="/admin/settings" class="nav-link"><i class="nav-icon fas fa-gear"></i><p>Settings</p></a>
              </li>
            </ul>
          </nav>
        </div>
      </aside>

      <div class="content-wrapper">
        <section class="content-header">
          <div class="container-fluid">
            <div class="row mb-2">
              <div class="col-sm-6">
                <h1>Staff Management</h1>
              </div>
            </div>
          </div>
        </section>
        <section class="content">
      <div class="container-fluid">
        <div class="row">
          <div class="col-12">
            <div class="card">
              <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title">Staff Members</h3>
                <button class="btn btn-primary btn-sm" id="addStaffBtn">
                  <i class="fas fa-plus"></i> Add Staff
                </button>
              </div>
              <div class="card-body">
                {error && (
                  <div class="alert alert-danger">{error}</div>
                )}
                <div class="table-responsive">
                  <table class="table table-bordered table-striped">
                    <thead>
                      <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Role</th>
                        <th>Created</th>
                        <th>Actions</th>
                      </tr>
                    </thead>
                    <tbody id="staffTableBody">
                      {staffList.map((staff) => (
                        <tr data-staff-id={staff.id}>
                          <td>{staff.name}</td>
                          <td>{staff.email || '-'}</td>
                          <td>{staff.phone || '-'}</td>
                          <td>
                            <span class="badge bg-info">{staff.role}</span>
                          </td>
                          <td>{new Date(staff.created_at).toLocaleDateString()}</td>
                          <td>
                            <button class="btn btn-sm btn-warning edit-staff" data-id={staff.id}>
                              <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-sm btn-danger delete-staff" data-id={staff.id}>
                              <i class="fas fa-trash"></i>
                            </button>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
<!-- Add/Edit Staff Modal -->
  <div class="modal fade" id="staffModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="staffModalTitle">Add Staff Member</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <form id="staffForm">
            <input type="hidden" id="staffId" />
            <div class="mb-3">
              <label for="staffName" class="form-label">Name *</label>
              <input type="text" class="form-control" id="staffName" required />
            </div>
            <div class="mb-3">
              <label for="staffEmail" class="form-label">Email</label>
              <input type="email" class="form-control" id="staffEmail" />
            </div>
            <div class="mb-3">
              <label for="staffPhone" class="form-label">Phone</label>
              <input type="tel" class="form-control" id="staffPhone" />
            </div>
            <div class="mb-3">
              <label for="staffRole" class="form-label">Role *</label>
              <select class="form-select" id="staffRole" required>
                <option value="consultant">Consultant</option>
                <option value="admin">Admin</option>
                <option value="manager">Manager</option>
                <option value="support">Support</option>
              </select>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary" id="saveStaffBtn">Save</button>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    (function() {
      const addStaffBtn = document.getElementById('addStaffBtn');
      const bs = (typeof window !== 'undefined' && window && window['bootstrap']) ? window['bootstrap'] : null;
      const staffModal = bs ? new bs.Modal(document.getElementById('staffModal')) : null;
      const staffForm = document.getElementById('staffForm');
      const staffId = document.getElementById('staffId');
      const staffName = document.getElementById('staffName');
      const staffEmail = document.getElementById('staffEmail');
      const staffPhone = document.getElementById('staffPhone');
      const staffRole = document.getElementById('staffRole');
      const saveStaffBtn = document.getElementById('saveStaffBtn');
      const staffModalTitle = document.getElementById('staffModalTitle');

      let csrfToken = '';
      
      async function fetchCsrfToken() {
        try {
          const res = await fetch('/api/csrf-token', { credentials: 'include' });
          const data = await res.json();
          csrfToken = data.token || '';
        } catch (e) {
          console.error('Failed to fetch CSRF token', e);
        }
      }

      fetchCsrfToken();

      addStaffBtn?.addEventListener('click', () => {
        if (staffForm && staffForm['reset']) { staffForm['reset'](); }
        if (staffId) staffId['value'] = '';
        if (staffModalTitle) staffModalTitle.textContent = 'Add Staff Member';
        if (staffModal) staffModal.show();
      });

      document.addEventListener('click', async (e) => {
        const t = e && e.target ? e.target : null;
        if ((t instanceof Element) && t.closest('.edit-staff')) {
          const el = t.closest('.edit-staff');
          const sid = el && el['dataset'] ? String(el['dataset']['id']||'') : '';
          await editStaff(sid);
        } else if ((t instanceof Element) && t.closest('.delete-staff')) {
          const el = t.closest('.delete-staff');
          const sid = el && el['dataset'] ? String(el['dataset']['id']||'') : '';
          await deleteStaff(sid);
        }
      });

      async function editStaff(id) {
        try {
          const res = await fetch(`/api/admin/staff?id=${id}`, {
            headers: { 'Accept': 'application/json' },
            credentials: 'include'
          });
          const data = await res.json();
          if (data.ok && data.data) {
            const staff = data.data;
            if (staffId) staffId['value'] = staff.id;
            if (staffName) staffName['value'] = staff.name;
            if (staffEmail) staffEmail['value'] = staff.email || '';
            if (staffPhone) staffPhone['value'] = staff.phone || '';
            if (staffRole) staffRole['value'] = staff.role;
            if (staffModalTitle) staffModalTitle.textContent = 'Edit Staff Member';
            if (staffModal) staffModal.show();
          }
        } catch (e) {
          console.error('Failed to load staff', e);
          alert('Failed to load staff data');
        }
      }

      async function deleteStaff(id) {
        if (!confirm('Are you sure you want to delete this staff member?')) return;
        
        try {
          const res = await fetch(`/api/admin/staff?id=${id}`, {
            method: 'DELETE',
            headers: { 
              'Content-Type': 'application/json',
              'X-CSRF-Token': csrfToken
            },
            credentials: 'include'
          });
          const data = await res.json();
          if (data.ok) {
            location.reload();
          } else {
            alert('Failed to delete staff member');
          }
        } catch (e) {
          console.error('Failed to delete staff', e);
          alert('Failed to delete staff member');
        }
      }

      saveStaffBtn?.addEventListener('click', async () => {
        if (staffForm && staffForm['checkValidity']) {
          const ok = staffForm['checkValidity']();
          if (!ok && staffForm['reportValidity']) { staffForm['reportValidity'](); return; }
        }

        const nameVal = (staffName instanceof HTMLInputElement) ? String(staffName.value||'').trim() : '';
        const emailVal = (staffEmail instanceof HTMLInputElement) ? String(staffEmail.value||'').trim() : '';
        const phoneVal = (staffPhone instanceof HTMLInputElement) ? String(staffPhone.value||'').trim() : '';
        const roleVal = (staffRole instanceof HTMLSelectElement) ? String(staffRole.value||'consultant') : 'consultant';
        const staffData = {
          name: nameVal,
          email: emailVal || null,
          phone: phoneVal || null,
          role: roleVal
        };

        if (staffId && staffId['value']) {
          staffData['id'] = String(staffId['value']);
        }

        try {
          const method = (staffId && staffId['value']) ? 'PUT' : 'POST';
          const url = '/api/admin/staff';
          
          const res = await fetch(url, {
            method: method,
            headers: { 
              'Content-Type': 'application/json',
              'X-CSRF-Token': csrfToken
            },
            body: JSON.stringify(staffData),
            credentials: 'include'
          });
          
          const data = await res.json();
          if (data.ok) {
            if (staffModal) staffModal.hide();
            location.reload();
          } else {
            alert('Failed to save staff member: ' + (data.error || 'Unknown error'));
          }
        } catch (e) {
          console.error('Failed to save staff', e);
          alert('Failed to save staff member');
        }
      });

      // Close on escape key
      document.addEventListener('keydown', (_e) => {
        // if (e.key === 'Escape' && isOpen) closeSidebar();
      });
    })();
  </script>
    </div>
  <script is:inline src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" defer></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/admin-lte@latest/dist/js/adminlte.min.js" defer></script>
  </body>
</html>
