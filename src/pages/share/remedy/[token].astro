---
import { getTursoClient } from '../../../lib/turso';

const { token } = Astro.params;

if (!token) {
  return Astro.redirect('/404');
}

// Prevent caching to ensure latest changes are visible
Astro.response.headers.set('Cache-Control', 'no-store, max-age=0');

const client = await getTursoClient();
const { rows } = await client.execute({
  sql: `SELECT * FROM remedies WHERE share_token = ?`,
  args: [token],
});

if (rows.length === 0) {
  return Astro.redirect('/404');
}

// Define interface for Remedy to fix type errors
interface Remedy {
  id: string;
  share_token: string;
  heading: string;
  content: string;
  customer_name: string;
  customer_email?: string;
  customer_phone?: string;
  customer_appointment_id?: string;
  appointment_id?: string;
  astrologer_name?: string;
  dob?: string;
  tob?: string;
  pob?: string;
  rasi?: string;
  nakshatra?: string;
  lagna?: string;
  created_at?: string;
  updated_at?: string;
}

interface MetaData {
  appointment_id?: string;
  customer_phone?: string;
}

const remedy = rows[0] as unknown as Remedy;
let htmlContent = '';
let metaData: MetaData = {};

try {
  const parsed = JSON.parse(remedy.content);
  if (Array.isArray(parsed)) {
    // Legacy array format
    const listItems = parsed.map((item: string) => `<li class="flex gap-3"><span class="text-purple-600 font-bold text-lg">•</span><span>${item}</span></li>`).join('');
    htmlContent = `<ul class="space-y-3">${listItems}</ul>`;
  } else if (typeof parsed === 'object' && parsed.content) {
    // New TinyMCE format
    htmlContent = parsed.content;
    // Extract metadata if available in content json, though we prefer DB columns
    if(parsed.appointment_id) metaData.appointment_id = parsed.appointment_id;
  } else {
    htmlContent = String(parsed);
  }
} catch {
  htmlContent = String(remedy.content);
}

// Fallback for metadata
const customerName = remedy.customer_name;
const customerPhone = remedy.customer_phone || metaData.customer_phone;
const appointmentId = remedy.customer_appointment_id || remedy.appointment_id || metaData.appointment_id; // Prioritize Friendly ID
const astrologerName = remedy.astrologer_name || "Punita Sharma";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{remedy.heading} - {customerName}</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Merriweather:wght@300;400;700&family=Lato:wght@400;700&display=swap');
      
      body {
        font-family: 'Lato', sans-serif;
      }
      h1, h2, h3, h4, h5, h6 {
        font-family: 'Merriweather', serif;
      }
      
      /* Astrology Theme Overrides */
      .astro-theme {
        background: radial-gradient(circle at center, #2e0249 0%, #1a0b2e 100%);
        color: #e2e8f0;
      }
      
      @media print {
        .no-print {
          display: none !important;
        }
        body {
          print-color-adjust: exact;
          -webkit-print-color-adjust: exact;
          background: white !important;
        }
        .shadow-lg {
          box-shadow: none !important;
        }
        #documentCanvas {
          margin: 0;
          box-shadow: none;
        }
      }
    </style>
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
  </head>
  <body class="astro-theme min-h-screen py-8" data-customer-name={customerName}>
    <div id="documentCanvas" class="max-w-4xl mx-auto bg-white shadow-2xl rounded-none overflow-hidden print:shadow-none print:max-w-none relative text-slate-800">
      
      <!-- Watermark -->
      <div class="absolute inset-0 z-0 opacity-[0.03] pointer-events-none flex items-center justify-center">
         <img src="/logo.png" class="w-[500px] h-[500px] object-contain grayscale" />
      </div>

      <!-- Header with Logo -->
      <div class="bg-white border-b-4 border-purple-800 p-8 flex justify-between items-center relative z-10">
        <div class="flex items-center gap-4">
            <img src="/logo.png" alt="JyotirSetu Logo" class="h-20 w-auto" onerror="this.style.display='none'" />
            <div>
                <h1 class="text-3xl font-bold text-purple-900">JyotirSetu Astrology</h1>
                <p class="text-gray-500 tracking-wider text-sm uppercase">Bridge to Cosmic light</p>
            </div>
        </div>
        <div class="text-right hidden sm:block">
            <div class="font-bold text-slate-800 mb-1">JyotirSetu Guidance Sheet</div>
            <p class="text-purple-900 font-bold">{new Date().toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
            <p class="text-xs text-slate-400 mt-1">Ref: {remedy.id ? remedy.id.split('_')[1] : 'GEN'}</p>
        </div>
      </div>

      <div class="p-10 relative z-10 min-h-[800px]">
        
        <!-- Client Info Box (Matches Editor) -->
        {customerName && (
        <div class="mb-8 p-6 bg-slate-50 rounded-lg border-l-4 border-purple-800">
             <div class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Client Details</div>
             <div class="text-2xl font-bold text-slate-900 font-merriweather">{customerName}</div>
             <div class="flex gap-4 mt-3 text-sm text-slate-600">
                {appointmentId && (
                  <div class="flex items-center gap-2">
                    <span class="text-purple-600 font-bold">#</span> <span>{appointmentId}</span>
                  </div>
                )}
                {customerPhone && (
                  <div class="flex items-center gap-2">
                    <span class="text-purple-600 font-bold">📞</span> <span>{customerPhone}</span>
                  </div>
                )}
             </div>

             {/* Horoscope Details */}
             {(remedy.dob || remedy.rasi || remedy.nakshatra || remedy.lagna || remedy.tob || remedy.pob) && (
             <div class="mt-4 pt-4 border-t border-slate-200">
                <div class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Birth Details</div>
                <div class="grid grid-cols-2 md:grid-cols-3 gap-y-2 gap-x-4 text-sm text-slate-700">
                  {remedy.dob && <div><span class="font-bold text-slate-900">DOB:</span> {remedy.dob}</div>}
                  {remedy.tob && <div><span class="font-bold text-slate-900">Time:</span> {remedy.tob}</div>}
                  {remedy.pob && <div><span class="font-bold text-slate-900">Place:</span> {remedy.pob}</div>}
                  {remedy.rasi && <div><span class="font-bold text-slate-900">Rasi:</span> {remedy.rasi}</div>}
                  {remedy.nakshatra && <div><span class="font-bold text-slate-900">Nakshatra:</span> {remedy.nakshatra}</div>}
                  {remedy.lagna && <div><span class="font-bold text-slate-900">Lagna:</span> {remedy.lagna}</div>}
                </div>
             </div>
             )}
        </div>
        )}

        <!-- Main Content -->
        <div class="mb-12 prose prose-purple max-w-none prose-headings:font-merriweather prose-headings:text-purple-900 prose-p:text-slate-700">
          <h1 class="text-2xl font-bold text-center text-purple-900 mb-8 pb-4 border-b border-purple-100">
            {remedy.heading}
          </h1>
          
          <div class="remedy-content">
            <Fragment set:html={htmlContent} />
          </div>
        </div>

        <!-- Footer Note -->
        <div class="mt-auto pt-10 border-t border-slate-100 text-center">
            <p class="text-slate-600 italic mb-4">"May the divine wisdom guide you towards prosperity and peace."</p>
            <div class="inline-block px-6 py-2 border border-purple-200 rounded-full bg-purple-50 text-purple-800 text-sm font-semibold">
                Prepared by Astrologer {astrologerName}
            </div>
        </div>
      </div>
      
      <!-- Page Footer -->
      <div class="bg-purple-900 text-white p-4 text-center text-xs relative z-10">
        <p>&copy; {new Date().getFullYear()} JyotirSetu. All Rights Reserved. | www.jyotirsetu.com</p>
      </div>

    </div>

    <!-- Action Bar (Floating) -->
    <div class="fixed bottom-0 left-0 w-full bg-white border-t shadow-[0_-5px_20px_rgba(0,0,0,0.1)] p-4 no-print z-50">
        <div class="max-w-4xl mx-auto flex justify-between items-center">
            <div class="hidden sm:block">
                <p class="text-sm font-bold text-gray-800">{remedy.heading}</p>
                <p class="text-xs text-gray-500">for {customerName}</p>
            </div>
            <div class="flex gap-3 ml-auto">
                 <button onclick="window.print()" class="px-5 py-2.5 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-50 font-medium transition-colors flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                    </svg>
                    Print
                </button>
                <button onclick="downloadPDF()" class="px-5 py-2.5 rounded-lg bg-purple-600 text-white hover:bg-purple-700 font-medium shadow-lg shadow-purple-200 transition-colors flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                    </svg>
                    Download PDF
                </button>
            </div>
        </div>
    </div>

    <script is:inline>
      /* global html2pdf */
      window.downloadPDF = () => {
         const element = document.getElementById('documentCanvas');
         // Get customer name from data attribute
         const customerName = document.body.dataset.customerName || 'Doc';
         
         if (typeof html2pdf === 'undefined') {
            alert('PDF Generator not loaded yet. Please try again in a moment.');
            return;
         }

         // Use html2pdf
         const opt = {
           margin: 0,
           filename: 'JyotirSetu_Remedy_' + (customerName.replace(/\s+/g, '_')) + '.pdf',
           image: { type: 'jpeg', quality: 0.98 },
           html2canvas: { scale: 2, useCORS: true },
           jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
         };
         
         // Add loading state
         const btn = document.querySelector('button[onclick="downloadPDF()"]');
         const originalText = btn.innerHTML;
         btn.innerHTML = 'Generating...';
         btn.disabled = true;

         html2pdf().set(opt).from(element).save().then(() => {
            btn.innerHTML = originalText;
            btn.disabled = false;
         });
      };
    </script>
  </body>
</html>
