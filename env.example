# JyotirSetu Admin Panel Environment Variables
# Copy this file to .env.local and fill in your values

# Admin Credentials (Change these in production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Supabase Configuration (Optional - for production)
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Session Configuration
SESSION_SECRET=your_random_session_secret_here

# Domain Configuration
SITE_URL=https://www.jyotirsetu.com
ADMIN_URL=https://www.jyotirsetu.com/admin

# Security Settings
ENABLE_2FA=false
SESSION_TIMEOUT=604800

# Email Service Configuration (Resend API)
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL=JyotirSetu <noreply@jyotirsetu.com>

# Turso (libSQL) Configuration
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Follow Hub (landing site) CORS origin
FOLLOW_HUB_ORIGIN=https://follow.jyotirsetu.com
FOLLOW_HUB_EXTRA_ORIGINS=https://www.follow.jyotirsetu.com,http://follow.jyotirsetu.com,http://www.follow.jyotirsetu.com

# Zoho Mail Send API (OAuth)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# com | eu | in (choose region that matches your Zoho account)
ZOHO_REGION=com
ZOHO_FROM_EMAIL=JyotirSetu <noreply@jyotirsetu.com>
ZOHO_TO_ADMIN=guidance@jyotirsetu.com

# Email assets
# If set, emails will load the logo from this absolute URL.
# Otherwise, we fall back to `${SITE_URL}/assets/images/Jyotirsetu-logo.png`.
EMAIL_LOGO_URL=https://www.jyotirsetu.com/assets/images/Jyotirsetu-logo.png

# Anti-spam
TURNSTILE_SECRET_KEY=

# MailChannels (optional fallback)
# Set to true to send emails via MailChannels HTTP API (no API key, requires SPF include)
MAILCHANNELS_ENABLED=false
MAILCHANNELS_WORKER_URL=

# SMTP (Zoho) - preferred on free plan
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@jyotirsetu.com
SMTP_PASS=